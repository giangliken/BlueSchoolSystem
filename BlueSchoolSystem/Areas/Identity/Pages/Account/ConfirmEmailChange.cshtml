@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Xác nhận thay đổi email";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow-lg" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4">
            <h3 class="card-title text-center mb-3">
                <i class="fa-solid fa-envelope-circle-check text-primary me-2"></i>
                @ViewData["Title"]
            </h3>

            <partial name="_StatusMessage" model="Model.StatusMessage" />

            <div class="text-center mt-3">
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-primary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Quay lại hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>
