@model BlueSchoolSystem.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="card-title mb-3">
                <i class="fa-solid fa-user-plus me-2"></i> Thêm sinh viên mới
            </h3>
            <hr />
            <form asp-action="AddStudent" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="MSSV" class="form-label fw-semibold">MSSV(*)</label>
                        <input asp-for="MSSV" class="form-control" />
                        <span asp-validation-for="MSSV" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CCCD" class="form-label fw-semibold">CCCD(*)</label>
                        <input asp-for="CCCD" class="form-control" />
                        <span asp-validation-for="CCCD" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HoVaTenDem" class="form-label fw-semibold">Họ và tên đệm(*)</label>
                        <input asp-for="HoVaTenDem" class="form-control" />
                        <span asp-validation-for="HoVaTenDem" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ten" class="form-label fw-semibold">Tên(*)</label>
                        <input asp-for="Ten" class="form-control" />
                        <span asp-validation-for="Ten" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgaySinh" class="form-label fw-semibold">Ngày sinh(*)</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    </div>
                  
                    <div class="col-md-6">
                        <label class="form-label fw-semibold mb-3">Giới tính(*)</label>
                        <div class="d-flex align-items-center gap-4">
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="Nam" />
                                <label class="form-check-label" for="Nam">Nam</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="Nu" />
                                <label class="form-check-label" for="Nu">Nữ</label>
                            </div>
                        </div>
                        <span asp-validation-for="GioiTinh" class="text-danger"></span>
                    </div>


                    <div class="col-md-6">
                        <label asp-for="User.PhoneNumber" class="form-label fw-semibold">Số điện thoại(*)</label>
                        <input asp-for="User.PhoneNumber" class="form-control" />
                        <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.Email" class="form-label fw-semibold">Email(*)</label>
                        <input asp-for="User.Email" class="form-control" />
                        <span asp-validation-for="User.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label fw-semibold">Địa chỉ(*)</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ngành(*)</label>
                        <select id="NganhSelect" name="NganhHocId" class="form-select" asp-items="ViewBag.NganhList"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LopId" class="form-label fw-semibold">Mã lớp(*)</label>
                        <select asp-for="LopId" id="LopSelect" class="form-select">
                            <option value="">-- Chọn ngành trước --</option>
                        </select>
                        <span asp-validation-for="LopId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TrangThaiId" class="form-label fw-semibold">Trạng thái(*)</label>
                        <select asp-for="TrangThaiId" class="form-select" asp-items="ViewBag.TrangThaiList"></select>
                        <span asp-validation-for="TrangThaiId" class="text-danger"></span>
                    </div>



                    <div class="col-md-6">
                        <label asp-for="NgayNhapHoc" class="form-label fw-semibold">Ngày nhập học(*)</label>
                        <input asp-for="NgayNhapHoc" type="date" class="form-control" />
                        <span asp-validation-for="NgayNhapHoc" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NgayTotNghiep" class="form-label fw-semibold">Ngày tốt nghiệp (dự kiến)(*)</label>
                        <input asp-for="NgayTotNghiep" type="date" class="form-control" />
                        <span asp-validation-for="NgayTotNghiep" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                        <input asp-for="GhiChu" class="form-control" />
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>


                    @* <div class="col-md-6">
                        <label asp-for="UserId" class="form-label fw-semibold"></label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div> *@

                    @* <div class="col-md-6">
                        <label asp-for="CreatedAt" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="CreatedAt" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UpdatedAt" class="form-label fw-semibold"></label>
                        <input asp-for="UpdatedAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="UpdatedAt" class="text-danger"></span>
                    </div> *@

                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="StudentManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-plus"></i> Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
    <p class="mt-3">*Lưu ý: Việc thêm mới sinh viên phải được sự đồng ý của hội đồng trường, trường hợp tự ý thêm sinh viên người thêm sẽ bị truy cứu trách nhiệm sau này!</p>

</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Khi chọn ngành thì load danh sách lớp của ngành đó
            $('#NganhSelect').change(function () {
                var maNganh = $(this).val();
                // Clear dropdown lớp trước khi load mới
                $('#LopSelect').html('<option>Đang tải...</option>');
                $.ajax({
                    url: '/api/lophoc/laydanhsachlophoctheonganh?maNganh=' + maNganh,
                    method: 'GET',
                    success: function (res) {
                        if (res.result && res.data) {
                            // Option tự động xếp lớp (value = 0)
                            var options = '<option value="0">-- Tự động xếp lớp --</option>';
                            res.data.forEach(function (lop) {
                                options += `<option value="${lop.id}">${lop.tenLop} (sĩ số: ${lop.soLuongHienTai}/${lop.siSoToiDa})</option>`;
                            });
                            $('#LopSelect').html(options);
                        } else {
                            $('#LopSelect').html('<option value="">Không có lớp nào</option>');
                        }
                    },
                    error: function () {
                        $('#LopSelect').html('<option value="">Không tìm thấy lớp</option>');
                    }
                });
            });
        });
    </script>
}

