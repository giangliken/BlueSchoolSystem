@model BlueSchoolSystem.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="card-title mb-3">
                <i class="fa-solid fa-user-plus me-2"></i> Thêm sinh viên mới
            </h3>
            <hr />
            <form asp-action="AddStudent" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="MSSV" class="form-label fw-semibold">MSSV(*)</label>
                        <input asp-for="MSSV" class="form-control" />
                        <span asp-validation-for="MSSV" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CCCD" class="form-label fw-semibold">CCCD(*)</label>
                        <input asp-for="CCCD" class="form-control" />
                        <span asp-validation-for="CCCD" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HoVaTenDem" class="form-label fw-semibold">Họ và tên đệm(*)</label>
                        <input asp-for="HoVaTenDem" class="form-control" />
                        <span asp-validation-for="HoVaTenDem" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ten" class="form-label fw-semibold">Tên(*)</label>
                        <input asp-for="Ten" class="form-control" />
                        <span asp-validation-for="Ten" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgaySinh" class="form-label fw-semibold">Ngày sinh(*)</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mt-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="GioiTinh" />
                            <label class="form-check-label" asp-for="GioiTinh">
                                @Html.DisplayNameFor(model => model.GioiTinh)
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label fw-semibold">Địa chỉ(*)</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LopId" class="form-label fw-semibold">Mã lớp(*)</label>
                        <select asp-for="LopId" class="form-select" asp-items="ViewBag.LopId"></select>
                        <span asp-validation-for="LopId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgayNhapHoc" class="form-label fw-semibold">Ngày nhập học(*)</label>
                        <input asp-for="NgayNhapHoc" type="date" class="form-control" />
                        <span asp-validation-for="NgayNhapHoc" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NgayTotNghiep" class="form-label fw-semibold">Ngày tốt nghiệp (dự kiến)(*)</label>
                        <input asp-for="NgayTotNghiep" type="date" class="form-control" />
                        <span asp-validation-for="NgayTotNghiep" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="TrangThai" class="form-label fw-semibold">Trạng thái(*)</label>
                        <input asp-for="TrangThai" class="form-control" />
                        <span asp-validation-for="TrangThai" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                        <input asp-for="GhiChu" class="form-control" />
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>


                    @* <div class="col-md-6">
                        <label asp-for="UserId" class="form-label fw-semibold"></label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId"></select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div> *@

                    @* <div class="col-md-6">
                        <label asp-for="CreatedAt" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="CreatedAt" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="UpdatedAt" class="form-label fw-semibold"></label>
                        <input asp-for="UpdatedAt" type="datetime-local" class="form-control" />
                        <span asp-validation-for="UpdatedAt" class="text-danger"></span>
                    </div> *@

                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="StudentManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-plus"></i> Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
