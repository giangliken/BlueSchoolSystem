@model BlueSchoolSystem.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
    var token = Context.Session.GetString("access_token");
    var trangThaiList = ViewBag.TrangThaiList as IEnumerable<SelectListItem>;
    var dangHocId = trangThaiList?.FirstOrDefault(tt => tt.Text.Trim().ToLower() == "đang học")?.Value;
}


<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="card-title mb-3">
                <i class="fa-solid fa-user-plus me-2"></i> Thêm sinh viên mới
            </h3>
            <hr />
            <form asp-action="AddStudent" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="MSSV" class="form-label fw-semibold">MSSV(*)</label>
                        <input asp-for="MSSV"
                               class="form-control"
                               type="text"
                               minlength="10"
                               maxlength="15"
                               pattern="[0-9]*"
                               inputmode="numeric"
                               autocomplete="off" />
                        <span asp-validation-for="MSSV" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CCCD" class="form-label fw-semibold">CCCD(*)</label>
                        <input asp-for="CCCD" class="form-control" />
                        <span asp-validation-for="CCCD" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HoVaTenDem" class="form-label fw-semibold">Họ và tên đệm(*)</label>
                        <input asp-for="HoVaTenDem" class="form-control" />
                        <span asp-validation-for="HoVaTenDem" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Ten" class="form-label fw-semibold">Tên(*)</label>
                        <input asp-for="Ten" class="form-control" />
                        <span asp-validation-for="Ten" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NgaySinh" class="form-label fw-semibold">Ngày sinh(*)</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    </div>
                  
                    <div class="col-md-6">
                        <label class="form-label fw-semibold mb-3">Giới tính(*)</label>
                        <div class="d-flex align-items-center gap-4">
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" id="Nam" />
                                <label class="form-check-label" for="Nam">Nam</label>
                            </div>
                            <div class="form-check form-check-inline mb-0">
                                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" id="Nu" />
                                <label class="form-check-label" for="Nu">Nữ</label>
                            </div>
                        </div>
                        <span asp-validation-for="GioiTinh" class="text-danger"></span>
                    </div>


                    <div class="col-md-6">
                        <label asp-for="User.PhoneNumber" class="form-label fw-semibold">Số điện thoại(*)</label>
                        <input asp-for="User.PhoneNumber" class="form-control" />
                        <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="User.Email" class="form-label fw-semibold">Email(*)</label>
                        <input asp-for="User.Email" class="form-control" />
                        <span asp-validation-for="User.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiaChi" class="form-label fw-semibold">Địa chỉ(*)</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>


                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ngành(*)</label>
                        <select id="NganhSelect" name="NganhHocId" class="form-select">
                            <option value="">-- Chọn ngành --</option>
                            @foreach (var nganh in ViewBag.NganhList)
                            {
                                var isSelected = Context.Request.Query["NganhHocId"] == nganh.MaNganh;
                                if (isSelected)
                                {
                                    <option value="@nganh.MaNganh" selected>@nganh.TenNganh</option>
                                }
                                else
                                {
                                    <option value="@nganh.MaNganh">@nganh.TenNganh</option>
                                }
                            }
                        </select>

                    </div>


                    <div class="col-md-6">
                        <label asp-for="LopId" class="form-label fw-semibold">Mã lớp(*)</label>
                        <select asp-for="LopId" id="LopSelect" class="form-select">
                            <option value="">-- Chọn ngành trước --</option>
                        </select>
                        <span asp-validation-for="LopId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Trạng thái(*)</label>
                        <input type="text" class="form-control bg-light text-secondary" value="Đang học" readonly tabindex="-1" style="opacity:0.7;pointer-events:none;">
                        <input type="hidden" name="TrangThaiId" value="@dangHocId" />
                    </div>


                    <div class="col-md-6">
                        <label asp-for="NgayNhapHoc" class="form-label fw-semibold">Ngày nhập học(*)</label>
                        <input asp-for="NgayNhapHoc" type="date" class="form-control" />
                        <span asp-validation-for="NgayNhapHoc" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NgayTotNghiep" class="form-label fw-semibold">Ngày tốt nghiệp (dự kiến)(*)</label>
                        <input asp-for="NgayTotNghiep" type="date" class="form-control bg-light text-secondary" readonly style="opacity:0.7;pointer-events:none;" />
                        <span asp-validation-for="NgayTotNghiep" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                        <input asp-for="GhiChu" class="form-control" />
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>

                </div>
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="StudentManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-plus"></i> Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
    <p class="mt-3">*Lưu ý: Việc thêm mới sinh viên phải được sự đồng ý của hội đồng trường, trường hợp tự ý thêm sinh viên người thêm sẽ bị truy cứu trách nhiệm sau này!</p>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/localization/messages_vi.min.js"></script>

    }

    <script>
        window.__accessToken = '@token';
    </script>

    <script>
        // Helper: Tính ngày tốt nghiệp (4.5 năm sau)
        function tinhNgayTotNghiep(ngayNhapHocStr) {
            if (!ngayNhapHocStr) return "";

            var parts = ngayNhapHocStr.split("-");
            if (parts.length !== 3) return "";

            var year = parseInt(parts[0]);
            var month = parseInt(parts[1]) - 1; // JS month 0-11
            var day = parseInt(parts[2]);

            var ngayNhapHoc = new Date(year, month, day);

            // +4.5 năm: 4 năm 6 tháng
            ngayNhapHoc.setFullYear(ngayNhapHoc.getFullYear() + 4);
            ngayNhapHoc.setMonth(ngayNhapHoc.getMonth() + 6);

            // Format lại yyyy-MM-dd
            var yyyy = ngayNhapHoc.getFullYear();
            var mm = String(ngayNhapHoc.getMonth() + 1).padStart(2, '0');
            var dd = String(ngayNhapHoc.getDate()).padStart(2, '0');
            return yyyy + '-' + mm + '-' + dd;
        }

        $(document).ready(function () {
            // ID field
            var $nhapHoc = $('[name="NgayNhapHoc"]');
            var $totNghiep = $('[name="NgayTotNghiep"]');

            function updateNgayTotNghiep() {
                var val = $nhapHoc.val();
                var totNghiepVal = tinhNgayTotNghiep(val);
                $totNghiep.val(totNghiepVal);
            }

            // Khi load form: nếu có value thì tự fill
            if ($nhapHoc.val()) {
                updateNgayTotNghiep();
            }

            // Khi thay đổi ngày nhập học
            $nhapHoc.on('change', function () {
                updateNgayTotNghiep();
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#NganhSelect').change(function () {
                var maNganh = $(this).val();
                console.log("Ngành chọn:", maNganh);

                if (!maNganh) {
                    $('#LopSelect').html('<option value="">-- Chọn ngành trước --</option>');
                    return;
                }

                $('#LopSelect').html('<option>Đang tải...</option>');

                // Lấy token
                var token = window.__accessToken;

                $.ajax({
                    url: '/api/laydanhsachlophoctheonganh?maNganh=' + maNganh,
                    method: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    success: function (res) {
                        console.log("API trả về:", res);
                        if (res.result && res.data && res.data.length > 0) {
                            var options = '<option value="0">-- Tự động xếp lớp --</option>';
                            res.data.forEach(function (lop) {
                                options += `<option value="${lop.id}">${lop.tenLop} (sĩ số: ${lop.soLuongHienTai}/${lop.siSoToiDa})</option>`;
                            });
                            $('#LopSelect').html(options);
                        } else {
                            $('#LopSelect').html('<option value="">Không có lớp nào</option>');
                            console.log("Không có lớp nào");
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#LopSelect').html('<option value="">Không tìm thấy lớp</option>');
                        console.log("Lỗi gọi API:", error, "Status:", xhr.status, "Response:", xhr.responseText);
                    }
                });
            });

            // Auto-load khi có sẵn ngành được chọn (nếu có)
            if ($('#NganhSelect').val()) {
                $('#NganhSelect').trigger('change');
            }

                    $('#NgayNhapHoc').on('change', function () {
            var nhapHoc = $(this).val();
            if (nhapHoc) {
                // Convert string yyyy-mm-dd thành Date object
                var date = new Date(nhapHoc);
                // +4 năm
                date.setFullYear(date.getFullYear() + 4);
                // +6 tháng
                date.setMonth(date.getMonth() + 6);

                // Format lại thành yyyy-MM-dd (để set value cho input type date)
                var yyyy = date.getFullYear();
                var mm = String(date.getMonth() + 1).padStart(2, '0');
                var dd = String(date.getDate()).padStart(2, '0');
                var totNghiep = yyyy + '-' + mm + '-' + dd;

                $('#NgayTotNghiep').val(totNghiep);
            }
        });

        });
    </script>

}


