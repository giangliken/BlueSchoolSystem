@using System.Text.Json
@using BlueSchoolSystem.Models.ViewModel
@{
    ViewData["Title"] = "Dashboard";

    // CẤU HÌNH QUAN TRỌNG: Chuyển đổi tên biến sang camelCase (chữ thường đầu)
    // Ví dụ: TenSuKien (C#) -> tenSuKien (JS)
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales-all.global.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .fc .fc-daygrid-day-number,
        .fc .fc-daygrid-day-number:hover,
        .fc .fc-col-header-cell a,
        .fc .fc-col-header-cell a:hover {
            text-decoration: none !important;
            color: inherit;
        }

        .fc .fc-col-header-cell a {
            color: #1976d2;
            font-weight: bold;
        }

        /* Tùy chỉnh thanh cuộn cho danh sách sự kiện nếu dài */
        #eventList {
            max-height: 450px;
            overflow-y: auto;
        }
    </style>
</head>
<body>

    <script>
        // Serialize dữ liệu với option camelCase đã khai báo ở trên
        const suKiens = @Html.Raw(JsonSerializer.Serialize(ViewBag.SuKiens ?? new List<object>(), jsonOptions));

        // Log ra console để kiểm tra (F12)
        console.log("Danh sách sự kiện:", suKiens);
    </script>

    <div class="container-fluid p-0">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mb-4">
                @ViewBag.Error
            </div>
        }

        <div class="row g-4">

            <div class="col-lg-5">
                <div class="row g-3">

                    <div class="col-4">
                        <div class="card shadow-sm h-100 border-0">
                            <div class="card-body d-flex align-items-center p-3">
                                <i class="fa-solid fa-user fa-2x text-info me-3"></i>
                                <div>
                                    <div class="fw-bold text-secondary" style="font-size: 0.8rem;">GIẢNG VIÊN</div>
                                    <div class="fw-bold fs-4">@ViewBag.giangVienCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="card shadow-sm h-100 border-0">
                            <div class="card-body d-flex align-items-center p-3">
                                <i class="fa-solid fa-users fa-2x text-success me-3"></i>
                                <div>
                                    <div class="fw-bold text-secondary" style="font-size: 0.8rem;">SINH VIÊN</div>
                                    <div class="fw-bold fs-4">@ViewBag.sinhVienCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="card shadow-sm h-100 border-0">
                            <div class="card-body d-flex align-items-center p-3">
                                <i class="fa-solid fa-building-columns fa-2x text-warning me-3"></i>
                                <div>
                                    <div class="fw-bold text-secondary" style="font-size: 0.8rem;">KHOA VIỆN</div>
                                    <div class="fw-bold fs-4">@ViewBag.khoaVienCount</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card shadow-sm h-100 mt-2 border-0">
                            <div class="card-header bg-white border-bottom-0 pt-3">
                                <div class="fw-bold fs-5">
                                    <i class="fa-solid fa-bolt text-warning me-2"></i>
                                    Sự kiện sắp tới
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <ul class="list-group list-group-flush" id="eventList">
                                </ul>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ===== 1. FULLCALENDAR =====
            const calendarEl = document.getElementById('calendar');

            // Map dữ liệu: Chú ý tên biến khớp với JSON (camelCase)
            const events = (suKiens || []).map(e => ({
                title: e.tenSuKien,
                start: e.ngayBatDau,
                end: e.ngayKetThuc,
                // Có thể thêm màu sắc hoặc url nếu cần
                // color: '#3788d8'
            }));

                    const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            locale: 'vi',
            height: 600,

            // THÊM DÒNG NÀY ĐỂ TẮT GIỜ
            displayEventTime: false,

            headerToolbar: {
                left: 'title',
                right: 'today prev,next'
            },
            buttonText: { today: 'Hôm nay' },
            events: events,
            eventClick: function(info) {
                alert('Sự kiện: ' + info.event.title);
            }
        });

            calendar.render();

            // ===== 2. LIST SỰ KIỆN BÊN TRÁI =====
            const ul = document.getElementById('eventList');
            const now = new Date();
            // Reset giờ về 0 để so sánh chính xác ngày
            now.setHours(0,0,0,0);

            // Lọc sự kiện chưa kết thúc hoặc sắp diễn ra
            const upcoming = (suKiens || [])
                .filter(e => {
                    const eventDate = new Date(e.ngayBatDau);
                    return eventDate >= now;
                })
                .sort((a, b) => new Date(a.ngayBatDau) - new Date(b.ngayBatDau)) // Sắp xếp ngày gần nhất lên đầu
                .slice(0, 5); // Lấy 5 sự kiện

            if (upcoming.length === 0) {
                ul.innerHTML = `
                    <li class="list-group-item text-center text-muted py-4">
                        Không có sự kiện sắp tới
                    </li>`;
            } else {
                upcoming.forEach(e => {
                    const dateObj = new Date(e.ngayBatDau);
                    const dateStr = dateObj.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });

                    ul.innerHTML += `
                        <li class="list-group-item d-flex align-items-start py-3">
                            <div class="me-3 text-center bg-light rounded p-2" style="min-width: 60px;">
                                <div class="fw-bold text-primary" style="font-size: 1.2rem;">${dateObj.getDate()}</div>
                                <div class="small text-muted">Thg ${dateObj.getMonth() + 1}</div>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">${e.tenSuKien}</div>
                                <div class="text-muted small mt-1">
                                    ${e.moTa ? e.moTa : 'Không có mô tả'}
                                    ${e.diaDiem ? ' - <i class="fa-solid fa-location-dot"></i> ' + e.diaDiem : ''}
                                </div>
                            </div>
                        </li>
                    `;
                });
            }
        });
    </script>

</body>
</html>