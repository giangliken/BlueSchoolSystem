@model BlueSchoolSystem.Models.LopHoc

@{
    ViewData["Title"] = "Class Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Thông tin lớp học</h4>
                </div>

                <div class="card-body">

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span><strong>Mã lớp:</strong> @Model.MaLop</span>
                            <span><strong>Ngành:</strong> @Model.Nganh?.TenNganh</span>
                            <span><strong>Khoa/Viện:</strong> @Model.Nganh?.Khoa?.TenKhoa</span>
                        </li>
                        <hr />
                      <table class="table table-bordered table-striped">
                        <thead class="table-primary">
                            <tr>
                                <th class="text-center">Chức vụ</th>
                                <th class="text-center">Mã số</th>
                                <th class="text-center">Họ tên</th>
                                <th class="text-center">Số điện thoại</th>
                                <th class="text-center">Email liên hệ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Trợ lý học tập -->
                            @{
                                    var troLi = Model.ChiTietLopHocs?.FirstOrDefault(ct => ct.GiangVien != null);
                            }
                            <tr>
                                <td><strong>Trợ lý học tập</strong></td>
                                <td>@troLi?.GiangVien?.MaGiangVien</td>
                                <td>@(troLi?.GiangVien?.HoVaTenDem + " " + troLi?.GiangVien?.Ten)</td>
                                <td>@troLi?.GiangVien?.User?.PhoneNumber</td>
                                <td>@troLi?.GiangVien?.User?.Email</td>
                            </tr>

                            <!-- Lớp trưởng -->
                            @{
                                    var lopTruong = Model.ChiTietLopHocs?.FirstOrDefault(ct => ct.LopTruong != null);
                            }
                            <tr>
                                <td><strong>Lớp trưởng</strong></td>
                                <td>@lopTruong?.LopTruong?.MSSV</td>
                                <td>@(lopTruong?.LopTruong?.HoVaTenDem + " " + lopTruong?.LopTruong?.Ten)</td>
                                <td>@(lopTruong?.LopTruong?.User?.PhoneNumber)</td>
                                <td>@(lopTruong?.LopTruong?.User?.Email)</td>
                            </tr>

                            <!-- Lớp phó -->
                            @{
                                    var lopPho = Model.ChiTietLopHocs?.FirstOrDefault(ct => ct.LopPho != null);
                            }
                            <tr>
                                <td><strong>Lớp phó</strong></td>
                                <td>@(lopPho?.LopPho?.MSSV)</td>
                                <td>@((lopPho?.LopPho?.HoVaTenDem + " " + lopPho?.LopPho?.Ten))</td>
                                <td>@(lopPho?.LopPho?.User?.PhoneNumber)</td>
                                <td>@(lopPho?.LopPho?.User?.Email)</td>
                            </tr>

                            <!-- Bí thư -->
                            @{
                                    var biThu = Model.ChiTietLopHocs?.FirstOrDefault(ct => ct.BiThu != null);
                            }
                            <tr>
                                <td><strong>Bí thư</strong></td>
                                <td>@(biThu?.BiThu?.MSSV)</td>
                                <td>@((biThu?.BiThu?.HoVaTenDem + " " + biThu?.BiThu?.Ten))</td>
                                <td>@(biThu?.BiThu?.User?.PhoneNumber)</td>
                                <td>@(biThu?.BiThu?.User?.Email)</td>
                            </tr>
                        </tbody>
                    </table>    
                    </ul>
                </div>

                <div class="card-footer bg-light text-center">
                    <a asp-action="EditClass" asp-route-maLop="@Model.MaLop" class="btn btn-warning me-2">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Thêm / cập nhật ban cán sự
                    </a>
                    <a asp-action="ClassManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
