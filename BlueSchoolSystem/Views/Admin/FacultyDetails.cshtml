@model BlueSchoolSystem.Models.Khoa

@{
    ViewData["Title"] = "Faculty Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-building me-2"></i>Thông tin Khoa / Viện
                    </h4>
                </div>

                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span><strong>Mã khoa:</strong> @Model.MaKhoa</span>
                            <span><strong>Tên khoa:</strong> @Model.TenKhoa</span>
                          
                        </li>

                        <hr />
                        @{
                            var detail = Model.ChiTietKhoaViens?.FirstOrDefault();
                        }

                        <table class="table table-bordered table-striped">
                            <thead class="table-primary">
                                <tr>
                                    <th class="text-center">Chức vụ</th>
                                    <th class="text-center">Mã số</th>
                                    <th class="text-center">Họ tên</th>
                                    <th class="text-center">Số điện thoại</th>
                                    <th class="text-center">Email liên hệ</th>
                                </tr>
                            </thead>

                            <tbody>

                                <!-- Trưởng khoa -->
                                <tr>
                                    <td><strong>Trưởng khoa</strong></td>
                                    <td class="text-center">@detail?.TruongKhoa?.MaGiangVien</td>
                                    <td>
                                        @(detail?.TruongKhoa != null
                                            ? detail.TruongKhoa.HoVaTenDem + " " + detail.TruongKhoa.Ten
                                            : "")
                                    </td>
                                    <td>@detail?.TruongKhoa?.User?.PhoneNumber</td>
                                    <td>@detail?.TruongKhoa?.User?.Email</td>
                                </tr>

                                <!-- Phó khoa -->
                                <tr>
                                    <td><strong>Phó khoa</strong></td>
                                    <td class="text-center">@detail?.PhoKhoa?.MaGiangVien</td>
                                    <td>
                                        @(detail?.PhoKhoa != null
                                            ? detail.PhoKhoa.HoVaTenDem + " " + detail.PhoKhoa.Ten
                                            : "")
                                    </td>
                                    <td>@detail?.PhoKhoa?.User?.PhoneNumber</td>
                                    <td>@detail?.PhoKhoa?.User?.Email</td>
                                </tr>

                                <!-- Trợ lý khoa -->
                                <tr>
                                    <td><strong>Trợ lý khoa</strong></td>
                                    <td class="text-center">@detail?.TroLiKhoa?.MaGiangVien</td>
                                    <td>
                                        @(detail?.TroLiKhoa != null
                                            ? detail.TroLiKhoa.HoVaTenDem + " " + detail.TroLiKhoa.Ten
                                            : "")
                                    </td>
                                    <td>@detail?.TroLiKhoa?.User?.PhoneNumber</td>
                                    <td>@detail?.TroLiKhoa?.User?.Email</td>
                                </tr>

                            </tbody>
                        </table>

                    </ul>
                </div>

                <!-- Footer -->
                <div class="card-footer bg-light text-center">
                    <a asp-action="EditFaculty" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Thêm / Cập nhật ban chủ nhiệm
                    </a>
                    <a asp-action="FacultyManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>
