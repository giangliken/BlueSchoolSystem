@model IEnumerable<BlueSchoolSystem.Models.CoSo>

@{
    ViewData["Title"] = "FacilityManager";
    var accessToken = ViewBag.AccessToken as string;
}

<input type="hidden" id="hiddenAccessToken" value="@accessToken" />

<div class="modal fade" id="connectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa-solid fa-circle-exclamation me-2"></i>Lỗi kết nối</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">Không thể kết nối tới máy chủ. Vui lòng kiểm tra mạng.</div>
            <div class="modal-footer"><button type="button" class="btn btn-danger" data-bs-dismiss="modal">Đã hiểu</button></div>
        </div>
    </div>
</div>

<div class="modal fade" id="notificationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Thông báo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body fs-6" id="notificationMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="coSoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Thêm Cơ sở Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hiddenId" value="0" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Mã cơ sở <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtMaCoSo" placeholder="VD: A, B, U">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên cơ sở <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtTenCoSo" placeholder="VD: Sai Gon Campus">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Địa chỉ</label>
                    <input type="text" class="form-control" id="txtDiaChi" placeholder="VD: 475A Điện Biên Phủ...">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Vĩ độ</label>
                        <input type="number" step="any" class="form-control" id="txtLatitude" placeholder="VD: 10.801582">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Kinh độ</label>
                        <input type="number" step="any" class="form-control" id="txtLongitude" placeholder="VD: 106.71446">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<div class="mt-4"></div>

<div class="d-flex justify-content-end mb-3">
    <div class="d-flex gap-2 align-items-center">
        <input type="text" id="txtKeyword" class="form-control form-control-sm" placeholder="Tìm kiếm theo mã/tên..." style="width: 250px;" value="@ViewBag.Keyword">
        <button type="button" class="btn btn-info btn-sm text-white fw-bold px-3 text-nowrap" onclick="searchData()">
            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
        </button>
        <button type="button" class="btn btn-dark btn-sm fw-bold px-3 text-nowrap" onclick="resetFilter()">
            <i class="fa-solid fa-rotate-right"></i> Reset
        </button>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 bg-light p-2 rounded">
    <div class="text-danger fw-bold fs-6">
        Tổng số: <span id="totalCount">0</span> bản ghi
    </div>

    <button class="btn btn-primary btn-sm shadow-sm fw-bold" onclick="openModal('create')">
        <i class="fa-solid fa-plus-circle me-2"></i> Thêm mới
    </button>
</div>

<div class="table-responsive bg-white shadow-sm rounded">
    <table class="table table-hover table-bordered table-striped align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th class="text-center" style="width: 60px;">STT</th>
                <th class="text-center" style="width: 150px;">Mã cơ sở</th>
                <th class="text-start" style="width: 250px;">Tên cơ sở</th>
                <th class="text-start">Địa chỉ</th>
            </tr>
        </thead>
        <tbody id="tableBody"></tbody>
    </table>
</div>

<div id="loadingText" class="text-center mt-3" style="display:none;">
    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
</div>

<p class="mt-3 small text-muted"><i>*Nhấn vào để xem chi tiết Cơ sở.</i></p>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        const TOKEN = $('#hiddenAccessToken').val();
        const API_URL = "/api";

        $(document).ready(function () {
            let initialKeyword = '@ViewBag.Keyword' || '';
            $('#txtKeyword').val(initialKeyword);
            loadData(initialKeyword);
            $('#txtKeyword').keypress(function (e) { if (e.which == 13) searchData(); });
        });

        function showNotification(msg) {
            $('#notificationMessage').html(msg);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('notificationModal')).show();
        }

        function searchData() {
            var keyword = $('#txtKeyword').val().trim();
            loadData(keyword);
        }

        function resetFilter() {
            $('#txtKeyword').val('');
            loadData('');
        }

        function loadData(keyword) {
            $('#loadingText').show();
            $('#tableBody').empty();

            $.ajax({
                url: `${API_URL}/laydanhsachcoso`,
                type: 'GET',
                data: { keyword: keyword },
                headers: { "Authorization": "Bearer " + TOKEN },
                success: function (res) {
                    $('#loadingText').hide();
                    if (res.result && res.data) {
                        renderTable(res.data);
                    } else if (res.message) {
                        $('#totalCount').text(0);
                        $('#tableBody').html('<tr><td colspan="4" class="text-center text-muted py-4">' + res.message + '</td></tr>');
                    }
                },
                error: function (err) {
                    $('#loadingText').hide();
                    if (err.status === 401) { location.reload(); return; }
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('connectionModal')).show();
                }
            });
        }

        function renderTable(data) {
            $('#totalCount').text(data.length);
            var html = '';
            if (data.length > 0) {
                $.each(data, function (i, item) {
                    html += `
                        <tr style="cursor:pointer;" onclick="window.location.href='/Admin/FacilityDetails/${item.id}'" title="Xem chi tiết cơ sở ${item.tenCoSo}">
                            <td class="text-center fw-bold text-secondary">${i + 1}</td>
                            <td class="text-center fw-bold text-dark">${item.maCoSo}</td>
                            <td class="text-start fw-500 text-dark">${item.tenCoSo}</td>
                            <td class="text-start text-muted">${item.diaChi || 'Chưa cập nhật'}</td>
                        </tr>`;
                });
            } else {
                html = '<tr><td colspan="4" class="text-center text-muted py-4">Không tìm thấy dữ liệu phù hợp</td></tr>';
            }
            $('#tableBody').html(html);
        }

        function saveData() {
            var maCoSo = $('#txtMaCoSo').val().trim();
            var tenCoSo = $('#txtTenCoSo').val().trim();
            var diaChi = $('#txtDiaChi').val().trim();
            var latitude = $('#txtLatitude').val().trim();
            var longitude = $('#txtLongitude').val().trim();
            var id = $('#hiddenId').val();

            if (!maCoSo || !tenCoSo) { showNotification("Vui lòng nhập đầy đủ Mã cơ sở và Tên cơ sở!"); return; }

            var latValue = (latitude === "") ? 0 : parseFloat(latitude);
            var lonValue = (longitude === "") ? 0 : parseFloat(longitude);

            if (isNaN(latValue) || isNaN(lonValue)) { showNotification("Vĩ độ và Kinh độ phải là số!"); return; }


            var obj = {
                maCoSo: maCoSo,
                tenCoSo: tenCoSo,
                diaChi: diaChi,
                latitude: latValue,
                longitude: lonValue
            };

            var url = `${API_URL}/taomoi-coso`;
            var type = "POST";

            $.ajax({
                url: url, type: type,
                headers: { "Authorization": "Bearer " + TOKEN },
                contentType: "application/json",
                data: JSON.stringify(obj),
                success: function (res) {
                    if (res.result) {
                        bootstrap.Modal.getInstance(document.getElementById('coSoModal')).hide();
                        window.location.href = '@Url.Action("FacilityManager", "Admin")' + '?successMessage=Thêm cơ sở thành công!';

                    } else {
                        showNotification(res.message);
                    }
                },
                error: function (err) {
                    var errorMessage = "Lỗi hệ thống hoặc API không phản hồi.";
                    if (err.responseJSON && err.responseJSON.message) {
                        errorMessage = err.responseJSON.message;
                    }
                    showNotification(errorMessage);
                }
            });
        }

        function openModal(type) {
            $('#modalTitle').text("Thêm Cơ sở Mới");
            $('#hiddenId').val('0');
            $('#txtMaCoSo').val('');
            $('#txtTenCoSo').val('');
            $('#txtDiaChi').val('');
            $('#txtLatitude').val('');
            $('#txtLongitude').val('');

            bootstrap.Modal.getOrCreateInstance(document.getElementById('coSoModal')).show();
        }

        // Kiểm tra và hiển thị TempData["Success"]
        $(function () {
            var successMessage = '@Html.Raw(TempData["Success"])';
            var errorMessage = '@Html.Raw(TempData["Error"])';

            if (successMessage) {
                // Sử dụng Modal để hiển thị thông báo thành công
                $('#notificationMessage').html(successMessage);
                var notiModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('notificationModal'));
                $('#notificationModal .modal-header').removeClass('bg-warning').addClass('bg-success text-white');
                $('#notificationModal .modal-title i').attr('class', 'fa-solid fa-circle-check me-2');
                notiModal.show();
            }
            if (errorMessage) {
                // Sử dụng Modal để hiển thị thông báo lỗi
                $('#notificationMessage').html(errorMessage);
                var notiModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('notificationModal'));
                $('#notificationModal .modal-header').removeClass('bg-success').addClass('bg-danger text-white');
                $('#notificationModal .modal-title i').attr('class', 'fa-solid fa-circle-exclamation me-2');
                notiModal.show();
            }
        });
    </script>
}