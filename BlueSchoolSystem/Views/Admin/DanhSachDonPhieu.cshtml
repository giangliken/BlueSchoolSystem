@model List<BlueSchoolSystem.Models.ViewModel.XinVangDayViewModel>

@{
    ViewData["Title"] = "Danh sách đơn phiếu giảng viên (Admin)";
    var maLopChon = Context.Request.Query["maLop"].ToString();
    var trangThaiChon = Context.Request.Query["trangThai"].ToString();
    var ngayGuiChon = Context.Request.Query["ngayGui"].ToString();
    var token = Context.Session.GetString("access_token"); // token từ session
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    <h3 class="mb-4">Danh sách đơn phiếu giảng viên</h3>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <!-- Form lọc -->
    <form method="get" class="row g-3 mb-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label"><i class="fas fa-layer-group me-1"></i>Mã lớp</label>
            <input type="text" name="maLop" class="form-control" placeholder="Mã lớp" value="@maLopChon" />
        </div>
   
        <div class="col-md-3">
            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Ngày gửi</label>
            <input type="date" name="ngayGui" class="form-control" value="@ngayGuiChon" />
        </div>

        <div class="col-md-3">
            <label class="form-label"><i class="fas fa-info-circle me-1"></i>Trạng thái</label>
            <select name="trangThai" class="form-select">
                <option value="">--Trạng thái--</option>
                <option value="Chờ duyệt" selected="@(trangThaiChon == "Chờ duyệt")">Chờ duyệt</option>
                <option value="Đã duyệt" selected="@(trangThaiChon == "Đã duyệt")">Đã duyệt</option>
                <option value="Từ chối" selected="@(trangThaiChon == "Từ chối")">Từ chối</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-50"><i class="fas fa-filter me-1"></i>Lọc</button>
            <a href="/Admin/DanhSachDonPhieu" class="btn btn-secondary w-50"><i class="fas fa-times me-1"></i>Xóa lọc</a>
        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th class="text-center">Mã lớp</th>
                <th class="text-center">Tên lớp</th>
                <th class="text-center">Người gửi đơn</th>
                <th class="text-center">Ngày xin vắng</th>
                <th class="text-center">Ngày dạy bù</th>
                <th class="text-center">Phòng</th>
                <th class="text-center">Lý do</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center">Ngày gửi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int i = 1;
                @foreach (var don in Model)
                {
                    <tr style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#chiTietModal-@don.Id">
                        <td>@i</td>
                        <td>@don.MaLopHocPhan</td>
                        <td>@don.TenLopHocPhan</td>
                        <td>@don.TenGiangVien <br />(@don.MaGiangVien)</td>
                        <td>@don.NgayXinVang <br />(@don.CaXinVang)</td>
                        <td>
                            @don.NgayDayBu?.ToString("dd/MM/yyyy") <br />(@(don.GioBatDauDayBu.HasValue && don.GioKetThucDayBu.HasValue
                                                ? $"{don.GioBatDauDayBu:hh\\:mm} - {don.GioKetThucDayBu:hh\\:mm}"
                                                : "-"))
                        </td>
                        <td>@don.Phong</td>
                        <td>@don.LyDo</td>

                        <td>
                            @if (don.TrangThai == "Từ chối")
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>@don.TrangThai</span>
                                    }
                                    else if (don.TrangThai == "Đã duyệt")
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>@don.TrangThai</span>
                                    }
                                    else if (don.TrangThai == "Chờ duyệt")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-hourglass-half me-1"></i>@don.TrangThai</span>
                                    }
                        </td>
                        <td>@don.CreatedAt.ToString("HH:mm dd/MM/yyyy")</td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal chi tiết cho từng đơn -->
@foreach (var don in Model)
{
    <div class="modal fade" id="chiTietModal-@don.Id" tabindex="-1" aria-labelledby="chiTietLabel-@don.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="chiTietLabel-@don.Id">Chi tiết đơn @don.MaLopHocPhan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <dl class="row">
                        <dt class="col-sm-4">Tên lớp</dt>
                        <dd class="col-sm-8">@don.TenLopHocPhan</dd>

                        <dt class="col-sm-4">Lý do</dt>
                        <dd class="col-sm-8">@don.LyDo</dd>

                        <dt class="col-sm-4">Ngày dạy bù</dt>
                        <dd class="col-sm-8">@don.NgayDayBu?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">Ca dạy bù</dt>
                        <dd class="col-sm-8">
                            @(don.GioBatDauDayBu.HasValue && don.GioKetThucDayBu.HasValue
                                                    ? $"{don.GioBatDauDayBu:hh\\:mm} - {don.GioKetThucDayBu:hh\\:mm}"
                                                    : "-")
                    </dd>

                        <dt class="col-sm-4">Phòng</dt>
                        <dd class="col-sm-8" id="phong-@don.Id">@don.Phong</dd>

                        <dt class="col-sm-4">Trạng thái</dt>
                        <dd class="col-sm-8" id="trangthai-@don.Id">@don.TrangThai</dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="duyetDon(@don.Id)">
                        <i class="fas fa-check me-1"></i>Duyệt
                    </button>
                    <button type="button" class="btn btn-danger" onclick="tuChoiDon(@don.Id)">
                        <i class="fas fa-times me-1"></i>Từ chối
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="checkPhong(@don.Id)">
                        <i class="fas fa-door-closed me-1"></i>Check Phòng
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const token = '@token'; // token từ session

    async function checkPhong(donId) {
        if (!token) { alert("Bạn chưa đăng nhập!"); return; }

        try {
            const res = await fetch(`/api/CheckPhongVaGan/${donId}`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await res.json();
            if (res.ok && data.result) {
                alert(`Gán phòng thành công: ${data.phong}`);
                document.getElementById(`phong-${donId}`).innerText = data.phong;
            } else {
                alert(data.message || "Không còn phòng trống");
            }
        } catch (err) {
            console.error(err);
            alert("Lỗi khi gọi API Check Phòng!");
        }
    }

    async function duyetDon(donId) {
        if (!token) { alert("Bạn chưa đăng nhập!"); return; }

        try {
            const res = await fetch(`/api/DuyetDon/${donId}`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await res.json();
            if (res.ok && data.result) {
                alert("Duyệt đơn thành công!");
                location.reload();
                document.getElementById(`trangthai-${donId}`).innerHTML =
                    `<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã duyệt</span>`;
            } else {
                alert(data.message);
            }
        } catch (err) {
            console.error(err);
            alert("Lỗi khi gọi API Duyệt đơn!");
        }
    }

    async function tuChoiDon(donId) {
        if (!token) { alert("Bạn chưa đăng nhập!"); return; }

        try {
            const res = await fetch(`/api/TuChoiDon/${donId}`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            const data = await res.json();
            if (res.ok && data.result) {
                alert("Từ chối đơn thành công!");
                location.reload();
                document.getElementById(`trangthai-${donId}`).innerHTML =
                    `<span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Từ chối</span>`;
            } else {
                alert(data.message);
            }
        } catch (err) {
            console.error(err);
            alert("Lỗi khi gọi API Từ chối đơn!");
        }
    }
</script>
