@* File: Views/Admin/CourseClassManager.cshtml *@
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản Lý Lớp Học Phần";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 Quản Lý Lớp Học Phần</h2>
        <a asp-action="CreateCourseClass" class="btn btn-primary">
            <i class="fa fa-plus"></i> Tạo Lớp Học Phần Mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Chưa có Lớp Học Phần nào được tạo.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="lhpTable">
                <thead class="thead-dark">
                    <tr>
                        <th>Mã LHP</th>
                        <th>Môn Học</th>
                        <th>Giảng Viên</th>
                        <th>Sĩ Số (Thực tế/Tối đa)</th>
                        <th>Trạng Thái</th>
                        <th>Lịch Học</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            @* Sửa MaLopHocPhan thành maLopHocPhan *@
                            <td><strong>@item.maLopHocPhan</strong></td>

                            @* Sửa MonHoc thành monHoc *@
                            <td>@item.monHoc</td>

                            @* Sửa GiangVien thành giangVien *@
                            <td>@item.giangVien</td>

                            <td>
                                <span class="badge @(item.siSoThucTe >= item.siSoToiDa ? "badge-danger" : "badge-info") text-dark">
                                    @item.siSoThucTe / @item.siSoToiDa
                                </span>
                            </td>

                            <td>
                                <span class="badge @(item.trangThai == "Đang mở" ? "badge-success" : (item.trangThai == "Bị Hủy" ? "badge-danger" : "badge-secondary")) text-dark">
                                    @item.trangThai
                                </span>
                            </td>

                            <td>
                                @* Sửa LichHoc thành lichHoc *@
                                @if (item.lichHoc != null && item.lichHoc.Count > 0)
                                {
                                    @foreach (var lich in item.lichHoc)
                                    {
                                        <div class="small">
                                            @* Các thuộc tính của LichHoc cũng cần được kiểm tra: Ngay, GioBatDau, GioKetThuc, Phong *@
                                            **@Convert.ToDateTime(lich.ngay).ToString("dd/MM")**: @lich.gioBatDau - @lich.gioKetThuc (@lich.phong)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger">Chưa có</span>
                                }
                            </td>
                            <td>
                                <a asp-action="AddSchedule" asp-route-lhpId="@item.id" class="btn btn-sm btn-outline-info mb-1">
                                    <i class="fa fa-calendar-plus"></i> Thêm Lịch
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-warning btn-update-status"
                                        data-lhp-id="@item.id"
                                        data-lhp-ma="@item.maLopHocPhan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statusModal">
                                    <i class="fa fa-edit"></i> Sửa TT
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Modal Cập nhật trạng thái *@
        <div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Cập nhật Trạng thái LHP: <span id="modalLhpMa"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="currentLhpId" />
                        <div class="mb-3">
                            <label for="newStatus" class="form-label">Chọn Trạng thái mới:</label>
                            <select class="form-select" id="newStatus">
                                @foreach (var status in (List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList)
                                {
                                    <option value="@status.Id">@status.TenTrangThai</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3" id="lyDoGroup" style="display:none;">
                            <label for="lyDo" class="form-label">Lý do Hủy (nếu chọn 'Bị Hủy'):</label>
                            <textarea class="form-control" id="lyDo"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="btnSaveStatus">Lưu Thay Đổi</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts {
    <script>
        $(document).ready(function () {

            // Event delegation cho nút Sửa TT
            $(document).on('click', '.btn-update-status', function() {
                var lhpId = $(this).data('lhp-id');
                var lhpMa = $(this).data('lhp-ma');

                $('#currentLhpId').val(lhpId);
                $('#modalLhpMa').text(lhpMa);
                $('#lyDo').val('');
                $('#lyDoGroup').hide();
            });

            // Lấy ID trạng thái "Bị Hủy" từ ViewBag
            var huyStatusId = @(((List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList).FirstOrDefault(t => t.TenTrangThai == "Bị Hủy")?.Id.ToString() ?? "0");

            // Hiển thị ô lý do nếu chọn trạng thái "Bị Hủy"
            $('#newStatus').change(function () {
                var selectedStatusId = $(this).val();
                if (selectedStatusId == huyStatusId) {
                    $('#lyDoGroup').show();
                } else {
                    $('#lyDoGroup').hide();
                }
            });

            // Xử lý nút lưu trạng thái
            $('#btnSaveStatus').click(function () {
                var lhpId = $('#currentLhpId').val();
                var trangThaiId = $('#newStatus').val();
                var lyDo = $('#lyDo').val();
                var selectedText = $('#newStatus').find("option:selected").text().trim();

                if (!trangThaiId) {
                    alert('Vui lòng chọn trạng thái mới.');
                    return;
                }
                if (selectedText === "Bị Hủy" && !lyDo) {
                    alert('Vui lòng nhập lý do hủy lớp.');
                    return;
                }

                if (confirm('Bạn có chắc chắn muốn cập nhật trạng thái này?')) {
                    $.ajax({
                        url: '@Url.Action("UpdateCourseClassStatus", "Admin")',
                        type: 'POST',
                        data: {
                            lopHocPhanId: lhpId,
                            trangThaiId: trangThaiId,
                            lyDo: lyDo
                        },
                        success: function (response) {
                            if (response.success) {
                                var modal = bootstrap.Modal.getInstance(document.getElementById('statusModal'));
                                modal.hide();
                                alert(response.message);
                                window.location.reload();
                            } else {
                                alert('Lỗi: ' + response.message);
                            }
                        },
                        error: function () {
                            alert('Lỗi kết nối server.');
                        }
                    });
                }
            });
        });
    </script>
}
