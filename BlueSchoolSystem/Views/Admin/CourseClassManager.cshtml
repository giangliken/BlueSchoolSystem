@* File: Views/Admin/CourseClassManager.cshtml *@
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản Lý Lớp Học Phần";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📚 @ViewData["Title"]</h2>
        <div>
            <a asp-action="CreateCourseClass" class="btn btn-primary me-2">
                <i class="fa fa-plus"></i> Tạo Lớp Học Phần Mới
            </a>
            <button type="button" class="btn btn-success" id="btnAutoDangKy">
                <i class="fa fa-magic"></i> Auto Đăng ký HP Bắt Buộc
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Chưa có Lớp Học Phần nào được tạo.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered" id="lhpTable">
                <thead class="table-dark">
                    <tr>
                        <th>Mã LHP</th>
                        <th>Môn Học</th>
                        <th>Giảng Viên</th>
                        <th>Sĩ Số (Thực tế/Tối đa)</th>
                        <th>Trạng Thái</th>
                        <th>Lịch Học</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.maLopHocPhan</strong></td>
                            <td>@item.monHoc</td>
                            <td>@item.giangVien</td>
                            <td>
                                <span class="badge @(item.siSoThucTe >= item.siSoToiDa ? "bg-danger" : "bg-info") text-dark">
                                    @item.siSoThucTe / @item.siSoToiDa
                                </span>
                            </td>
                            <td>
                                <span class="badge @(item.trangThai == "Đang mở" ? "bg-success" : (item.trangThai == "Bị Hủy" ? "bg-danger" : "bg-secondary")) text-dark">
                                    @item.trangThai
                                </span>
                            </td>
                            <td>
                                @if (item.lichHoc != null && item.lichHoc.Count > 0)
                                {
                                    @foreach (var lich in item.lichHoc)
                                    {
                                        <div class="small">
                                            @Convert.ToDateTime(lich.ngay).ToString("dd/MM"): @lich.gioBatDau - @lich.gioKetThuc (@lich.phong)
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-danger">Chưa có</span>
                                }
                            </td>
                            <td>
                                <a asp-action="AddSchedule" asp-route-lhpId="@item.id" class="btn btn-sm btn-outline-info mb-1">
                                    <i class="fa fa-calendar-plus"></i> Thêm Lịch
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-warning btn-update-status mb-1"
                                        data-lhp-id="@item.id"
                                        data-lhp-ma="@item.maLopHocPhan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statusModal">
                                    <i class="fa fa-edit"></i> Sửa TT
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-delete-lhp mb-1"
                                        data-lhp-id="@item.id"
                                        data-lhp-ma="@item.maLopHocPhan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal">
                                    <i class="fa fa-trash"></i> Xóa
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* --- Modal Cập nhật trạng thái --- *@
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật Trạng thái LHP: <span id="modalLhpMa"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentLhpId" />
                <div class="mb-3">
                    <label class="form-label">Chọn Trạng thái mới:</label>
                    <select class="form-select" id="newStatus">
                        @foreach (var status in (List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList)
                        {
                            <option value="@status.Id">@status.TenTrangThai</option>
                        }
                    </select>
                </div>
                <div class="mb-3" id="lyDoGroup" style="display:none;">
                    <label class="form-label">Lý do Hủy:</label>
                    <textarea class="form-control" id="lyDo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveStatus">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>
</div>

@* --- Modal Xóa LHP --- *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa Lớp Học Phần: <span id="deleteLhpMa"></span></h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteLhpId" />
                <p>Bạn có chắc chắn muốn xóa lớp học phần này? Hành động không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" id="btnConfirmDelete">Xóa</button>
            </div>
        </div>
    </div>
</div>

@* --- Modal Auto đăng ký HP --- *@
<div class="modal fade" id="autoDangKyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chọn Học Kỳ và Thứ Tự</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Học kỳ:</label>
                    <select id="modalHocKy" class="form-select">
                        <option value="">-- Chọn Học Kỳ --</option>
                        @foreach (var hk in (List<BlueSchoolSystem.Models.HocKy>)ViewBag.HocKyList)
                        {
                            <option value="@hk.Id">@hk.TenHocKy</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Thứ tự học kỳ:</label>
                    <select id="modalThuTuHocKy" class="form-select">
                        @for (int i = 1; i <= 18; i++)
                        {
                            <option value="@i">Thứ tự @i</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-success" id="btnConfirmAutoDangKy">Chạy Auto Đăng Ký</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function() {
            // --- Auto đăng ký modal ---
            $('#btnAutoDangKy').click(function() {
                new bootstrap.Modal(document.getElementById('autoDangKyModal')).show();
            });
            $('#btnConfirmAutoDangKy').click(function() {
                var hocKyId = $('#modalHocKy').val();
                var thuTuHocKy = $('#modalThuTuHocKy').val();
                if(!hocKyId) { alert('Vui lòng chọn học kỳ!'); return; }
                if(!thuTuHocKy) { alert('Vui lòng chọn thứ tự học kỳ!'); return; }
                if(!confirm('Bạn có chắc chắn muốn chạy Auto đăng ký HP?')) return;

                $.post('@Url.Action("RunAutoDangKyBatBuocFromAdmin", "Admin")', { hocKyId, thuTuHocKy }, function(res){
                    alert(res.message || 'Hoàn tất!');
                    location.reload();
                });
            });

            // --- Sửa trạng thái ---
            var huyStatusId = '@(((List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList).FirstOrDefault(t => t.TenTrangThai == "Bị Hủy")?.Id ?? 0)';
            $('.btn-update-status').click(function() {
                var lhpId = $(this).data('lhp-id');
                var lhpMa = $(this).data('lhp-ma');
                $('#currentLhpId').val(lhpId);
                $('#modalLhpMa').text(lhpMa);
                $('#lyDo').val('');
                $('#lyDoGroup').hide();
            });
            $('#newStatus').change(function() {
                if($(this).val() == huyStatusId) $('#lyDoGroup').show(); else $('#lyDoGroup').hide();
            });
            $('#btnSaveStatus').click(function() {
                var lhpId = $('#currentLhpId').val();
                var trangThaiId = $('#newStatus').val();
                var lyDo = $('#lyDo').val();
                var text = $('#newStatus option:selected').text().trim();
                if(!trangThaiId) { alert('Chọn trạng thái mới!'); return; }
                if(text=="Bị Hủy" && !lyDo) { alert('Nhập lý do hủy!'); return; }
                if(confirm('Xác nhận cập nhật trạng thái?')) {
                    $.post('@Url.Action("UpdateCourseClassStatus", "Admin")', { lopHocPhanId: lhpId, trangThaiId, lyDo }, function(res){
                        alert(res.message || 'Hoàn tất');
                        location.reload();
                    });
                }
            });

            // --- Xóa LHP ---
            $('.btn-delete-lhp').click(function() {
                var lhpId = $(this).data('lhp-id');
                var lhpMa = $(this).data('lhp-ma');
                $('#deleteLhpId').val(lhpId);
                $('#deleteLhpMa').text(lhpMa);
            });
            $('#btnConfirmDelete').click(function() {
                var lhpId = $('#deleteLhpId').val();
                if(!lhpId) { alert('Lỗi'); return; }
                if(confirm('Xác nhận xóa lớp học phần?')) {
                    $.post('@Url.Action("DeleteCourseClass", "Admin")', { lopHocPhanId: lhpId }, function(res){
                        alert(res.message || 'Hoàn tất');
                        location.reload();
                    });
                }
            });
        });
    </script>
}
