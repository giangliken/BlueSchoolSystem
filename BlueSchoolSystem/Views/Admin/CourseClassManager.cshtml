@* File: Views/Admin/CourseClassManager.cshtml *@
@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Quản Lý Lớp Học Phần";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <a asp-action="CreateCourseClass" class="btn btn-primary me-2 shadow-sm">
                <i class="fa fa-plus"></i> Mở lớp học phần
            </a>
            <a asp-action="AutoCreateClassAndEnroll" class="btn btn-success shadow-sm" title="Tạo Lớp và Đăng Ký Bắt Buộc theo CTĐT">
                <i class="fa fa-cogs"></i> Mở lớp tự động
            </a>
            <a asp-action="RegistrationPeriods" class="btn btn-warning me-2 shadow-sm" title="Chọn Lớp Học Phần để mở đợt đăng ký">
                <i class="fa fa-calendar-alt"></i> Mở cổng đăng ký
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4 bg-light">
        <div class="card-body py-2">
            <form method="get" asp-action="CourseClassManager" class="row g-2 align-items-center">
                <div class="col-auto">
                    <span class="fw-bold text-secondary"><i class="fa fa-filter me-2"></i>Lọc theo:</span>
                </div>
                <div class="col-md-4">
                    @* Dropdown Học kỳ *@
                    <select name="hocKyId" class="form-select" onchange="this.form.submit()" asp-items="@ViewBag.HocKyList">
                        <option value="">-- Tất cả học kỳ --</option>
                    </select>
                </div>
                <div class="col-auto">
                    @* Nút reset bộ lọc *@
                    <a asp-action="CourseClassManager" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="fa fa-sync-alt"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">@Html.Raw(TempData["Error"])</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm">Chưa có Lớp Học Phần nào được tạo.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle shadow-sm" id="lhpTable">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center" style="width: 60px;">STT</th>
                        <th>Mã LHP</th>
                        <th>Môn Học</th>
                        <th>Giảng Viên</th>
                        <th class="text-center">Sĩ Số</th>
                        <th class="text-center">Trạng Thái</th>
                        <th>Học Kỳ</th>
                        <th class="text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @foreach (var item in Model)
                    {
                        
                        <tr class="clickable-row" data-url="@Url.Action("CourseClassDetail", "Admin", new { id = item.id })">
                            <td class="text-center fw-normal">@stt</td>
                            <td><strong>@item.maLopHocPhan</strong></td>
                            <td>@item.monHoc</td>
                            <td>@item.giangVien</td>

                            @* --- Sĩ số (Chữ đen, kích cỡ bình thường) --- *@
                            <td class="text-center fw-normal">
                                @item.siSoThucTe / @item.siSoToiDa
                            </td>

                            @* --- Trạng thái (Chữ đen, kích cỡ bình thường) --- *@
                            <td class="text-center fw-normal">
                                @item.trangThai
                            </td>

                            @* --- Học kỳ (Chữ đen, kích cỡ bình thường) --- *@
                            <td class="fw-normal">
                                @item.tenHocKy
                            </td>


                            @* --- Hành động (BỎ nút AddSchedule) --- *@
                            <td class="text-center">
                                
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning btn-update-status mb-1 px-3"
                                        data-lhp-id="@item.id"
                                        data-lhp-ma="@item.maLopHocPhan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#statusModal"
                                        title="Cập nhật trạng thái">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-delete-lhp mb-1 px-3"
                                        data-lhp-id="@item.id"
                                        data-lhp-ma="@item.maLopHocPhan"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        title="Xóa Lớp HP">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        {
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>



@* --- Modal Cập nhật trạng thái --- *@
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật Trạng thái LHP: <span id="modalLhpMa"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentLhpId" />
                <div class="mb-3">
                    <label class="form-label">Chọn Trạng thái mới:</label>
                    <select class="form-select" id="newStatus">
                        @foreach (var status in (List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList)
                        {
                            <option value="@status.Id">@status.TenTrangThai</option>
                        }
                    </select>
                </div>
                <div class="mb-3" id="lyDoGroup" style="display:none;">
                    <label class="form-label">Lý do Hủy:</label>
                    <textarea class="form-control" id="lyDo"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-primary" id="btnSaveStatus">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>
</div>

@* --- Modal Xóa LHP --- *@
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa Lớp Học Phần: <span id="deleteLhpMa"></span></h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteLhpId" />
                <p>Bạn có chắc chắn muốn xóa lớp học phần này? Hành động không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" id="btnConfirmDelete">Xóa</button>
            </div>
        </div>
    </div>
</div>

@* --- Modal Auto đăng ký HP --- *@
<div class="modal fade" id="autoDangKyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chọn Học Kỳ và Thứ Tự</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Học kỳ:</label>
                    <select id="modalHocKy" class="form-select">
                        <option value="">-- Chọn Học Kỳ --</option>
                        @foreach (var hk in (SelectList)ViewBag.HocKyList)
                        {
                            <option value="@hk.Value">@hk.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Thứ tự học kỳ (Kỳ sinh viên đang theo học):</label>
                    <select id="modalThuTuHocKy" class="form-select">
                        @for (int i = 1; i <= 18; i++)
                        {
                            <option value="@i">Thứ tự @i</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-success" id="btnConfirmAutoDangKy">Chạy Auto Đăng Ký</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        $(function() {

            var selected = '@ViewBag.SelectedHocKyId';
        if (selected)
            $('select[name="hocKyId"]').val(selected);

            // Lấy ID trạng thái Hủy từ DOM/ViewBag (An toàn hơn nếu để một ViewBag riêng)
            var huyStatusId = '@(((List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList).FirstOrDefault(t => t.TenTrangThai == "Bị Hủy")?.Id ?? 0)';

            // Helper để hiển thị thông báo (Có thể thay bằng Toastr/Bootstrap Toasts)
            function showResult(isSuccess, message) {
                if (isSuccess) {
                    alert('Thành công: ' + message);
                } else {
                    alert('Lỗi: ' + message);
                }
            }

            

            // --- Cập nhật trạng thái (Sửa trạng thái) ---
            $('.btn-update-status').click(function() {
                var lhpId = $(this).data('lhp-id');
                var lhpMa = $(this).data('lhp-ma');
                $('#currentLhpId').val(lhpId);
                $('#modalLhpMa').text(lhpMa);
                $('#lyDo').val('');
                $('#lyDoGroup').hide();
            });

            $('#newStatus').change(function() {
                if ($(this).val() == huyStatusId) $('#lyDoGroup').show(); else $('#lyDoGroup').hide();
            });

            $('#btnSaveStatus').click(function() {
                var lhpId = $('#currentLhpId').val();
                var trangThaiId = $('#newStatus').val();
                var lyDo = $('#lyDo').val();
                var text = $('#newStatus option:selected').text().trim();

                if (!trangThaiId) { showResult(false, 'Chọn trạng thái mới!'); return; }
                if (text == "Bị Hủy" && !lyDo) { showResult(false, 'Nhập lý do hủy!'); return; }

                if (confirm('Xác nhận cập nhật trạng thái?')) {
                    $.post('@Url.Action("UpdateCourseClassStatus", "Admin")', { lopHocPhanId: lhpId, trangThaiId, lyDo }, function(res){
                        showResult(res.success, res.message || 'Hoàn tất');
                        if (res.success) {
                            location.reload();
                        } else {
                            $('#statusModal').modal('hide');
                        }
                    });
                }
            });

            // --- Xóa LHP ---
            $('.btn-delete-lhp').click(function() {
                var lhpId = $(this).data('lhp-id');
                var lhpMa = $(this).data('lhp-ma');
                $('#deleteLhpId').val(lhpId);
                $('#deleteLhpMa').text(lhpMa);
            });

            $('#btnConfirmDelete').click(function() {
                var lhpId = $('#deleteLhpId').val();
                if (!lhpId) { showResult(false, 'Lỗi: Không tìm thấy ID Lớp HP.'); return; }

                if (confirm('Xác nhận xóa lớp học phần? Hành động này không thể hoàn tác.')) {
                    $.post('@Url.Action("DeleteCourseClass", "Admin")', { lopHocPhanId: lhpId }, function(res){
                        showResult(res.success, res.message || 'Hoàn tất');
                        if (res.success) {
                            location.reload();
                        } else {
                            $('#deleteModal').modal('hide');
                        }
                    });
                }
            });

            // --- Click cả hàng để xem chi tiết ---
            $(document).on('click', '.clickable-row', function (e) {
                if ($(e.target).closest('button').length > 0 ||
                    $(e.target).closest('a').length > 0 ||
                    $(e.target).closest('i').length > 0) {
                    return; // Không chuyển hướng nếu click vào nút hành động
                }
                window.location = $(this).data('url');
            });
        });
    </script>
}