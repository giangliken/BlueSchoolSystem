@model IEnumerable<BlueSchoolSystem.Models.ActivityLog>

<h2 class="mb-4 text-primary">
    <i class="fas fa-clipboard-list me-2"></i> Nhật ký hoạt động
</h2>

<div class="table-responsive rounded" id="logs-table">
    @await Html.PartialAsync("_ActivityLogsTable", Model)
</div>

<script>
    async function reloadLogs() {
        try {
            const response = await fetch('@Url.Action("GetActivityLogsTable", "Admin")');
            const html = await response.text();
            document.getElementById('logs-table').innerHTML = html;
        } catch (err) {
            console.error("Không thể tải lại nhật ký:", err);
        }
    }

    // Auto reload mỗi 10 giây
    setInterval(reloadLogs, 10000);
</script>
