@model BlueSchoolSystem.Models.ViewModel.TrainingProgramVM

@{
    ViewData["Title"] = "Sơ đồ đào tạo";
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
<style>
    /* Style cho Card môn học */
    .subject-card {
        border-left: 5px solid #6c757d; /* Mặc định màu xám */
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .subject-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

        .subject-card.required {
            border-left-color: #0d6efd;
        }
        /* Bắt buộc: Xanh */
        .subject-card.optional {
            border-left-color: #ffc107;
        }
    /* Tự chọn: Vàng */

    .semester-block {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .semester-title {
        font-weight: bold;
        color: #2c3e50;
        border-bottom: 2px solid #dee2e6;
        padding-bottom: 10px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
    }

    .filter-container {
        background-color: #e9ecef;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }

    .select2-container .select2-selection--single {
        height: 48px !important; /* Chiều cao form-select-lg */
        padding: 10px;
    }

    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        line-height: 26px;
    }
</style>
<div class="container-fluid mt-4">

    <div class="filter-container shadow-sm">
        <form asp-action="TrainingProgramMap" method="get" id="filterForm" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold"><i class="fa fa-university"></i> Ngành đào tạo</label>
                <select name="nganhId" id="nganhSelect" class="form-select form-select-lg select2" asp-items="@ViewBag.NganhList">
                    <option value="" disabled selected>-- Tìm kiếm & Chọn ngành --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold"><i class="fa fa-calendar-alt"></i> Khóa học</label>
                <select name="khoaHocId" id="khoaSelect" class="form-select form-select-lg select2" asp-items="@ViewBag.KhoaHocList">
                    <option value="" disabled selected>-- Chọn khóa --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="fa fa-search"></i> Xem
                </button>
            </div>
            <div class="col-md-3 text-end">
                <a asp-action="CreateTrainingProgram" class="btn btn-outline-success">
                    <i class="fa fa-plus"></i> Thêm mới
                </a>
            </div>
        </form>
    </div>

    @if (Model == null)
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486831.png" style="width: 150px; opacity: 0.5" />
            <h4 class="text-muted mt-3">Vui lòng chọn Ngành và Khóa học để xem chương trình đào tạo</h4>
        </div>
    }
    else if (!Model.Semesters.Any())
    {
        <div class="alert alert-warning text-center">
            <i class="fa fa-exclamation-triangle"></i> Chưa có dữ liệu đào tạo cho <strong>@Model.TenNganh - Khóa @Model.NamHoc</strong>.
        </div>
    }
    else
    {
        <div class="program-content">
            <h3 class="text-center mb-4 text-uppercase fw-bold text-primary">
                Sơ đồ đào tạo: @Model.TenNganh - Khóa @Model.NamHoc
            </h3>

            <div class="row">
                @foreach (var hk in Model.Semesters)
                {
                    <div class="col-12">
                        <div class="semester-block shadow-sm">
                            <div class="semester-title">
                                <span><i class="fa fa-bookmark text-warning"></i> HỌC KỲ @hk.HocKy</span>
                                <span class="badge bg-secondary">Tổng: @hk.TongTinChi tín chỉ</span>
                            </div>

                            <div class="row g-3">
                                @foreach (var mon in hk.MonHocs)
                                {
                                    <div class="col-md-4 col-lg-3">
                                        <div class="card h-100 subject-card @(mon.BatBuoc ? "required" : "optional") shadow-sm"
                                             title="@(mon.MoTa ?? "Chưa có mô tả")">
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <small class="text-muted fw-bold">@mon.MaMonHoc</small>
                                                    <span class="badge @(mon.BatBuoc ? "bg-primary" : "bg-warning text-dark")" style="font-size: 0.7rem;">
                                                        @(mon.BatBuoc ? "Bắt buộc" : "Tự chọn")
                                                    </span>
                                                </div>
                                                <h6 class="card-title text-dark fw-bold mb-2">@mon.TenMonHoc</h6>

                                                <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top">
                                                    <span class="text-secondary" style="font-size: 0.85rem;">
                                                        <i class="fa fa-layer-group"></i> @mon.SoTinChi TC
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(mon.MaMonTienQuyet))
                                                    {
                                                        <span class="text-danger" style="font-size: 0.8rem;" data-bs-toggle="tooltip" title="Môn tiên quyết: @mon.MaMonTienQuyet">
                                                            <i class="fa fa-lock"></i> @mon.MaMonTienQuyet
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // 1. Khởi tạo Select2 cho các thẻ có class .select2
            $('.select2').select2({
                theme: 'bootstrap-5', // Sử dụng theme Bootstrap 5
                width: '100%',        // Chiều rộng 100% của container cha
                placeholder: "Vui lòng chọn...",
                allowClear: true
            });

            // 2. Tự động submit khi thay đổi giá trị (thay thế onchange trong HTML)
            // Lưu ý: Với Select2, sự kiện 'change' của jQuery mới bắt được chuẩn nhất
            $('#nganhSelect, #khoaSelect').on('change', function() {
                // Kiểm tra xem cả 2 đã được chọn chưa thì mới submit (để tránh submit khi mới chọn 1 cái)
                var nganh = $('#nganhSelect').val();
                var khoa = $('#khoaSelect').val();

                if(nganh && khoa) {
                    $('#filterForm').submit();
                }
            });

            // 3. Tooltip Bootstrap (Code cũ của bạn)
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
              return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
}