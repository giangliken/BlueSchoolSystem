@model BlueSchoolSystem.Models.ViewModel.CreateClassRequest

@{
    ViewData["Title"] = "Thêm lớp học";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="card-title mb-3">
                <i class="fa-solid fa-school me-2"></i> Thêm lớp học mới
            </h3>
            <hr />

            <form asp-action="AddClass" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">

                    <!-- Mã lớp -->
                    <div class="col-md-6">
                        <label for="MaLop" class="form-label fw-semibold">Mã lớp (*)</label>
                        <input asp-for="MaLop" class="form-control" />
                        <span asp-validation-for="MaLop" class="text-danger"></span>
                    </div>

                    <!-- Tên lớp -->
                    <div class="col-md-6">
                        <label for="TenLop" class="form-label fw-semibold">Tên lớp (*)</label>
                        <input asp-for="TenLop" class="form-control" />
                        <span asp-validation-for="TenLop" class="text-danger"></span>
                    </div>

                    <!-- Ngành học -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ngành học (*)</label>
                        <select asp-for="NganhId" class="form-select">
                            <option value="">-- Chọn ngành --</option>
                            @foreach (var nganh in ViewBag.NganhList)
                            {
                                <option value="@nganh.Id">@nganh.TenNganh</option>
                            }
                        </select>
                        <span asp-validation-for="NganhId" class="text-danger"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="col-md-6">
                        <label for="MoTa" class="form-label fw-semibold">Mô tả (không bắt buộc)</label>
                        <input asp-for="MoTa" class="form-control" />
                        <span asp-validation-for="MoTa" class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="ClassManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-plus"></i> Thêm mới
                    </button>
                </div>

            </form>
        </div>
    </div>

    <p class="mt-3"><i>*Thêm lớp học cần đảm bảo đúng ngành, khóa và sĩ số dự kiến.</i></p>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
