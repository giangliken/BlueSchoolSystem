@using BlueSchoolSystem.Models;
@model BlueSchoolSystem.Models.ViewModel.SubjectDetailViewModel

@{
    var listGV = ViewBag.AllGiangVien as List<GiangVien>;
    var searchValue = ViewContext.HttpContext.Request.Query["search"].ToString();
}

<h2 class="mb-4 fw-bold" style="position: relative; padding-left: 16px;">
    <span style="position:absolute;left:0;top:0;bottom:0;width:6px;background:#0d6efd;border-radius:4px"></span>
    Gán giảng viên cho môn học: @Model.TenMonHoc
</h2>

<!-- ❗ FORM CHÍNH -->
<form method="post" asp-action="AssignGiangVien" asp-controller="Admin">
    <input type="hidden" name="id" value="@Model.Id" />

    <!-- 🔍 Thanh tìm kiếm -->
    <div class="input-group mb-3">
        <input type="text" name="search"
               value="@searchValue"
               class="form-control"
               placeholder="Tìm theo tên hoặc mã giảng viên..." />
        <button class="btn btn-outline-secondary" type="submit" formaction="@Url.Action("AssignGiangVien", "Admin")" formmethod="get">Tìm</button>
    </div>

    <!-- 📋 Danh sách giảng viên -->
    <div class="card shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3">Danh sách giảng viên</h5>

        <div id="gvList" class="list-group" style="max-height: 70vh; overflow-y: auto;">
            @if (listGV != null && listGV.Any())
            {
                foreach (var gv in listGV)
                {
                    bool selected = Model.GiangViens.Any(x => x.Id == gv.Id);

                    var fullName = $"{gv.HoVaTenDem} {gv.Ten}";

                    <label class="list-group-item d-flex align-items-center gap-3 @(selected ? "active-gv" : "")">
                        <input type="checkbox"
                               name="selectedGVs"
                               value="@gv.Id"
                               class="form-check-input"
                               style="transform:scale(1.3)"
                               @(selected ? "checked" : "") />

                        <div>
                            <b>@fullName</b>
                            <div class="text-muted small">@gv.MaGiangVien</div>
                        </div>
                    </label>
                }
            }
            else
            {
                <div class="text-muted fst-italic">Không tìm thấy giảng viên nào…</div>
            }
        </div>
    </div>

    <button class="btn btn-primary">
        <i class="fa-solid fa-check me-2"></i> Lưu thay đổi
    </button>

    <a href="@Url.Action("SubjectDetails", "Admin", new { id = Model.Id })"
       class="btn btn-secondary ms-2">
        <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
    </a>
</form>

<style>
    .gv-item {
        border: 1px solid #e3e3e3;
        border-radius: 6px;
        margin-bottom: 8px;
        padding: 12px;
        transition: 0.2s;
    }

        .gv-item:hover {
            background: #eef6ff;
            border-color: #0d6efd;
        }

    .active-gv {
        background: #e7f1ff;
        border-color: #0d6efd !important;
    }
</style>
