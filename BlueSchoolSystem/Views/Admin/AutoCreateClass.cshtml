@model BlueSchoolSystem.Models.ViewModel.AutoClassRequest

@{
    ViewData["Title"] = "Tạo lớp tự động";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body">
            <h3 class="card-title mb-3 text-primary">
                <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
                Tạo lớp học tự động
            </h3>
            <hr />

            <form method="post" asp-action="AutoCreateClass">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">

                    <!-- Chọn ngành -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Ngành học (*)</label>
                        <select asp-for="NganhId" class="form-select">
                            <option value="">-- Chọn ngành --</option>
                            @foreach (var nganh in ViewBag.NganhList)
                            {
                                <option value="@nganh.Id">@nganh.TenNganh (Khoa: @nganh.Khoa.TenKhoa)</option>
                            }
                        </select>
                        <span asp-validation-for="NganhId" class="text-danger"></span>
                    </div>

                    <!-- Khóa -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Khóa (*)</label>
                        <input asp-for="Khoa" type="number" class="form-control" placeholder="2022" />
                        <span asp-validation-for="Khoa" class="text-danger"></span>
                    </div>

                    <!-- Số lượng -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Số lượng lớp (*)</label>
                        <input asp-for="SoLuong" type="number" class="form-control" min="1" />
                        <span asp-validation-for="SoLuong" class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="ClassManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Tạo lớp
                    </button>
                </div>
            </form>
        </div>
    </div>

    <p class="mt-3 text-muted">
        * Mã lớp được sinh theo cấu trúc: <b>YY + MãKhoa + Chữ + Số</b>
        (VD: <b>22DTHA1</b>)
    </p>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
