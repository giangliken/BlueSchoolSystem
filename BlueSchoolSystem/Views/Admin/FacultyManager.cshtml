@model IEnumerable<BlueSchoolSystem.Models.Khoa>

@{
    ViewData["Title"] = "FacultyManager";
}

<div class="modal fade" id="connectionModal" tabindex="-1" aria-labelledby="connectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="connectionModalLabel">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>Lỗi kết nối
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Không thể kết nối tới máy chủ. Vui lòng kiểm tra mạng hoặc thử lại sau.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Đã hiểu</button>
            </div>
        </div>
    </div>
</div>
<h1>Quản lý khoa viện</h1>

<div class="mb-3"><b>Tổng số:</b> @Model.Count() bản ghi</div>
<table class="table table-hover table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th class="text-center">STT</th>
            <th class="text-center">Mã khoa</th>
            <th class="text-center">Tên khoa</th>
            @* <th class="text-center">Mô tả</th> *@
        </tr>
    </thead>
    <tbody>
        @{
            foreach (var item in Model)
            {
                <tr>
                    <td style="width: 60px;" class="text-center">@item.Id</td>
                    <td style="width: 60px;" class="text-start">@item.MaKhoa</td>
                    <td style="width: 500px;" class="text-start">@item.TenKhoa</td>
                </tr>
            }
        }
    </tbody>
</table>
<p style="color:black"><i>*Nếu thông tin khoa viện có sai sót thì liên hệ quản trị viên hệ thống</i></p>
@section Scripts {
}
