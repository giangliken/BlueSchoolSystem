@using BlueSchoolSystem.Models
@model BlueSchoolSystem.Models.ViewModel.HocPhiViewModel

@{
    var sv = ViewBag.SinhVien as SinhVien;
    ViewData["Title"] = $"Học phí - {sv?.MSSV}";

    // Tính toán hiển thị
    decimal duNo = Model.DuNoHienTai;
    bool dangNo = duNo > 0;
}


<style>
    /* Giống style trang Quản lý Học phí */

    /* Hàng hover nhẹ */
    table.table-hover tbody tr:hover {
        background-color: #f2f2f2;
    }

    /* Không chữ màu, không bold */
    table td {
        font-weight: normal !important;
        color: inherit !important;
    }

    /* Header giống trang danh sách học phí */
    thead.custom-header {
        background-color: #e9ecef !important;
        font-weight: bold !important;
    }

    /* Không badge màu trong bảng */
    .no-badge {
        background: none !important;
        color: inherit !important;
        padding: 0 !important;
        font-size: inherit !important;
    }
</style>


<div class="container-fluid mt-4">

    <div class="mb-3">
        <a asp-action="TuitionManager" asp-controller="Admin" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>

    @* --- Header Thông tin & Số dư --- *@
    <div class="row mb-4">
        <div class="col-md-8">
            <h4 class="fw-bold text-primary">
                <i class="fa fa-user-graduate me-2"></i> @sv?.HoVaTenDem @sv?.Ten <span class="text-muted fs-6">(@sv?.MSSV)</span>
            </h4>
            <span class="badge bg-secondary">Lớp: @sv?.Lop?.MaLop</span>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-success shadow-sm px-4 py-2" data-bs-toggle="modal" data-bs-target="#modalThuTien">
                <i class="fa fa-money-bill-wave me-2"></i> Ghi nhận thu
            </button>
        </div>
    </div>

    @* --- Card Trạng thái tài chính --- *@
    <div class="card shadow-sm mb-4 border-start border-5 @(dangNo ? "border-danger" : "border-success")">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h5 class="text-muted mb-1">Trạng thái tài chính hiện tại</h5>
                @if (dangNo)
                {
                    <h2 class="text-danger fw-bold mb-0">ĐANG NỢ: @duNo.ToString("N0") đ</h2>
                    <small class="text-danger"><i class="fa fa-exclamation-circle"></i> Sinh viên cần đóng thêm tiền.</small>
                }
                else if (duNo < 0)
                {
                    <h2 class="text-success fw-bold mb-0">DƯ (VÍ): @Math.Abs(duNo).ToString("N0") đ</h2>
                    <small class="text-success"><i class="fa fa-check-circle"></i> Số tiền này sẽ được trừ tự động khi đăng ký môn mới.</small>
                }
                else
                {
                    <h2 class="text-muted fw-bold mb-0">0 đ (Hoàn thành)</h2>
                }
            </div>
            <div class="text-end text-muted">
                <i class="fa fa-wallet fa-4x opacity-25"></i>
            </div>
        </div>
    </div>

    @* --- Tabs Lịch sử --- *@
    <ul class="nav nav-tabs mb-3" id="myTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="phatsinh-tab" data-bs-toggle="tab" data-bs-target="#phatsinh" type="button">
                <i class="fa fa-list-ul me-2"></i> Khoản phí phải đóng (Ghi Nợ)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="dongtien-tab" data-bs-toggle="tab" data-bs-target="#dongtien" type="button">
                <i class="fa fa-history me-2"></i> Lịch sử Đóng tiền (Ghi Có)
            </button>
        </li>
    </ul>

    <div class="tab-content">

        @* TAB 1: DANH SÁCH MÔN ĐÃ ĐĂNG KÝ (NỢ) *@
        <div class="tab-pane fade show active" id="phatsinh">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="custom-header">
                            <tr>
                                <th>Thời gian</th>
                                <th> Môn học</th>
                                <th>Mã LHP</th>
                                <th class="text-end">Số tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.LichSuPhatSinh)
                            {
                                <tr>
                                    <td>@item.NgayPhatSinh.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span>@item.DangKyHocPhan?.LopHocPhan?.MonHoc?.TenMonHoc</span>
                                       
                                    </td>
                                    <td>@item.DangKyHocPhan?.LopHocPhan?.MaLopHocPhan</td>
                                    <td class="text-end">+@item.SoTien.ToString("N0") đ</td>
                                </tr>
                            }
                            @if (!Model.LichSuPhatSinh.Any())
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu đăng ký môn học.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* TAB 2: LỊCH SỬ ĐÓNG TIỀN (CÓ) *@
        <div class="tab-pane fade" id="dongtien">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="custom-header">
                            <tr>
                                <th>Ngày đóng</th>
                                <th>Người thu</th>
                                <th>Ghi chú</th>
                                <th class="text-end">Số tiền đóng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.LichSuDongTien)
                            {
                                <tr>
                                    <td>@item.NgayDong.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.NguoiThu</td>
                                    <td>@item.GhiChu</td>
                                    <td class="text-end">+ @item.SoTienDong.ToString("N0") đ</td>
                                </tr>
                            }
                            @if (!Model.LichSuDongTien.Any())
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có lịch sử đóng tiền.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- MODAL THU TIỀN --- *@
<div class="modal fade" id="modalThuTien" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="MakePayment" method="post">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fa fa-money-bill-wave"></i> Ghi nhận thu</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="sinhVienId" value="@sv.Id" />

                    <div class="alert alert-light border text-center">
                        Dư nợ hiện tại: <strong class="@(dangNo ? "text-danger" : "text-success")">@duNo.ToString("N0") đ</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số tiền khách đóng (VNĐ):</label>
                        <div class="input-group">
                            <input type="number" name="soTien" class="form-control fw-bold text-success fs-4"
                                   min="1000" step="1000" required placeholder="0"
                                   value="@(dangNo? duNo : 0)" /> @* Gợi ý số tiền bằng đúng số nợ *@
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ghi chú (Mã GD/Nội dung):</label>
                        <textarea name="ghiChu" class="form-control" rows="2" placeholder="VD: Thu tiền mặt tại văn phòng..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success px-4 fw-bold">Xác nhận Thu</button>
                </div>
            </form>
        </div>
    </div>
</div>