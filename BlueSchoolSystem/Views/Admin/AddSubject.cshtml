@model BlueSchoolSystem.Models.ViewModel.MonHocViewModel
@{
    ViewData["Title"] = "Thêm môn học";
}

<h2 class="mb-4">Thêm môn học</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="AddSubject" method="post" class="card p-4 shadow-sm">
    <div class="mb-3">
        <label class="form-label fw-bold">Mã môn học</label>
        <input asp-for="MaMonHoc" class="form-control" placeholder="VD: CT101" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Tên môn học</label>
        <input asp-for="TenMonHoc" class="form-control" placeholder="VD: Lập trình C#" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Số tín chỉ</label>
        <input asp-for="SoTinChi" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Mô tả</label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a href="@Url.Action("SubjectManager", "Admin")" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Thêm môn học
        </button>
    </div>
</form>

@section Scripts {
    <script>
        setTimeout(() => {
            let alerts = document.querySelectorAll(".alert");
            alerts.forEach(a => new bootstrap.Alert(a).close());
        }, 4000);
    </script>
}
