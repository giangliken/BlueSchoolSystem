@model BlueSchoolSystem.Models.CoSo

<h2>Chi tiết Cơ sở: @Model.TenCoSo</h2>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Mã cơ sở:</strong> @Model.MaCoSo</p>
        <p><strong>Tên cơ sở:</strong> @Model.TenCoSo</p>
        <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
        <p><strong>Vị trí:</strong> Vĩ độ: @Model.Latitude, Kinh độ: @Model.Longitude</p>
    </div>
</div>

<h4>Danh sách phòng học</h4>
<div class="mb-3">
    <button class="btn btn-primary me-2" id="btnAddRoom">Thêm phòng học</button>
    <input type="text" id="txtRoomKeyword" class="form-control d-inline-block me-2" style="width:250px" placeholder="Tìm kiếm phòng..." />
    <button class="btn btn-secondary" id="btnResetFilter">Reset</button>
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Mã phòng</th>
                <th>Tên phòng</th>
                <th>Sức chứa</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="tableRoomBody">
            @if (Model.PhongHocs != null && Model.PhongHocs.Any())
            {
                var i = 1;
                foreach (var phong in Model.PhongHocs)
                {
                    <tr>
                        <td>@i</td>
                        <td>@phong.MaPhongHoc</td>
                        <td>@phong.TenPhongHoc</td>
                        <td>@phong.SoChoNgoi</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" onclick="editRoom(@phong.Id, '@phong.MaPhongHoc', '@phong.TenPhongHoc', @phong.SoChoNgoi)">Sửa</button>
                            <button class="btn btn-danger btn-sm" onclick="showDeleteRoomModal(@phong.Id, '@phong.TenPhongHoc')">Xóa</button>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr><td colspan="5" class="text-center text-muted py-3">Chưa có phòng học nào</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="FacilityManager" asp-controller="Admin" class="btn btn-secondary">Quay lại danh sách</a>
    <a asp-action="EditFacility" asp-controller="Admin" asp-route-id="@Model.Id" class="btn btn-primary">Sửa cơ sở</a>

    <button type="button" class="btn btn-danger"
            data-bs-toggle="modal"
            data-bs-target="#deleteModal"
            data-id="@Model.Id"
            data-name="@Model.TenCoSo">
        Xóa cơ sở
    </button>
</div>

<!-- Modal Thêm/Sửa phòng -->
<div class="modal fade" id="roomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="roomModalTitle">Thêm phòng học mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label>Mã phòng</label>
                    <input type="text" id="txtRoomCode" class="form-control" placeholder="VD: E1.01.01" />
                </div>
                <div class="mb-2">
                    <label>Tên phòng</label>
                    <input type="text" id="txtRoomName" class="form-control" placeholder="VD: Phòng CNTT" />
                </div>
                <div class="mb-2">
                    <label>Sức chứa</label>
                    <input type="number" id="txtRoomCapacity" class="form-control" min="1" value="1" />
                    <small class="text-muted"></small>
                </div>
                <div id="roomModalAlert" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-primary" id="btnSaveRoom">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xóa phòng -->
<div class="modal fade" id="deleteRoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Xác nhận xóa phòng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa phòng <strong id="roomNameDisplay"></strong> không?
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger" id="confirmDeleteRoomBtn">Xóa</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xóa cơ sở, Success, SystemError giữ nguyên -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc chắn muốn xóa cơ sở <strong id="facilityNameDisplay">@Model.TenCoSo</strong> không?
                <div id="deleteAlert" class="alert mt-2 d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn" data-id="@Model.Id">Xóa</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">Thành công!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body text-center">
                <i class="fas fa-check-circle text-success mb-2" style="font-size: 2rem;"></i>
                <p id="successMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="systemErrorModal" tabindex="-1" aria-labelledby="systemErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="systemErrorModalLabel"><i class="fas fa-times-circle"></i> Lỗi Hệ Thống</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p id="systemErrorMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="hiddenAccessToken" value="@(ViewBag.AccessToken)" />
<input type="hidden" id="hiddenFacilityId" value="@Model.Id" />

@section Scripts {
    <script>
        const TOKEN = $('#hiddenAccessToken').val() || '';
        const FACILITY_ID = $('#hiddenFacilityId').val();
        let currentEditRoomId = null;
        let currentDeleteRoomId = null;

        function openSystemErrorModal(msg){
            $('#systemErrorMessage').text(msg);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('systemErrorModal')).show();
        }

        function openSuccessModal(msg){
            $('#successMessage').text(msg);
            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('successModal'));
            modal.show();
            $(document.getElementById('successModal')).on('hidden.bs.modal', function(){
                location.reload();
            });
        }

        // ---------- Quản lý cơ sở ----------
        function deleteFacility(id, name){
            if(!TOKEN){ openSystemErrorModal("Lỗi 401: Token đăng nhập không tìm thấy."); return; }
            bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            $('.modal-backdrop').remove();

            $.ajax({
                url:`/api/xoa-coso/${id}`,
                type:'DELETE',
                headers:{ "Authorization": "Bearer " + TOKEN },
                success: function(res){
                    if(res.result){ openSuccessModal(res.message || `Xóa "${name}" thành công!`); }
                    else{ openSystemErrorModal(res.message || `Không thể xóa "${name}"`); }
                },
                error: function(err){ openSystemErrorModal("Lỗi hệ thống khi xóa cơ sở."); }
            });
        }

        $('#deleteModal').on('show.bs.modal', function(e){
            var btn = $(e.relatedTarget);
            var id = btn.data('id');
            var name = btn.data('name');
            $(this).find('#facilityNameDisplay').text(name);
            $('#confirmDeleteBtn').data('id', id);
            $('#confirmDeleteBtn').data('name', name);
        });
        $('#confirmDeleteBtn').on('click', function(){
            deleteFacility($(this).data('id'), $(this).data('name'));
        });

        // ---------- Quản lý phòng ----------
        function renderRoomTable(data){
            let html = '';
            if(data.length>0){
                data.forEach((r,i)=>{
                    html+=`<tr>
                        <td>${i+1}</td>
                        <td>${r.maPhongHoc}</td>
                        <td>${r.tenPhongHoc}</td>
                        <td>${r.soChoNgoi}</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" onclick="editRoom(${r.id}, '${r.maPhongHoc}', '${r.tenPhongHoc}', ${r.soChoNgoi})">Sửa</button>
                            <button class="btn btn-danger btn-sm" onclick="showDeleteRoomModal(${r.id}, '${r.tenPhongHoc}')">Xóa</button>
                        </td>
                    </tr>`;
                });
            }else{
                html='<tr><td colspan="5" class="text-center text-muted py-3">Chưa có phòng học nào</td></tr>';
            }
            $('#tableRoomBody').html(html);
        }

        function loadRooms(keyword=''){
            $.ajax({
                url:`/api/laydanhsachphonghoc`,
                type:'GET',
                data:{ coSoId:FACILITY_ID, keyword:keyword },
                headers:{ "Authorization":"Bearer "+TOKEN },
                success:function(res){ if(res.result && res.data) renderRoomTable(res.data); },
                error:function(){ openSystemErrorModal("Lỗi khi tải danh sách phòng."); }
            });
        }
                   function saveRoom() {
            const obj = {
                MaPhongHoc: $('#txtRoomCode').val().trim(),
                TenPhongHoc: $('#txtRoomName').val().trim(),
                SoChoNgoi: parseInt($('#txtRoomCapacity').val() || 0),
                CoSoId: FACILITY_ID
            };

            if (!obj.MaPhongHoc || !obj.TenPhongHoc || obj.SoChoNgoi < 1) {
                $('#roomModalAlert').removeClass('d-none').text("Vui lòng nhập đầy đủ thông tin hợp lệ!");
                return;
            }

            const url = currentEditRoomId ? `/api/suaphonghoc/${currentEditRoomId}` : `/api/taomoi-phonghoc`;
            const type = currentEditRoomId ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: type,
                headers: { "Authorization": "Bearer " + TOKEN },
                contentType: "application/json",
                data: JSON.stringify(obj),
                success: function(res) {
                    if (res.result) {
                        bootstrap.Modal.getInstance(document.getElementById('roomModal')).hide();
                        $('#roomModalAlert').addClass('d-none');
                        currentEditRoomId = null;
                        openSuccessModal(res.message || `Lưu phòng "${obj.TenPhongHoc}" thành công!`);
                    } else {
                        $('#roomModalAlert').removeClass('d-none').text(res.message);
                    }
                },
                error: function(err) {
                    $('#roomModalAlert').removeClass('d-none').text(
                        err.responseJSON?.message || "Lỗi hệ thống khi lưu phòng."
                    );
                }
            });
        }



        function editRoom(id, ma, ten, soCho){
            currentEditRoomId=id;
            $('#roomModalTitle').text('Sửa phòng học');
            $('#txtRoomCode').val(ma);
            $('#txtRoomName').val(ten);
            $('#txtRoomCapacity').val(soCho);
            $('#roomModalAlert').addClass('d-none');
            bootstrap.Modal.getOrCreateInstance(document.getElementById('roomModal')).show();
        }

        function showDeleteRoomModal(id, name){
            currentDeleteRoomId=id;
            $('#roomNameDisplay').text(name);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteRoomModal')).show();
        }

        function deleteRoom(){
            if(!currentDeleteRoomId) return;
            $.ajax({
                url:`/api/xoaphonghoc/${currentDeleteRoomId}`,
                type:'DELETE',
                headers:{ "Authorization":"Bearer "+TOKEN },
                success:function(res){
                    bootstrap.Modal.getInstance(document.getElementById('deleteRoomModal')).hide();
                    if(res.result){ openSuccessModal(res.message || "Xóa phòng thành công!"); }
                    else{ openSystemErrorModal(res.message || "Không thể xóa phòng."); }
                },
                error:function(){ bootstrap.Modal.getInstance(document.getElementById('deleteRoomModal')).hide(); openSystemErrorModal("Lỗi hệ thống khi xóa phòng."); }
            });
        }

        $(document).ready(function(){
            loadRooms();

            $('#btnAddRoom').on('click', function(){
                currentEditRoomId=null;
                $('#roomModalTitle').text('Thêm phòng học mới');
                $('#txtRoomCode').val('');
                $('#txtRoomName').val('');
                $('#txtRoomCapacity').val('1');
                $('#roomModalAlert').addClass('d-none');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('roomModal')).show();
            });
            $('#btnSaveRoom').on('click', saveRoom);

            $('#txtRoomKeyword').on('keypress', function(e){ if(e.which===13) loadRooms($(this).val().trim()); });
            $('#btnResetFilter').on('click', function(){ $('#txtRoomKeyword').val(''); loadRooms(); });

            $('#confirmDeleteRoomBtn').on('click', deleteRoom);
        });
    </script>
}
