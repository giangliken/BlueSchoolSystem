@* File: Views/Admin/CreateCourseClass.cshtml *@
@model BlueSchoolSystem.Models.ViewModel.LopHocPhanCreateDTO
@{
    ViewData["Title"] = "Mở Lớp Học Phần Mới";
    var defaultOpenStatusId =
        ((List<BlueSchoolSystem.Models.TrangThai>)ViewBag.TrangThaiLHPList)?
        .FirstOrDefault(t => t.TenTrangThai == "Chờ mở")?.Id ?? 0;
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title">@ViewData["Title"]</h3>
        </div>

        <div class="card-body">
            <form asp-action="CreateCourseClass" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <hr />

                        @* 1. Học Kỳ *@
                        <div class="mb-3">
                            <label asp-for="HocKyId" class="form-label"></label>
                            <select asp-for="HocKyId" asp-items="ViewBag.HocKyList"
                                    class="form-select" id="HocKyId">
                                <option value="">-- Chọn Học Kỳ --</option>
                            </select>
                            <span asp-validation-for="HocKyId" class="text-danger"></span>
                        </div>

                        @* 6. Mã lớp học phần *@
                        <div class="mb-3">
                            <label asp-for="MaLopHocPhan" class="form-label"></label>
                            <input asp-for="MaLopHocPhan" id="MaLopHocPhan" class="form-control" readonly />
                            <span asp-validation-for="MaLopHocPhan" class="text-danger"></span>
                        </div>

                        @* 3. Giảng Viên *@
                        <div class="mb-3">
                            <label asp-for="GiangVienId" class="form-label"></label>
                            <select asp-for="GiangVienId" asp-items="ViewBag.GiangVienList"
                                    class="form-select" id="GiangVienSelect">
                                <option value="">-- Chọn Giảng Viên --</option>
                            </select>
                            <span asp-validation-for="GiangVienId" class="text-danger"></span>
                        </div>

                        @* 7. Ngày Bắt đầu *@
                        <div class="mb-3">
                            <label asp-for="NgayBatDauLHP" class="form-label"></label>
                            <input asp-for="NgayBatDauLHP" id="NgayBatDauLHP" type="date" class="form-control" />
                            <span asp-validation-for="NgayBatDauLHP" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <hr />

                        @* 2. Môn Học *@
                        <div class="mb-3">
                            <label asp-for="MonHocId" class="form-label"></label>
                            <select asp-for="MonHocId" asp-items="ViewBag.MonHocList"
                                    class="form-select" id="MonHocSelect">
                                <option value="">-- Chọn Môn Học --</option>
                            </select>
                            <span asp-validation-for="MonHocId" class="text-danger"></span>
                        </div>

                        @* 5. Tên LHP *@
                        <div class="mb-3">
                            <label asp-for="TenLopHocPhan" class="form-label"></label>
                            <input asp-for="TenLopHocPhan" id="TenLopHocPhan" class="form-control" readonly />
                            <span asp-validation-for="TenLopHocPhan" class="text-danger"></span>
                        </div>

                        @* 4. Sỉ số *@
                        <div class="mb-3">
                            <label asp-for="SiSoToiDa" class="form-label"></label>
                            <input asp-for="SiSoToiDa" class="form-control" />
                            <span asp-validation-for="SiSoToiDa" class="text-danger"></span>
                        </div>

                        @* 8. Ngày kết thúc *@
                        <div class="mb-3">
                            <label asp-for="NgayKetThucLHP" class="form-label"></label>
                            <input asp-for="NgayKetThucLHP" id="NgayKetThucLHP" type="date" class="form-control" />
                            <span asp-validation-for="NgayKetThucLHP" class="text-danger"></span>
                        </div>

                    </div>
                </div>

                @* Buttons *@
                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa fa-save"></i> Tạo Lớp Học Phần
                    </button>

                    <a asp-action="CourseClassManager" class="btn btn-secondary btn-lg">
                        <i class="fa fa-arrow-left"></i> Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    await Html.RenderPartialAsync("_ValidationScriptsPartial")

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {

            // SELECT2
            $('#HocKyId, #MonHocSelect, #GiangVienSelect').select2({
                width: "100%",
                allowClear: true,
            });

            var monHocSelect = $('#MonHocSelect');
            var hocKySelect = $('#HocKyId');
            var giangVienSelect = $('#GiangVienSelect');

            var maLhpInput = $('#MaLopHocPhan');
            var tenLhpInput = $('#TenLopHocPhan');
            var ngayBatDau = $('#NgayBatDauLHP');
            var ngayKetThuc = $('#NgayKetThucLHP');

            // ------------------------ LOAD GIẢNG VIÊN ------------------------
            function loadGiangVien(monHocId, selectedId = null) {
                giangVienSelect.empty().append('<option value="">Đang tải...</option>');

                if (Number(monHocId) > 0) {
                    $.get('@Url.Action("GetGiangVienTheoMon", "Admin")',
                        { monHocId: monHocId },
                        function (data) {

                            giangVienSelect.empty().append('<option value="">-- Chọn Giảng Viên --</option>');

                            data.forEach(gv => {
                                giangVienSelect.append(
                                    `<option value="${gv.id}">${gv.hoTen}</option>`
                                );
                            });

                            if (selectedId)
                                giangVienSelect.val(selectedId);

                            // reload select2
                            giangVienSelect.trigger('change.select2');
                        });
                } else {
                    giangVienSelect.html('<option value="">-- Chọn Giảng Viên --</option>');
                }
            }

            // ------------------------ LẤY NGÀY HỌC KỲ ------------------------
            function getHocKyDates(id) {
                if (Number(id) > 0) {
                    $.get('@Url.Action("GetHocKyDates", "Admin")',
                        { hocKyId: id },
                        function (data) {
                            if (data.success) {
                                ngayBatDau.val(data.ngayBatDau);
                                ngayKetThuc.val(data.ngayKetThuc);
                            }
                        });
                }
            }

            // ------------------------ GENERATE MÃ LHP ------------------------
            function autoGenerate() {
                let hk = hocKySelect.val();
                let mh = monHocSelect.val();

                if (Number(hk) > 0 && Number(mh) > 0) {

                    $.get('@Url.Action("GenerateLopHocPhanInfo", "Admin")',
                        { hocKyId: hk, monHocId: mh },
                        function (data) {
                            if (data.success) {
                                maLhpInput.val(data.maLopHocPhan);
                                tenLhpInput.val(data.tenLopHocPhan);
                            }
                        });
                }
            }

            // EVENTS
            hocKySelect.change(function () {
                getHocKyDates($(this).val());
                autoGenerate();
            });

            monHocSelect.change(function () {
                loadGiangVien($(this).val());
                autoGenerate();
            });

            // LOAD LẠI KHI POSTBACK
            let initMH = monHocSelect.val();
            let initHK = hocKySelect.val();
            let initGV = '@Model.GiangVienId';

            if (Number(initMH) > 0) {
                loadGiangVien(initMH, initGV);
                autoGenerate();
            }

            if (Number(initHK) > 0) {
                getHocKyDates(initHK);
            }
        });
    </script>
}
