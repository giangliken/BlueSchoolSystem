@model BlueSchoolSystem.Models.Khoa

@{
    ViewData["Title"] = "Chỉnh Sửa Ban Chủ Nhiệm Khoa";
    var giangVienList = ViewBag.GiangVienList as SelectList;
    var truongKhoaList = ViewBag.TruongKhoaList as SelectList;
    var phoKhoaList = ViewBag.PhoKhoaList as SelectList;
    var troLyList = ViewBag.TroLyList as SelectList;
    var currentTruongId = ViewBag.CurrentTruongId ?? 0;
    var currentPhoId = ViewBag.CurrentPhoId ?? 0;
    var currentTroLyId = ViewBag.CurrentTroLyId ?? 0;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4 text-gray-800">Cập nhật Ban Chủ Nhiệm Khoa</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-10">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin khoa</h6>
                </div>
                <div class="card-body">
                    <form asp-action="EditFaculty">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="Id" />

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger">@TempData["Error"]</div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="MaKhoa" class="control-label">Mã Khoa</label>
                                    <input asp-for="MaKhoa" class="form-control" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="TenKhoa" class="control-label">Tên Khoa</label>
                                    <input asp-for="TenKhoa" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <hr />
                        <h6 class="font-weight-bold text-info mt-4 mb-3">Ban Chủ Nhiệm</h6>

                        <div class="form-group">
                            <label for="TruongKhoaId" class="control-label">Trưởng khoa</label>
                            <select name="TruongKhoaId" id="TruongKhoaId" class="form-control select-searchable" asp-items="truongKhoaList">
                                <option value="0">- Chưa chọn -</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="PhoKhoaId"class="control-label">Phó khoa</label>
                            <select name="PhoKhoaId" id="PhoKhoaId" class="form-control select-searchable" asp-items="phoKhoaList">
                                <option value="0">- Chưa chọn -</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="TroLiKhoaId">Trợ lý khoa</label> <select name="TroLiKhoaId" id="TroLiKhoaId" class="form-control select-searchable" asp-items="troLyList">
                                <option value="0">- Chưa chọn -</option>
                            </select>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                            <a asp-action="FacultyDetails" asp-route-id="@Model.Id" class="btn btn-secondary ml-2"><i class="fas fa-arrow-left"></i> Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <link href="https://raw.githack.com/ttskch/select2-bootstrap4-theme/master/dist/select2-bootstrap4.css" rel="stylesheet" />

    <style>
        .select2-container--bootstrap4 .select2-selection {
            height: calc(1.5em + .75rem + 2px) !important;
        }

        .select2-container--bootstrap4 .select2-selection__rendered {
            padding-left: .5rem;
            padding-top: .2rem;
            padding-bottom: .75rem;
            line-height: calc(1em + .2rem);
        }

        .select2-container--bootstrap4 .select2-selection__clear,
        .select2-container--bootstrap4 .select2-selection__arrow {
            display: none !important;
        }

        .select2-container--bootstrap4 .select2-selection--single {
            padding-right: .75rem !important;
        }
    </style>

    <script>
        var facultySelectIds = ['#TruongKhoaId', '#PhoKhoaId', '#TroLiKhoaId'];

        function customMatcher(params, data) {
            if ($(data.element).prop('disabled')) return null;
            if ($.trim(params.term) === '') return data;
            if (data.text.toLowerCase().indexOf(params.term.toLowerCase()) > -1) return data;
            return null;
        }

        function synchronizeSelections() {
            var allSelected = [];
            facultySelectIds.forEach(function(id) {
                var val = $(id).val();
                if (val && val !== '0') allSelected.push(val);
            });

            facultySelectIds.forEach(function(id) {
                var current = $(id).val();
                $(id).find('option').each(function() {
                    var optVal = $(this).val();
                    if (optVal !== '0') $(this).prop('disabled', allSelected.includes(optVal) && optVal !== current);
                });
            });
        }

        function handleSelect(e) {
            var $sel = $(e.currentTarget);
            var data = e.params.data;
            if (data.id === "0") $sel.val(null).trigger('change');
            setTimeout(function() { synchronizeSelections(); $sel.select2('close'); }, 1);
        }

        $(document).ready(function() {
            $('.select-searchable').select2({ theme: 'bootstrap4', placeholder: 'Chọn giảng viên', allowClear: false, matcher: customMatcher });
            facultySelectIds.forEach(function(id) { $(id).on('select2:select', handleSelect); $(id).on('change', synchronizeSelections); });
            setTimeout(synchronizeSelections, 50);
        });
    </script>

}
