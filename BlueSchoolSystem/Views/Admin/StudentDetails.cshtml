@model BlueSchoolSystem.Models.SinhVien

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Thông tin sinh viên</h4>
                </div>

                <div class="card-body">

                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl"
                                 class="rounded-circle border"
                                 style="width: 150px; height: 150px; object-fit: cover; border: 2px solid #ccc;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center"
                                 style="width: 150px; height: 150px; border: 2px solid #ccc;">
                                <span>Avatar</span>
                            </div>
                        }
                        <h5>Ảnh đại diện</h5>
                    </div>


                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between d-flex justify-content-between"><strong>MSSV:</strong> @Model.MSSV</li>
                        <li class="list-group-item d-flex justify-content-between d-flex justify-content-between"><strong>Họ tên:</strong> @Model.HoVaTenDem @Model.Ten</li>
                        <li class="list-group-item d-flex justify-content-between d-flex justify-content-between"><strong>Giới tính:</strong> @(Model.GioiTinh ? "Nam" : "Nữ")</li>
                        <li class="list-group-item d-flex justify-content-between d-flex justify-content-between"><strong>Ngày sinh:</strong> @Model.NgaySinh.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item d-flex justify-content-between d-flex justify-content-between"><strong>CCCD:</strong> @Model.CCCD</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Số điện thoại:</strong> @Model.User?.PhoneNumber</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Email:</strong> @Model.User?.Email</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Địa chỉ:</strong> @Model.DiaChi</li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Lớp:</strong>
                            @(Model.Lop != null ? Model.Lop.TenLop : "Chưa xếp")
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Ngành học:</strong>
                            @(Model.Lop?.Nganh?.TenNganh ?? "Chưa đăng ký ngành")
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <strong>Khoa/Viện:</strong>
                            @(Model.Lop?.Nganh?.Khoa?.TenKhoa ?? "Chưa thuộc khoa viện nào")
                        </li>

                        <li class="list-group-item d-flex justify-content-between"><strong>Ngày nhập học:</strong> @Model.NgayNhapHoc.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Ngày tốt nghiệp:</strong> @Model.NgayTotNghiep.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Trạng thái:</strong> @Model.TrangThai?.TenTrangThai</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Ghi chú:</strong> @Model.GhiChu</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Tài khoản:</strong> @Model.User?.UserName</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</li>
                        <li class="list-group-item d-flex justify-content-between"><strong>Cập nhật gần nhất:</strong> @Model.UpdatedAt.ToString("HH:mm dd/MM/yyyy")</li>
                    </ul>
                </div>

                <div class="card-footer bg-light text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Sửa
                    </a>
                    <form asp-action="ResetPassword" asp-route-id="@Model.Id" asp-route-type="SinhVien" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fa-solid fa-key me-2"></i>
                            Cấp lại mật khẩu
                        </button>
                    </form>


                    <a asp-action="StudentManager" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
