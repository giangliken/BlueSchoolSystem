@model BlueSchoolSystem.Models.SinhVien

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Thông tin sinh viên</h4>
                </div>

                <div class="card-body">

                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                        {
                            <img src="@Model.AvatarUrl" class="rounded-circle border" style="max-width: 120px;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                                <span>Avatar</span>
                            </div>
                        }
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>MSSV:</strong> @Model.MSSV</li>
                        <li class="list-group-item"><strong>Họ tên:</strong> @Model.HoVaTenDem @Model.Ten</li>
                        <li class="list-group-item"><strong>Giới tính:</strong> @(Model.GioiTinh ? "Nam" : "Nữ")</li>
                        <li class="list-group-item"><strong>Ngày sinh:</strong> @Model.NgaySinh.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item"><strong>Địa chỉ:</strong> @Model.DiaChi</li>
                        <li class="list-group-item"><strong>Lớp:</strong> @Model.Lop?.TenLop</li>
                        <li class="list-group-item"><strong>Ngày nhập học:</strong> @Model.NgayNhapHoc.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item"><strong>Ngày tốt nghiệp:</strong> @Model.NgayTotNghiep.ToString("dd/MM/yyyy")</li>
                        <li class="list-group-item"><strong>Trạng thái:</strong> @Model.TrangThai</li>
                        <li class="list-group-item"><strong>Ghi chú:</strong> @Model.GhiChu</li>
                        <li class="list-group-item"><strong>Tài khoản:</strong> @Model.User?.UserName</li>
                        <li class="list-group-item"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                        <li class="list-group-item"><strong>Cập nhật gần nhất:</strong> @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                    </ul>
                </div>

                <div class="card-footer bg-light text-center">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                        <i class="bi bi-pencil-square"></i> Sửa
                    </a>
                    <a asp-action="StudentManager" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
