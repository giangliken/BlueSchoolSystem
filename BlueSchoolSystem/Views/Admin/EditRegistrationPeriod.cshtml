@model BlueSchoolSystem.Models.ViewModel.DotDangKyDTO
@{
    ViewData["Title"] = "Sửa Đợt Đăng Ký";

    var loaiDoiTuongList = ViewBag.LoaiDoiTuongList as List<string> ?? new List<string>();
    var thaoTacList = ViewBag.ThaoTacList as List<string>?? new List<string>();

    // Lấy đối tượng đầu tiên, nếu không có thì tạo mới
    var doiTuong = Model.DoiTuongApDungs?.FirstOrDefault()
                   ?? new BlueSchoolSystem.Models.ViewModel.DoiTuongApDungDTO();
}

<h2>@ViewData["Title"]</h2>

<form asp-action="EditRegistrationPeriod" method="post">

    <input type="hidden" asp-for="HocKyId" />

    <div class="mb-3">
        <label class="form-label">Tên Đợt</label>
        <input asp-for="TenDot" class="form-control" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label>Ngày Bắt Đầu</label>
            <input asp-for="NgayBatDau" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label>Ngày Kết Thúc</label>
            <input asp-for="NgayKetThuc" type="datetime-local" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Thao Tác</label>
        <select asp-for="LoaiThaoTac" class="form-select">
            @foreach (var t in thaoTacList)
            {
                <option value="@t" selected="@(Model.LoaiThaoTac == t)">
                    @t
                </option>
            }
        </select>
    </div>

    <h5>Đối Tượng Áp Dụng</h5>

    <div class="row">
        <div class="col-md-4">
            <select class="form-select" name="DoiTuongApDungs[0].Loai">
                @foreach (var l in loaiDoiTuongList)
                {
                    <option value="@l" selected="@(doiTuong.Loai == l)">
                        @l
                    </option>
                }
            </select>
        </div>

        <div class="col-md-8">
            <input class="form-control" name="DoiTuongApDungs[0].GiaTri"
                   value="@doiTuong.GiaTri" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Cập nhật</button>
    <a asp-action="RegistrationPeriods" class="btn btn-outline-secondary mt-3">Quay Lại</a>
</form>
