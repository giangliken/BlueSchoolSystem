@model IEnumerable<BlueSchoolSystem.Models.SinhVien>

@{
    ViewData["Title"] = "StudentManager";
    var token = Context.Session.GetString("access_token");

}


<form asp-action="StudentManager" method="get" class="row mb-3">
    <div class="col-md-3">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm kiếm theo họ tên/ mã số sinh viên ..." />
    </div>
    @{
        var lopList = (List<BlueSchoolSystem.Models.ViewModel.LopHocViewModel>)ViewBag.LopList;
        var khoaList = (List<BlueSchoolSystem.Models.Khoa>)ViewBag.KhoaList;
    }
    
    <div class="col-md-3">
        <select class="form-select class-select" id="NienKhoaSelect" name="nienKhoa">
            <option value="">-- Tất cả niên khóa --</option>
            @foreach (var year in ViewBag.ListNienKhoa as List<int>)
            {
                // Giữ selected nếu đã chọn
                if ((Context.Request.Query["nienKhoa"] == year.ToString()) || (ViewBag.NienKhoa?.ToString() == year.ToString()))
                {
                    <option value="@year" selected>@year</option>
                }
                else
                {
                    <option value="@year">@year</option>
                }
            }
        </select>
    </div>



    <div class="col-md-3">
        <select class="form-select class-select" id="KhoaSelect" name="maKhoa">
            <option value="">-- Tất cả các khoa --</option>
           

            @foreach (var khoa in khoaList)
            {
                if (Context.Request.Query["maKhoa"] == khoa.MaKhoa)
                {
                    <option value="@khoa.MaKhoa" selected>@khoa.TenKhoa</option>
                }
                else
                {
                    <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                }
            }
        </select>


    </div>
    <div class="col-md-3">
        <select class="form-select class-select" id="LopSelect" name="maLop">
            <option value="">-- Tất cả các lớp --</option>
            @if (Context.Request.Query["maLop"] == "__null__")
            {
                <option value="__null__" selected>Chưa xếp lớp</option>
            }
            else
            {
                <option value="__null__">Chưa xếp lớp</option>
            }

            @foreach (var lop in lopList)
            {
                if (Context.Request.Query["maLop"] == lop.MaLop)
                {
                    <option value="@lop.MaLop" selected>@lop.TenLop</option>
                }
                else
                {
                    <option value="@lop.MaLop">@lop.TenLop</option>
                }
            }
        </select>


    </div>

    <div class="row">
        <div class="col-12 d-flex justify-content-end mt-2">
            <button type="submit" class="btn btn-info me-2">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
            </button>
            <a asp-action="StudentManager" class="btn btn-secondary">
                <i class="fa-solid fa-rotate-left me-1"></i> Reset
            </a>
        </div>
    </div>
</form>


<p>
    <a class="btn btn-primary" asp-action="AddStudent">
        <i class="fa-solid fa-user-plus me-2"></i>Thêm mới
    </a>
    <a class="btn btn-success" asp-action="ImportStudentListFromExcel">
        <i class="fa-solid fa-file-import me-2"></i>Nhập từ Excel
    </a>
    <button type="button" class="btn btn-warning" id="btnExportExcel">
        <i class="fa-solid fa-file-excel me-2"></i> Xuất Excel
    </button>
    <button type="button" class="btn btn-info" id="btnExportCSV">
        <i class="fa-solid fa-file-csv me-2"></i> Xuất CSV
    </button>
   



</p>


<div class="d-flex justify-content-between align-items-center mb-2">
    <div><b>Tổng số:</b> @Model.Count() dòng</div>
    <button type="button" class="btn btn-dark" id="btnPrint">
        <i class="fa-solid fa-print me-2"></i> In danh sách
    </button>
</div>



<table class="table table-hover table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th class="text-center">STT</th>
            <th class="text-center">Mã số sinh viên</th>
            <th class="text-center">Họ và tên đệm</th>
            <th class="text-center">Tên</th>
            <th class="text-center">Ngày sinh</th>
            <th class="text-center">Giới tính</th>
            <th class="text-center">Lớp</th>
            <th class="text-center">Trạng thái</th>
        </tr>
    </thead>
   
    @{
        int stt = 1;
    }
    @foreach (var item in Model)
    {
        string rowClass = item.TrangThai?.TenTrangThai switch
        {
            "Đang học" => "table-success fw-semibold",
            "Bảo lưu" => "table-warning fw-semibold",
            "Đã tốt nghiệp" => "table-primary text-white fw-semibold",
            "Thôi học" => "table-danger text-white fw-semibold",
            _ => ""
        };

        <tr class="table-row @rowClass" style="cursor:pointer;" onclick="window.location='@Url.Action("StudentDetails", "Admin", new { id = item.Id })'">
            <td class="text-center">@stt</td>
            <td class="text-center">@item.MSSV</td>
            <td>@item.HoVaTenDem</td>
            <td>@item.Ten</td>
            <td class="text-center">@item.NgaySinh.ToString("dd/MM/yyyy")</td>
            <td class="text-center">
                @(item.GioiTinh ? "Nam" : "Nữ")
            </td>
            <td class="text-center">
                @(item.Lop?.TenLop ?? "Chưa xếp")
            </td>
            <td class="text-center">@item.TrangThai?.TenTrangThai</td>
        </tr>
        stt++;
    }

</table>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.7.0/jspdf.plugin.autotable.min.js"></script>

    <script>
        window.__accessToken = @Html.Raw(Json.Serialize(token));
    </script>

    <script>
        $(document).ready(function() {
                    $('#KhoaSelect').on('change', function () {
            let maKhoa = $(this).val();
            var token = window.__accessToken;
            let options;
            if (!maKhoa) {
                // Nếu KHÔNG chọn khoa, vẫn show option "Chưa xếp lớp"
                options = '<option value="">-- Tất cả các lớp --</option><option value="__null__">Chưa xếp lớp</option>';
                // Gọi API hoặc render lại full danh sách lớp (tùy backend bạn support)
                // Hoặc bạn có thể reload trang, hoặc giữ nguyên list cũ
                $('#LopSelect').html(options).trigger('change.select2');
            } else {
                // Nếu đã chọn khoa, KHÔNG show "Chưa xếp lớp"
                options = '<option value="">-- Tất cả các lớp --</option>';
                $.ajax({
                    url: `/api/laydanhsachlophoctheokhoa?maKhoa=${maKhoa}`,
                    type: 'GET',
                    headers: {
                        'Authorization': 'Bearer ' + token
                    },
                    success: function (res) {
                        if (res.data) {
                            res.data.forEach(function (lop) {
                                options += `<option value="${lop.maLop}">${lop.tenLop}</option>`;
                            });
                        }
                        $('#LopSelect').html(options).trigger('change.select2');
                    },
                    error: function () {
                        alert("Hiện không có lớp nào thuộc khoa này");
                    }
                });
            }
        });

        });
    </script>

    <script>
        document.getElementById('btnExportExcel').addEventListener('click', function () {
            var table = document.querySelector('table.table');
            var wb = XLSX.utils.table_to_book(table, { sheet: "Danh sách sinh viên" });
            XLSX.writeFile(wb, 'DanhSachSinhVien.xlsx');
        });

        document.getElementById('btnExportCSV').addEventListener('click', function () {
            var table = document.querySelector('table.table');
            var ws = XLSX.utils.table_to_sheet(table);
            var csv = XLSX.utils.sheet_to_csv(ws);
            // Tạo link download file csv
            var blob = new Blob([csv], { type: 'text/csv' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'DanhSachSinhVien.csv';
            a.click();
            URL.revokeObjectURL(url);
        });
    </script>
    <script>
        document.getElementById('btnPrint').addEventListener('click', function () {
            var printContents = document.querySelector('table.table').outerHTML;
            var originalContents = document.body.innerHTML;

            // Tạo 1 document mới chỉ chứa table
            document.body.innerHTML = `
                <div style="text-align:center; margin-bottom:16px;">
                    <h2>Danh sách sinh viên</h2>
                </div>
                ${printContents}
            `;
            window.print();

            // Sau khi in xong thì load lại trang (trả về như cũ)
            window.location.reload();
        });
    </script>

}




