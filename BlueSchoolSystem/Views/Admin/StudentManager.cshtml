@model IEnumerable<BlueSchoolSystem.Models.SinhVien>

@{
    ViewData["Title"] = "StudentManager";
   
}

<form asp-action="StudentManager" method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm kiếm theo họ tên/ mã số sinh viên ..." />
    </div>
    <div class="col-md-4">
        <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm kiếm theo họ tên/ mã số sinh viên ..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-info me-2">
            <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
        </button>
        <a asp-action="StudentManager" class="btn btn-secondary">
            <i class="fa-solid fa-rotate-left me-1"></i> Reset
        </a>
    </div>
</form>


<p>
    <a class="btn btn-primary" asp-action="AddStudent">
        <i class="fa-solid fa-user-plus me-2"></i>Thêm sinh viên mới
    </a>
    <a class="btn btn-success" asp-action="ImportStudentListFromExcel">
        <i class="fa-solid fa-file-import me-2"></i>Nhập danh sách sinh viên
    </a>
    <a class="btn btn-warning" asp-action="Create">
        <i class="fa-solid fa-file-export me-2"></i>Xuất danh sách sinh viên
    </a>
</p>

<div class="mb-3"><b>Tổng số:</b> @Model.Count() dòng</div>
<table class="table table-hover table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th class="text-center">STT</th>
            <th class="text-center">Mã số sinh viên</th>
            <th class="text-center">Họ và tên đệm</th>
            <th class="text-center">Tên</th>
            <th class="text-center">Ngày sinh</th>
            <th class="text-center">Giới tính</th>
            <th class="text-center">Lớp</th>
            <th class="text-center">Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string rowClass = item.TrangThai switch
            {
                "Đang học" => "table-success fw-semibold",      // xanh lá nhạt
                "Bảo lưu" => "table-warning fw-semibold",      // vàng nhạt
                "Tốt nghiệp" => "table-primary text-white fw-semibold", // xanh dương, chữ trắng
                "Thôi học" => "table-danger text-white fw-semibold",  // đỏ, chữ trắng
                _ => ""                                // mặc định không màu
            };
            <tr class="table-row @rowClass" style="cursor:pointer;" onclick="window.location='@Url.Action("StudentDetails", "Admin", new { id = item.Id })'">
                <td class="text-center">@item.Id</td>
                <td class="text-center">@item.MSSV</td>
                <td>@item.HoVaTenDem</td>
                <td>@item.Ten</td>
                <td class="text-center">@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                    @(item.GioiTinh ? "Nam" : "Nữ")
                </td>
                <td class="text-center">
                    @(item.Lop?.TenLop ?? "Chưa xếp")
                </td>
                <td class="text-center">@item.TrangThai</td>
            </tr>
        }


    </tbody>
</table>

@section Scripts {
    
}


