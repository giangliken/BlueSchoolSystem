@model IEnumerable<BlueSchoolSystem.Models.ViewModel.HocPhiDashboardVM>

@{
    ViewData["Title"] = "Quản lý Học phí";
}

<style>
    /* Tùy chỉnh màu đường kẻ bảng cho rõ hơn */
    .table-bordered th,
    .table-bordered td {
        border: 1px solid #dee2e6 !important; /* Màu xám nhạt chuẩn Bootstrap */
    }

    /* Header bảng: Màu nền xám đậm hơn chút để tách biệt */
    table thead.custom-header th {
        background-color: #000 !important; /* NỀN ĐEN */
        color: #fff !important; /* CHỮ TRẮNG */
        font-weight: 700 !important;
        font-size: 0.9rem;
        vertical-align: middle;
        border-bottom: 2px solid #222;
    }

    /* Hiệu ứng hover khi di chuột vào hàng */
    .clickable-row {
        cursor: pointer;
    }

    /* Màu hover đậm hơn màu stripe một chút để dễ nhận biết */
    .table-hover tbody tr:hover {
        background-color: #e2e6ea !important;
    }

    /* Canh giữa nội dung trong ô cho đẹp */
    table tbody td {
        vertical-align: middle;
    }
</style>

<div class="container-fluid mt-4">

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="keyword" class="form-control"
                           placeholder="Tìm theo MSSV hoặc Tên..." value="@ViewBag.Keyword">
                </div>

                @* 2. Dropdown chọn KHOA *@
                <div class="col-md-3">
                    <select name="khoaId" class="form-select" asp-items="@ViewBag.KhoaList">
                        <option value="">-- Tất cả Khoa --</option>
                    </select>
                </div>

                @* 3. Dropdown chọn KHÓA HỌC *@
                <div class="col-md-3">
                    <select name="khoaHoc" class="form-select" asp-items="@ViewBag.KhoaHocList">
                        <option value="">-- Tất cả Khóa --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover align-middle mb-0">
                <thead class="custom-header">
                    <tr>
                        <th>MSSV</th>
                        <th>Họ tên</th>
                        <th>Khoa</th>
                        <th class="text-end">Dư nợ hiện tại</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="clickable-row" onclick="window.location='@Url.Action("TuitionDetails", new { id = item.SinhVienId })'">
                            <td >@item.MSSV</td>
                            <td >@item.HoTen</td>
                            <td>@item.TenKhoa</td>

                            <td class="text-end">
                                @if (item.TongNo > 0)
                                {
                                    <span >+@item.TongNo.ToString("N0") đ</span>
                                }
                                else if (item.TongNo < 0)
                                {
                                    <span >@item.TongNo.ToString("N0") đ</span>
                                }
                                else
                                {
                                    <span >0 đ</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TongNo > 0)
                                {
                                    <span >Nợ phí</span>
                                }
                                else
                                {
                                    <span >Hoàn thành</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>