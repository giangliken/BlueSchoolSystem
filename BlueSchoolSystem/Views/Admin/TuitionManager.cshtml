@model IEnumerable<BlueSchoolSystem.Models.ViewModel.HocPhiDashboardVM>

@{
    ViewData["Title"] = "Quản lý Học phí Sinh viên";
}

<div class="container-fluid mt-4">

    @* --- Header --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">
            <i class="fa fa-file-invoice-dollar me-2"></i> Quản lý Học phí
        </h2>

        @* --- NÚT MỚI THÊM Ở ĐÂY --- *@
        <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCreateFeeRate">
            <i class="fa fa-plus-circle me-2"></i> Tạo định mức học phí
        </button>
    </div>

    @* --- Phần 1: Bộ lọc tìm kiếm --- *@
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fa fa-filter me-2"></i> Bộ lọc tìm kiếm</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="TuitionManager" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Từ khóa</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa fa-search"></i></span>
                        <input type="text" name="keyword" class="form-control"
                               placeholder="Nhập MSSV hoặc Họ tên..." value="@ViewBag.Keyword">
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold">Lớp hành chính</label>
                    <select name="lopId" class="form-select select2" asp-items="@ViewBag.LopList">
                        <option value="">-- Tất cả lớp --</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-50 me-2">
                        <i class="fa fa-search"></i> Tìm
                    </button>
                    <a asp-action="TuitionManager" class="btn btn-outline-secondary w-50">
                        <i class="fa fa-sync"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    @* --- Phần 2: Bảng dữ liệu --- *@
    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-primary text-center">
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th>MSSV</th>
                            <th>Họ và Tên</th>
                            <th>Lớp</th>
                            <th>Tổng Nợ</th>
                            <th>Số Dư Ví</th>
                            <th>Trạng thái</th>
                            <th style="width: 100px;">Thao tác</th> @* Thu nhỏ cột thao tác *@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                // Sự kiện click hàng giữ nguyên
                                <tr onclick="window.location.href='@Url.Action("TuitionDetails", new { id = item.SinhVienId })'"
                                    style="cursor: pointer;" title="Bấm để xem chi tiết">

                                    <td class="text-center">@(i++)</td>

                                    @* MSSV: Bỏ in đậm, bỏ màu xanh *@
                                    <td class="text-center">@item.MSSV</td>

                                    <td>@item.HoTen</td>

                                    @* Lớp: Bỏ badge, bỏ màu nền *@
                                    <td class="text-center">
                                        @item.TenLop
                                    </td>

                                    @* Tổng nợ: Bỏ in đậm, bỏ màu đỏ *@
                                    <td class="text-end">
                                        @if (item.TongNo > 0)
                                        {
                                            <span>@item.TongNo.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    @* Số dư ví: Bỏ in đậm, bỏ màu xanh *@
                                    <td class="text-end">
                                        @if (item.SoDuVi > 0)
                                        {
                                            <span>@item.SoDuVi.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span>0 đ</span>
                                        }
                                    </td>

                                    @* Trạng thái: Bỏ badge, hiển thị text thường *@
                                    <td class="text-center">
                                        @if (item.TongNo > 0)
                                        {
                                            <span>Còn nợ</span>
                                        }
                                        else
                                        {
                                            <span>Hoàn thành</span>
                                        }
                                    </td>

                                    @* Cột Thao tác *@
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-warning"
                                                title="Tính toán lại công nợ"
                                                onclick="event.stopPropagation(); openUpdateModal('@item.SinhVienId', '@item.MSSV', '@item.HoTen')">
                                            <i class="fa fa-sync-alt"></i> 
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa fa-folder-open fa-2x mb-2"></i><br />
                                    Không tìm thấy dữ liệu sinh viên nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted small">
            Hiển thị @(Model?.Count() ?? 0) kết quả. (Bấm vào hàng để xem chi tiết)
        </div>
    </div>
</div>

@* ================================================================= *@
@* PHẦN 3: MODAL CẬP NHẬT NHANH *@
@* ================================================================= *@
<div class="modal fade" id="modalQuickUpdate" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateTuition" method="post">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title text-dark"><i class="fa fa-calculator me-2"></i> Cập nhật Học phí</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted">Sinh viên:</label>
                        <div class="fw-bold fs-5">
                            <span id="modalSvName"></span>
                            <small class="text-muted fw-normal ms-1">(<span id="modalSvMssv"></span>)</small>
                        </div>
                    </div>

                    <div class="alert alert-light border small">
                        <i class="fa fa-info-circle text-primary me-1"></i>
                        Hành động này sẽ quét lại các môn đã đăng ký trong kỳ được chọn và áp dụng đơn giá mới nhất để tính lại công nợ.
                    </div>

                    <input type="hidden" name="sinhVienId" id="modalSvId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Học kỳ cần tính:</label>
                        <select name="hocKyId" class="form-select" asp-items="@ViewBag.HocKys" required>
                            <option value="">-- Vui lòng chọn học kỳ --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning fw-bold">Xác nhận cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* --- MODAL 3: TẠO ĐỊNH MỨC HỌC PHÍ MỚI --- *@
<div class="modal fade" id="modalCreateFeeRate" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateFeeRate" method="post">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fa fa-plus-circle"></i> Thiết lập giá Tín chỉ</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border small">
                        <i class="fa fa-info-circle text-success me-1"></i>
                        Thiết lập đơn giá cho 1 tín chỉ. Hệ thống sẽ áp dụng giá này khi tính toán công nợ cho sinh viên thuộc Ngành và Năm học tương ứng.
                    </div>

                    @* 1. Năm học *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Năm học áp dụng:</label>
                        <input type="text" name="NamHoc" class="form-control" placeholder="VD: 2024-2025" required />
                        <small class="text-muted">Nhập đúng định dạng chuỗi (VD: 2024-2025)</small>
                    </div>

                    @* 2. Ngành học *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Áp dụng cho Ngành:</label>
                        @* ViewBag.NganhList cần được gán ở Action TuitionManager *@
                        <select name="NganhId" class="form-select" asp-items="@ViewBag.NganhList">
                            <option value="">-- Áp dụng chung (Toàn trường) --</option>
                        </select>
                        <small class="text-muted">Để trống nếu muốn áp dụng giá này cho tất cả các ngành.</small>
                    </div>

                    @* 3. Giá tiền *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Giá tiền 1 Tín chỉ (VNĐ):</label>
                        <div class="input-group">
                            <input type="number" name="GiaTienMotTinChi" class="form-control fw-bold text-success" min="1000" step="1000" required />
                            <span class="input-group-text">VNĐ</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-bold">Lưu thiết lập</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.select2').select2({
                width: '100%',
                placeholder: "Chọn lớp học...",
                allowClear: true
            });
        });

        function openUpdateModal(id, mssv, name) {
            $('#modalSvId').val(id);
            $('#modalSvMssv').text(mssv);
            $('#modalSvName').text(name);
            var myModal = new bootstrap.Modal(document.getElementById('modalQuickUpdate'));
            myModal.show();
        }
    </script>
}