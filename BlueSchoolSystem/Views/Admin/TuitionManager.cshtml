@model IEnumerable<BlueSchoolSystem.Models.ViewModel.HocPhiDashboardVM>

@{
    ViewData["Title"] = "Quản lý Học phí";
}

<style>
    /* Hàng hover */
    .clickable-row {
        cursor: pointer;
        transition: background-color 0.15s;
    }

        .clickable-row:hover {
            background-color: #f2f2f2;
        }

    /* Bỏ in đậm body, không ảnh hưởng header */
    table tbody td {
        font-weight: normal !important;
        color: inherit !important;
    }

    /* Tăng độ ưu tiên cho header */
    table thead.custom-header th {
        background-color: #d7d7d7 !important;
        font-weight: 700 !important;
        font-size: 15px !important;
        color: #000 !important;
    }
</style>

<div class="container-fluid mt-4">


    <!-- Bộ lọc -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="keyword" class="form-control"
                           placeholder="Tìm theo MSSV hoặc Tên..." value="@ViewBag.Keyword">
                </div>

                <div class="col-md-3">
                    <select name="lopId" class="form-select" asp-items="@ViewBag.LopList">
                        <option value="">-- Tất cả lớp --</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card shadow">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="custom-header">
                    <tr>
                        <th>MSSV</th>
                        <th>Họ tên</th>
                        <th>Lớp</th>
                        <th class="text-end">Dư nợ hiện tại</th>
                        <th class="text-center">Trạng thái</th>

                    </tr>
                </thead>


                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="clickable-row" onclick="window.location='@Url.Action("TuitionDetails", new { id = item.SinhVienId })'">
                            <td>@item.MSSV</td>
                            <td>@item.HoTen</td>

                            <td>@item.TenLop</td>

                            <td class="text-end">
                                @* Dư = số âm, Nợ = số dương *@
                                @if (item.TongNo > 0)
                                {
                                    <span>+@item.TongNo.ToString("N0") đ</span>
                                }
                                else if (item.TongNo < 0)
                                {
                                    <span>@item.TongNo.ToString("N0") đ</span> @* Sẽ tự hiện dấu - *@
                                }
                                else
                                {
                                    <span>0 đ</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (item.TongNo > 0)
                                {
                                    <span>Chưa hoàn thành</span>
                                }
                                else
                                {
                                    <span>Hoàn thành</span>
                                }
                            </td>


                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
