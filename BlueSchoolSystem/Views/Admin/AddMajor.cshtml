@model BlueSchoolSystem.Models.NganhHoc
@{
    var khoas = ViewBag.Khoas as List<Khoa> ?? new List<Khoa>();
}


<h2 class="mb-4 fw-bold" style="position: relative; padding-left: 16px;">
    <span style="position: absolute; left: 0; top: 0; bottom: 0;
                 width: 6px; background: var(--bs-primary); border-radius: 4px;"></span>
    Thêm ngành học
</h2>

<form asp-action="AddMajor" method="post" class="card shadow-sm p-4">
    <div class="mb-3">
        <label class="form-label">Mã ngành(*)</label>
        <input asp-for="MaNganh" class="form-control" />
        <span asp-validation-for="MaNganh" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Tên ngành(*)</label>
        <input asp-for="TenNganh" class="form-control" />
        <span asp-validation-for="TenNganh" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Khoa/Viện(*)</label>
        <select asp-for="KhoaId" class="form-select">
            <option value="">-- Chọn khoa --</option>
            @foreach (var khoa in khoas)
            {
                <option value="@khoa.Id">@khoa.TenKhoa</option>
            }
        </select>
        <span asp-validation-for="KhoaId" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-action="MajorManager" class="btn btn-secondary me-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>

        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Thêm ngành
        </button>
    </div>

</form>
