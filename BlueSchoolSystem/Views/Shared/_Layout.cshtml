<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BLUESCHOOL EMS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" href="~/assets/images/Logo/Icon_ko_phong.png" type="image/x-icon">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>


</head>

<body class="d-flex flex-column min-vh-100">

    <div class="d-flex flex-grow-1">
        <!-- Sidebar -->
        @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin")))
        {
            <div class="sidebar d-flex flex-column p-3 text-bg-dark" style="width: 280px;">
                <a href="" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <img src="/images/Logo/Logo.png" alt="Logo" style="width:38px; height:38px; object-fit:contain;" class="me-2">
                    <span class="fs-4">BLUESCHOOL EMS</span>
                </a>
                <hr>

                <ul class="nav nav-pills flex-column mb-auto">
                    <li>
                        <a href="/Admin/index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/index") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-home me-2"></i> Trang chủ
                        </a>

                    </li>
                    @* <li>
                        <a href="/Admin/StaffManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/StaffManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-home me-2"></i> Quản lí giảng viên/cán bộ
                        </a>

                    </li> *@
                    <li>
                        <a href="/Admin/StudentManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/StudentManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-users me-2"></i>Sinh viên
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/TeacherManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/TeacherManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-chalkboard-user me-2"></i>Cán bộ / Giảng viên
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/ClassManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/ClassManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-people-roof me-2"></i>Lớp học
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/MajorManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/MajorManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-graduation-cap me-2"></i>Ngành học
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/FacultyManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/FacultyManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-building-columns me-2"></i>Khoa/Viện
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/SubjectManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/SubjectManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-book me-2"></i>Môn học
                        </a>
                    </li>


                    <li>
                        <a href="/Admin/SemesterManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/SemesterManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-calendar-day me-2"></i>Học kỳ
                        </a>

                    </li>
                    @* <li>
                        <a href="/Admin/RegistrationPeriods" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/RegistrationPeriods") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-registered me-2"></i>Đợt đăng ký lớp học phần
                        </a>

                    </li> *@

                    <li>
                        <a href="/Admin/CreateTrainingProgram" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/CreateTrainingProgram") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-book me-2"></i> Tạo chương trình đào tạo
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/CourseClassManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/CourseClassManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-graduation-cap me-2"></i>Lớp học phần
                        </a>

                    </li>
                    <li>
                        <a href="/Admin/FacilityManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/FacilityManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-calendar-day me-2"></i>Cơ sở

                        </a>

                    </li>
                    <li>
                        <a href="/Admin/TuitionManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/TuitionManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-file-invoice-dollar me-2"></i>Quản lý Học phí
                        </a>

                    </li>

                    @* <li>
                        <a href="/Admin/StudentManager" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/StudentManager") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-users me-2"></i>Tài khoản người dùng
                        </a>

                    </li> *@

                    <li>
                        <a href="/Admin/ActivityLogs" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/ActivityLogs") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-clock-rotate-left me-2"></i>Nhật ký hệ thống
                        </a>
                    </li>
                </ul>

            </div>
        }
        else if (User.Identity.IsAuthenticated && User.IsInRole("Teacher"))
        {
            <div class="sidebar d-flex flex-column p-3 text-bg-dark" style="width: 280px;">
                <a href="" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <img src="/images/Logo/Logo.png" alt="Logo" style="width:38px; height:38px; object-fit:contain;" class="me-2">
                    <span class="fs-4">BLUESCHOOL EMS</span>
                </a>
                <hr>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li>
                        <a href="/Teacher/index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/index") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-home me-2"></i> Trang chủ
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/LichGiangDay" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/LichGiangDay") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-home me-2"></i> Lịch giảng dạy
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/LopPhuTrach" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/LopPhuTrach") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-people-roof me-2"></i>Lớp phụ trách
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/LopHocPhan" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/LopHocPhan") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-users-rectangle me-2"></i>Lớp học phần
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/DiemDanh" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/DiemDanh") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-clipboard-user me-2"></i>Điểm danh
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/XemDiem" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/XemDiem") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-calendar-check me-2"></i>Nhập điểm
                        </a>
                    </li>
                    <li>
                        <a href="/Teacher/ActivityLogs" class="nav-link @(Context.Request.Path.StartsWithSegments("/Teacher/ActivityLogs") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-clipboard-list me-2"></i>Nhật ký giảng viên
                        </a>
                    </li>
                    <li>
                        <a href="/Identity/Account/Manage" class="nav-link @(Context.Request.Path.StartsWithSegments("/Identity/Account/Manage") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-user-gear me-2"></i>Hồ sơ cá nhân
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (User.Identity.IsAuthenticated && (User.IsInRole("Student")))
        {
            <div class="sidebar d-flex flex-column p-3 text-bg-dark" style="width: 300px;">
                <a href="" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                    <img src="/images/Logo/Logo.png" alt="Logo" style="width:38px; height:38px; object-fit:contain;" class="me-2">
                    <span class="fs-4">BLUESCHOOL EMS</span>
                </a>
                <hr>

                <ul class="nav nav-pills flex-column mb-auto">
                    <li>
                        <a href="/Home/index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/index") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-home me-2"></i> Trang chủ
                        </a>
                    </li>

                    <!-- Học vụ -->
                    @{
                        bool isHocVuActive =
                        Context.Request.Path.StartsWithSegments("/Home/ThoiKhoaBieu")
                        || Context.Request.Path.StartsWithSegments("/Home/LichThi")
                        || Context.Request.Path.StartsWithSegments("/Home/XemDiem")
                        || Context.Request.Path.StartsWithSegments("/Home/LopHocPhan")
                        || Context.Request.Path.StartsWithSegments("/Module/xyz");
                    }

                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#hocvuMenu"
                           role="button"
                           aria-expanded="@(isHocVuActive.ToString().ToLower())"
                           aria-controls="hocvuMenu">
                            <span><i class="fas fa-book me-2"></i> Học vụ</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse @(isHocVuActive ? "show" : "")" id="hocvuMenu">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ms-4">
                                <li>
                                    <a href="/Home/ThoiKhoaBieu" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/ThoiKhoaBieu") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-calendar-days me-2"></i>Thời khóa biểu
                                    </a>

                                </li>
                                <!-- Lịch thi -->
                                <li>
                                    <a href="/Home/LichThi" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/LichThi") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-hourglass-start me-2"></i>Lịch thi
                                    </a>

                                </li>
                                <!-- Xem điểm -->
                                <li>
                                    <a href="/Home/XemDiem" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/XemDiem") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-calendar-check me-2"></i>Xem điểm
                                    </a>

                                </li>
                                <!-- Lớp học phần -->
                                <li>
                                    <a href="/Home/LopHocPhan" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/LopHocPhan") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-users-rectangle me-2"></i>Lớp học phần
                                    </a>

                                </li>
                            </ul>
                        </div>
                    </li>
                    <!-- Đăng ký học phần -->
                    <li>
                        <a href="/Home/DangKyLopHP" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/DangKyLopHP") ? "active text-white bg-primary" : "text-white")">
                            <i class="fa-solid fa-graduation-cap me-2"></i>Đăng ký học phần
                        </a>

                    </li>

                    <!-- Học phí -->
                    <li class="mb-1">
                        <a href="/Home/HocPhi" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/HocPhi") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-money-bill me-2"></i> Học phí
                        </a>
                    </li>

                    <!-- Yêu cầu - Trợ giúp -->
                    @{
                        bool isTroGiupActive =
                        Context.Request.Path.StartsWithSegments("/Home/XacNhanOnline")
                        || Context.Request.Path.StartsWithSegments("/Home/NopDon");
                    }
                    <li>
                        @* <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#bieumaunopdon"
                           role="button"
                           aria-expanded="@(isHocVuActive.ToString().ToLower())"
                           aria-controls="hocvuMenu">
                            <span><i class="fas fa-book me-2"></i> Học vụ</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a> *@
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#bieumaunopdon"
                           role="button"
                           aria-expanded="@(isTroGiupActive.ToString().ToLower())"
                           aria-controls="bieumaunopdon">
                            <span><i class="fa-brands fa-wpforms me-2"></i> Biểu mẫu - Nộp đơn</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse @(isTroGiupActive ? "show" : "")" id="bieumaunopdon">
                            <ul class="list-unstyled ms-4">
                                <li>
                                    <a href="/Home/XacNhanOnline" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/XacNhanOnline") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-square-check me-2"></i>Xác nhận online
                                    </a>
                                </li>
                                <li>
                                    <a href="/Home/NopDon" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/NopDon") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-envelopes-bulk me-2"></i>Nộp đơn
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <!-- Hỏi đáp -->
                    @{
                        bool isHoiDapActive =
                        Context.Request.Path.StartsWithSegments("/Home/TaoCauHoiMoi")
                        || Context.Request.Path.StartsWithSegments("/Home/CauHoiDaGui");
                    }
                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#hoidapMenu"
                           role="button"
                           aria-expanded="@(isHoiDapActive.ToString().ToLower())"
                           aria-controls="hoidapMenu">
                            <span><i class="fa-solid fa-circle-question me-2"></i> Hỏi - Đáp</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse @(isHoiDapActive ? "show" : "")" id="hoidapMenu">
                            <ul class="list-unstyled ms-4">
                                <li>
                                    <a href="/Home/TaoCauHoiMoi" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/TaoCauHoiMoi") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-plus me-2"></i>Tạo câu hỏi mới
                                    </a>
                                </li>
                                <li>
                                    <a href="/Home/CauHoiDaGui" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/CauHoiDaGui") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-folder-plus me-2"></i>Câu hỏi đã gửi
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <!-- Đánh giá rèn luyện -->
                    @{
                        bool isDanhGiaActive =
                        Context.Request.Path.StartsWithSegments("/Home/DanhGiaDiemRenLuyenCaNhan");
                    }
                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse"
                           href="#danhgiaMenu"
                           role="button"
                           aria-expanded="@(isDanhGiaActive.ToString().ToLower())"
                           aria-controls="danhgiaMenu">
                            <span><i class="fas fa-scale-balanced me-2"></i> Đánh giá rèn luyện</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse @(isDanhGiaActive ? "show" : "")" id="danhgiaMenu">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ms-4">
                                <li>
                                    <a href="/Home/DanhGiaDiemRenLuyenCaNhan" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/DanhGiaDiemRenLuyenCaNhan") ? "active text-white bg-primary" : "text-white")">
                                        <i class="fa-solid fa-pager me-2"></i>Điểm cá nhân
                                    </a>
                                </li>
                            </ul>
                        </div>

                    </li>

                    <!-- Đoàn - Hội -->
                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse" href="#doanhoiMenu" role="button" aria-expanded="false" aria-controls="doanhoiMenu">
                            <span><i class="fas fa-chart-column me-2"></i> Đoàn - Hội</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse" id="doanhoiMenu">
                            <ul class="list-unstyled ms-4">
                                <li>
                                    <a class="nav-link text-white d-flex justify-content-between align-items-center"
                                       data-bs-toggle="collapse" href="#namtotMenu" role="button" aria-expanded="false" aria-controls="namtotMenu">
                                        Sinh viên 5 tốt<i class="fas fa-chevron-down small"></i>
                                    </a>
                                    <div class="collapse" id="namtotMenu">
                                        <ul class="list-unstyled ms-4">
                                            <li><a href="/Home/index" class="nav-link text-white">Hồ sơ</a></li>
                                            <li><a href="/Home/index" class="nav-link text-white">Hoạt động</a></li>
                                            <li><a href="/Home/index" class="nav-link text-white">Tài liệu</a></li>
                                        </ul>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <!-- Khảo sát -->
                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse" href="#khaosatMenu" role="button" aria-expanded="false" aria-controls="khaosatMenu">
                            <span><i class="fas fa-clipboard-list me-2"></i> Khảo sát</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse" id="khaosatMenu">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ms-4">
                                <li><a href="/Home/index" class="nav-link text-white">Hoạt động giảng dạy</a></li>
                            </ul>
                        </div>

                    </li>

                    <!-- Khác -->
                    <li>
                        <a class="nav-link text-white d-flex justify-content-between align-items-center"
                           data-bs-toggle="collapse" href="#khacMenu" role="button" aria-expanded="false" aria-controls="khacMenu">
                            <span><i class="fas fa-list me-2"></i> Khác</span>
                            <i class="fas fa-chevron-down small"></i>
                        </a>
                        <div class="collapse" id="khacMenu">
                            <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small ms-4">
                                <li><a href="/Home/index" class="nav-link text-white">Danh bạ</a></li>
                            </ul>
                        </div>

                    </li>


                    <!-- Tài khoản -->
                    <li>
                        <a href="/Identity/Account/Manage" class="nav-link @(Context.Request.Path.StartsWithSegments("/Identity/Account/Manage") ? "active text-white bg-primary" : "text-white")">
                            <i class="fas fa-user-gear me-2"></i>Hồ sơ cá nhân
                        </a>
                    </li>
                </ul>

            </div>
        }

        <!-- Main Content -->
        <main class="content flex-grow-1 d-flex flex-column">
            <!-- Topbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light px-3 mb-3 border-bottom shadow-sm position-relative">
                <div class="container-fluid justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </nav>




            <!-- Page Content -->
            <div class="container-fluid flex-grow-1">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="bg-light text-center py-3 border-top mt-auto">
                <div class="container">
                    <span>&copy; 2025 HỆ THỐNG QUẢN LÝ ĐÀO TẠO BLUESCHOOL</span>
                </div>
            </footer>
        </main>
    </div>

    <!-- Bootstrap JS + Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
    @await Html.PartialAsync("_ConnectionModal")
    <script src="~/js/check-connection.js"></script>

</body>


</html>


<script>
    // Hàm phát hiện thiết bị di động (cực kỳ phổ biến)
    function isMobile() {
      return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }

    window.onload = function () {
      if (isMobile()) {
        // Hiện popup/overlay cảnh báo
        document.body.innerHTML = `
          <div style="
            display:flex;align-items:center;justify-content:center;height:100vh;width:100vw;
            background:white;z-index:99999;position:fixed;top:0;left:0;right:0;bottom:0;
            flex-direction:column;text-align:center;">
            <img src='https://cdn-icons-png.flaticon.com/512/753/753345.png' width="80"/>
            <h2 style="color:#FF4B4B;">Trang web này không hỗ trợ thiết bị di động!</h2>
