<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>BLUESCHOOL EMS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" href="~/assets/images/Logo/Icon_ko_phong.png" type="image/x-icon">



    <style>
        

    </style>

</head>

<body class="d-flex flex-column min-vh-100">

    <div class="d-flex flex-grow-1">
        <!-- Sidebar -->
        <div class="sidebar d-flex flex-column p-3 text-bg-dark" style="width: 280px;">
            <a href="/Home" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                <i class="fas fa-shop me-2 fs-4"></i>
                <span class="fs-4">BLUESCHOOL EMS</span>
            </a>
            <hr>

            <ul class="nav nav-pills flex-column mb-auto">
                <li>
                    <a href="/Home/index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/index") ? "active text-white bg-primary" : "text-white")">
                        <i class="fas fa-home me-2"></i> Trang chủ
                    </a>

                </li>
                <li>
                    <a href="/Home/index" class="nav-link @(Context.Request.Path.StartsWithSegments("/Home/index") ? "active text-white bg-primary" : "text-white")">
                        <i class="fas fa-home me-2"></i> Quản lý sinh viên
                    </a>

                </li>
                
                <li>
                    <a href="/Admin/ActivityLog" class="nav-link @(Context.Request.Path.StartsWithSegments("/Admin/ActivityLog") ? "active text-white bg-primary" : "text-white")">
                        <i class="fas fa-clipboard-list me-2"></i>Nhật ký hệ thống
                    </a>
                </li>
            </ul>

        </div>

        <!-- Main Content -->
        <main class="content flex-grow-1 d-flex flex-column">
            <!-- Topbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light px-3 mb-3 border-bottom shadow-sm position-relative">
                <div class="container-fluid justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </nav>




            <!-- Page Content -->
            <div class="container-fluid flex-grow-1">
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="bg-light text-center py-3 border-top mt-auto">
                <div class="container">
                    <span>&copy; 2025 HỆ THỐNG QUẢN LÝ ĐÀO TẠO BLUESCHOOL</span>
                </div>
            </footer>
        </main>
    </div>

    <!-- Bootstrap JS + Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>


</html>
