<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BlueSchoolSystem</title>

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="sidebar d-flex flex-column">
        <div class="p-4">
            <h4 class="text-center">BLUESCHOOL SYSTEM</h4>
        </div>
        <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-2"></i>Trang chủ</a>
        <a class="nav-link" asp-controller="Student" asp-action="Profile"><i class="fas fa-user me-2"></i>Hồ sơ cá nhân</a>
        <a class="nav-link" asp-controller="Schedule" asp-action="Index"><i class="fas fa-calendar me-2"></i>Học vụ</a>
        <a class="nav-link" asp-controller="Finance" asp-action="Index"><i class="fas fa-money-bill me-2"></i>Học phí</a>
        <a class="nav-link" asp-controller="Support" asp-action="Index"><i class="fas fa-question-circle me-2"></i>Yêu cầu - Trợ giúp</a>
    </div>

    <div class="main-content">
        <div class="topbar d-flex justify-content-between align-items-center">
            <div><strong>@ViewData["Title"]</strong></div>
            <div>
                <partial name="_LoginPartial" />
            </div>
        </div>
        <div class="container-fluid p-4">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="text-center py-3 text-muted">
            &copy; 2025 - BlueSchoolSystem
        </footer>
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
