<style>
    /* Card */
    .card {
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid #dee2e6; /* ✅ viền ngoài */
        padding: 15px;
        background-color: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    /* Header */
    .card-header {
        background: linear-gradient(90deg, #0dcaf0, #0d9dfd);
        color: white;
        font-weight: bold;
        border-bottom: none !important;
    }

        .card-header h6 {
            color: white;
            margin: 0;
        }

    /* Custom dropdown */
    .custom-select {
        border: 1px solid #0d6efd;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 1rem;
        font-weight: 500;
        color: #0d6efd;
        background-color: #fff;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        min-width: 300px;
        height: 42px;
    }

        .custom-select:focus {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, .25);
            border-color: #0b5ed7;
        }

        .custom-select:hover {
            border-color: #0b5ed7;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.3);
        }

    /* Table */
    .table-responsive {
        max-height: 500px;
        overflow: auto;
    }

    table.table {
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
        table-layout: auto;
    }

    thead.table-primary {
        background: linear-gradient(90deg, #0d6efd, #0d9dfd) !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Sticky columns */
    th.sticky-col, td.sticky-col {
        position: sticky;
        left: 0;
        background: #f8f9fa !important;
        z-index: 3;
        font-weight: 600;
        border-right: 1px solid #dee2e6;
    }

    th.sticky-col-2, td.sticky-col-2 {
        position: sticky;
        left: 70px;
        background: #f8f9fa !important;
        z-index: 3;
        border-right: 1px solid #dee2e6;
    }

    /* Row hover & alternate */
    tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }

    tbody tr:hover {
        background-color: #eaf3ff !important;
    }

    /* STT column */
    td.sticky-col {
        text-align: center;
        font-weight: bold;
        color: #0d6efd;
    }

    /* Borders */
    .table-bordered th, .table-bordered td {
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }

    /* Căn giữa dữ liệu trong bảng */
    .table td, .table th {
        text-align: center;
        vertical-align: middle;
    }

        /* Riêng cột Tên môn học thì căn trái */
        .table td.ten-monhoc, .table th.ten-monhoc {
            text-align: left;
        }

    /* Điều chỉnh độ rộng cột */
    th.stt-col, td.stt-col {
        width: 30px;
    }

    th.ma-col, td.ma-col {
        width: 80px;
    }

    th.ten-col, td.ten-col {
        width: 200px;
    }

    /* Tabs */
    .nav-tabs-custom {
        border-bottom: 1px solid #dee2e6;
        display: flex;
        gap: 12px;
    }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: #6c757d;
            font-weight: 500;
            padding: 8px 20px;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
        }

            .nav-tabs-custom .nav-link:hover {
                color: #0d6efd;
                background-color: #f8f9fa;
            }

            .nav-tabs-custom .nav-link.active {
                background-color: #0d6efd;
                color: #fff;
                font-weight: 600;
                box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            }
</style>

<h6>Trang chủ / Học vụ / Lớp học phần</h6>
@model List<BlueSchoolSystem.Models.ViewModel.DiemDanhViewModel>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
@{
    ViewData["Title"] = "Điểm danh";
    var tongSoVang = Model.Count(x => x.TenTrangThai == "Vắng mặt");
}
<div class="card mt-3">
    <div class="card-body">
@if (!string.IsNullOrEmpty(ViewBag.TenMonHoc as string))
{
    <div class="d-flex align-items-center mb-3">
        <a href="javascript:history.back()" class="btn btn-outline-primary btn-lg me-3 rounded-circle shadow-sm">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <h4 class="mb-0">Lớp: @ViewBag.TenMonHoc</h4>
    </div>
}
else
{
    <div class="d-flex align-items-center mb-3">
        <a href="javascript:history.back()" class="btn btn-outline-primary btn-lg me-3 rounded-circle shadow-sm">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <h4 class="mb-0">Không có dữ liệu điểm danh của lớp</h4>
    </div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" id="tabDiemDanh" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="tab-thongbao" data-bs-toggle="tab" data-bs-target="#content-thongbao"
                type="button" role="tab" aria-controls="content-thongbao" aria-selected="false">
            Thông báo
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="tab-diemdanh" data-bs-toggle="tab" data-bs-target="#content-diemdanh"
                type="button" role="tab" aria-controls="content-diemdanh" aria-selected="true">
            Điểm danh
        </button>
    </li>
</ul>

<!-- Nội dung các tab -->
<div class="tab-content">
    <!-- Tab Thông báo -->
    <div class="tab-pane fade" id="content-thongbao" role="tabpanel" aria-labelledby="tab-thongbao">
        <div class="alert alert-info text-center">
            Chưa có thông báo nào!
        </div>
    </div>

    <!-- Tab Điểm danh -->
    <div class="tab-pane fade show active" id="content-diemdanh" role="tabpanel" aria-labelledby="tab-diemdanh">

        <!-- Tổng số buổi vắng -->
        <div class="mb-3">
            <strong>Tổng số buổi vắng:</strong> <span class="text-danger">@tongSoVang</span>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-warning text-center">Không có dữ liệu điểm danh.</div>
        }
        else
        {
            <div class="table-responsive" style="max-width:600px;">
                <table class="table table-bordered table-sm">
                    <thead class="table-primary">
                        <tr>
                            <th style="width: 150px;">Buổi học</th>
                            <th style="width: 120px;">Tình trạng</th>
                            <th style="width: 100px;">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>Ngày @item.Ngay.ToString("dd/MM/yyyy")</td>
                                <td>@item.TenTrangThai</td>
                                <td>
                                    @if (item.TenTrangThai == "Vắng mặt")
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>Chi tiết</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalChiTiet"
                                                data-ngay="@item.Ngay.ToString("dd/MM/yyyy HH:mm:ss")"
                                                data-ghichu="@item.GhiChu">
                                            Chi tiết
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
    </div>
</div>
<!-- Modal Chi tiết -->
<div class="modal fade" id="modalChiTiet" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết điểm danh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Phương thức</th>
                        <td id="modalGhiChu"></td>
                    </tr>
                    <tr>
                        <th>Thời gian</th>
                        <td id="modalNgay"></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modalChiTiet = document.getElementById('modalChiTiet');
        modalChiTiet.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var ngay = button.getAttribute('data-ngay');
            var ghichu = button.getAttribute('data-ghichu');

            document.getElementById('modalNgay').innerText = ngay;
            document.getElementById('modalGhiChu').innerText = ghichu;
        });
    </script>
}
