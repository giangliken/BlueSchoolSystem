<style>
    /* Card */
    .card {
        border-radius: 12px;
        overflow: hidden;
        border: 1.5px solid #dee2e6; /* ✅ viền ngoài */
        padding: 15px;
        background-color: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    /* Header */
    .card-header {
        background: linear-gradient(90deg, #0dcaf0, #0d9dfd);
        color: white;
        font-weight: bold;
        border-bottom: none !important;
    }

        .card-header h6 {
            color: white;
            margin: 0;
        }

    /* Custom dropdown */
    .custom-select {
        border: 1px solid #0d6efd;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 1rem;
        font-weight: 500;
        color: #0d6efd;
        background-color: #fff;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        min-width: 300px;
        height: 42px;
    }

        .custom-select:focus {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, .25);
            border-color: #0b5ed7;
        }

        .custom-select:hover {
            border-color: #0b5ed7;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.3);
        }

    /* Table */
    .table-responsive {
        max-height: 500px;
        overflow: auto;
    }

    table.table {
        border-radius: 8px;
        overflow: hidden;
        width: 100%;
        table-layout: auto;
    }

    thead.table-primary {
        background: linear-gradient(90deg, #0d6efd, #0d9dfd) !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Sticky columns */
    th.sticky-col, td.sticky-col {
        position: sticky;
        left: 0;
        background: #f8f9fa !important;
        z-index: 3;
        font-weight: 600;
        border-right: 1px solid #dee2e6;
    }

    th.sticky-col-2, td.sticky-col-2 {
        position: sticky;
        left: 70px;
        background: #f8f9fa !important;
        z-index: 3;
        border-right: 1px solid #dee2e6;
    }

    /* Row hover & alternate */
    tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }

    tbody tr:hover {
        background-color: #eaf3ff !important;
    }

    /* STT column */
    td.sticky-col {
        text-align: center;
        font-weight: bold;
        color: #0d6efd;
    }

    /* Borders */
    .table-bordered th, .table-bordered td {
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }

    /* Căn giữa dữ liệu trong bảng */
    .table td, .table th {
        text-align: center;
        vertical-align: middle;
    }

        /* Riêng cột Tên môn học thì căn trái */
        .table td.ten-monhoc, .table th.ten-monhoc {
            text-align: left;
        }

    /* Điều chỉnh độ rộng cột */
    th.stt-col, td.stt-col {
        width: 30px;
    }

    th.ma-col, td.ma-col {
        width: 80px;
    }

    th.ten-col, td.ten-col {
        width: 200px;
    }

    /* Tabs */
    .nav-tabs-custom {
        border-bottom: 1px solid #dee2e6;
        display: flex;
        gap: 12px;
    }

        .nav-tabs-custom .nav-link {
            border: none;
            background: transparent;
            color: #6c757d;
            font-weight: 500;
            padding: 8px 20px;
            border-radius: 6px;
            transition: all 0.2s ease-in-out;
        }

            .nav-tabs-custom .nav-link:hover {
                color: #0d6efd;
                background-color: #f8f9fa;
            }

            .nav-tabs-custom .nav-link.active {
                background-color: #0d6efd;
                color: #fff;
                font-weight: 600;
                box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            }
    /* Tùy chỉnh modal chi tiết */
    #modalViTri {
        line-height: 1.5;
    }

        #modalViTri a {
            color: #0d6efd;
            text-decoration: none;
        }

            #modalViTri a:hover {
                text-decoration: underline;
            }

</style>
@model List<BlueSchoolSystem.Models.ViewModel.DiemDanhViewModel>
@{
    ViewData["Title"] = "Điểm danh";
    var tongSoBuoi = Model.Count;
    var tongVang = Model.Count(x => x.TrangThai == "Vắng mặt");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<h6>Trang chủ / Học vụ / Lớp học phần</h6>

<div class="card mt-3">
    <div class="card-body">
        <button class="btn btn-dark fw-semibold mb-2" data-bs-toggle="modal" data-bs-target="#modalGroupChat">
            <i class="fa-solid fa-comments me-2"></i> Nhóm chat lớp học phần
        </button>

        <div class="modal fade" id="modalGroupChat" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Nhóm chat - @ViewBag.TenMonHoc</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-0">
                        <div id="chat-messages" style="height:400px;overflow-y:auto;padding:1rem;background:#f6f7f9"></div>
                    </div>
                    <div class="modal-footer">
                        <input type="text" id="chatInput" class="form-control" autocomplete="off" placeholder="Nhập tin nhắn..." style="flex:1;max-width:80%">
                        <button type="button" id="btnSendChat" class="btn btn-primary ms-2">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Header -->
        <div class="d-flex align-items-center mb-3">
            <a href="javascript:history.back()" class="btn btn-outline-primary btn-lg me-3 rounded-circle shadow-sm">
                <i class="bi bi-arrow-left fs-4"></i>
            </a>
            <h4 class="mb-0">
                @if (!string.IsNullOrEmpty(ViewBag.TenMonHoc as string))
                {
                    @($"Lớp: {ViewBag.TenMonHoc}")
                }
                else
                {
                    <span class="text-danger">Không có buổi điểm danh</span>
                }
            </h4>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3 nav-tabs-custom" id="tabDiemDanh" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="tab-diemdanh" data-bs-toggle="tab" data-bs-target="#content-diemdanh">
                    Điểm danh
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="tab-thongbao" data-bs-toggle="tab" data-bs-target="#content-thongbao">
                    Thông báo
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Tab Điểm danh -->
            <div class="tab-pane fade show active" id="content-diemdanh">
                <div class="mb-3">
                    <strong>Tổng số buổi:</strong> <span class="text-primary">@tongSoBuoi</span> |
                    <strong>Vắng:</strong> <span class="text-danger">@tongVang</span>
                </div>

                @if (!Model.Any())
                {
                    <div class="alert alert-warning text-center">Không có dữ liệu điểm danh.</div>
                }
                else
                {
                    <div class="table-responsive" style="max-width:600px;">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-primary">
                                <tr>
                                    <th>Ngày buổi điểm danh</th>
                                    <th>Trạng thái</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var icon = item.TrangThai switch
                                    {
                                        "Có mặt" => "<i class='bi bi-check-circle-fill text-success'></i>",
                                        "Vắng mặt" => "<i class='bi bi-x-circle-fill text-danger'></i>",
                                        _ => "<i class='bi bi-question-circle text-secondary'></i>"
                                    };

                                    <tr>
                                        <td>@item.Ngay.ToString("dd/MM/yyyy") </td>
                                        <td>@Html.Raw(icon) @item.TrangThai</td>
                                        <td>
                                            <button class="btn btn-primary btn-sm"
                                                    @(item.TrangThai != "Có mặt" ? "disabled" : "")
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalChiTiet"
                                                    data-ngay="@item.Ngay.ToString("dd/MM/yyyy")"
                                                    data-thoigian="@item.ThoiGian?.ToString("HH:mm dd/MM/yyyy ")"
                                                    data-lat="@(item.Latitude.HasValue? item.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                    data-lon="@(item.Longitude.HasValue? item.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                                    data-ghichu="@item.GhiChuChiTiet">
                                                Xem
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Tab Thông báo -->
            <div class="tab-pane fade" id="content-thongbao">
                <div class="alert alert-info text-center">
                    Chưa có thông báo nào!
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chi tiết -->
<div class="modal fade" id="modalChiTiet" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Chi tiết điểm danh</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 150px; white-space: nowrap;">Phương thức</th>
                        <td id="modalGhiChu"></td>
                    </tr>
                    <tr>
                        <th style="white-space: nowrap;">Thời gian</th>
                        <td id="modalNgayGio"></td>
                    </tr>
                    <tr>
                        <th style="white-space: nowrap;">Vị trí</th>
                        <td id="modalViTri"></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

    <!-- expose token (giống GV) -->
    <script>
        window.__accessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (ViewBag.AccessToken ?? Context.Session.GetString("access_token") ?? "")
            ));
</script>

    <!-- JWT helpers -->
    <script>
        function b64uToBytes(s){
            s = s.replace(/-/g, '+').replace(/_/g, '/');
            while (s.length % 4) s += '=';
            const bin = atob(s);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            return bytes;
        }

        function parseJwt(t){
            if(!t) return null;
            if(t.startsWith('Bearer ')) t = t.slice(7);
            const p = t.split('.');
            if (p.length < 2) return null;
            try{
              const json = new TextDecoder('utf-8').decode(b64uToBytes(p[1]));
              return JSON.parse(json);
            }catch(e){
              console.error('parseJwt error', e);
              return null;
            }
        }


        const payload  = parseJwt(window.__accessToken) || {};
        const userId   = payload.userId || "";                
        const username = payload.username || "";    
        const fullname = payload.fullname || "";
        const email    = payload.email || "";
        const roleRaw  = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || "";

    </script>

    <script>
        const firebaseConfig = {
          apiKey: "AIzaSyD2Uh_6wINLjM99TZ64cIdR330cWPrJ3ws",
          authDomain: "bluenet-e6525.firebaseapp.com",
          databaseURL: "https://bluenet-e6525-default-rtdb.firebaseio.com",
          projectId: "bluenet-e6525",
          storageBucket: "bluenet-e6525.firebasestorage.app",
          messagingSenderId: "682840647075",
          appId: "1:682840647075:web:ed799955c38a40f2526616",
          measurementId: "G-RXWF28P678"
        };
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);

        function ready(fn){ if (document.readyState!=='loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }
        function formatTime(ts){ return new Date(ts||Date.now()).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}); }

        const roleMap = { "Student":"Sinh viên", "Teacher":"Giảng viên", "Admin":"Quản trị" };
        const userRole = roleMap[roleRaw] || roleRaw || "Sinh viên"; 

        ready(function () {
          // Lấy mã học phần từ ViewBag
          const maLopHocPhan = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaLopHocPhan ?? ""));
          // nếu vì lý do gì ViewBag rỗng, fallback querystring:
          const maLopFromQs = new URLSearchParams(location.search).get('maLopHocPhan') || "";
          const roomKey = maLopHocPhan || maLopFromQs;

          // Dùng tên hiển thị: ưu tiên username, fallback email
        const displayName = fullname
          ? (username ? `${fullname} (${username})` : fullname)
          : (username || "Người dùng");
          // Kiểm tra token hết hạn (nếu muốn chặn gửi)
          const nowSec = Math.floor(Date.now()/1000);
          const expired = typeof payload.exp === "number" && payload.exp <= nowSec;

          const btn   = document.getElementById('btnSendChat');
          const input = document.getElementById('chatInput');
          const box   = document.getElementById('chat-messages');

          if (!btn) return;

          function send(content){
            if (!roomKey){ alert('Thiếu mã lớp (maLopHocPhan).'); return; }
            if (!userId){ alert('Token không có userId.'); return; }
            if (expired){ alert('Phiên đăng nhập đã hết hạn, vui lòng đăng nhập lại để gửi tin nhắn.'); return; }
            if (!content?.trim()){ input?.focus(); return; }

            const ref = firebase.database().ref('chats/'+ roomKey +'/messages');
            ref.push({
              senderId:   userId,       
              senderName: displayName,  
              role:       userRole,     
              content:    content.trim(),
              createdAt:  Date.now()
            })
            .then(()=>{ if (input) input.value=''; })
            .catch(e=>{ alert('Lỗi gửi: ' + (e?.message || 'Unknown')); console.error(e); });
          }

          // Gửi bằng nút
          btn.addEventListener('click', function(){
            send(input?.value || "");
          });
          // Gửi bằng Enter
          input?.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(input.value); }
          });

          function renderMsg(m){
            const mine = m.senderId === userId;
            const time = formatTime(m.createdAt);
            if (mine){
              box.innerHTML += `
                <div class="text-end mb-2">
                  <div class="d-inline-block px-3 py-2 rounded-3 shadow-sm" style="background:#2f80ff;color:#fff;max-width:70%;">
                    ${ (m.content||'').replace(/\n/g,'<br>') }
                    <div class="small text-end" style="opacity:.85;margin-top:2px;">${time}</div>
                  </div>
                </div>`;
            } else {
              box.innerHTML += `
                <div class="text-start mb-2">
                  <div class="d-inline-block px-3 py-2 rounded-3 shadow-sm" style="background:#2f80ff;color:#fff;max-width:70%;">
                    <div style="font-weight:700;color:#fff;">
                      ${m.senderName||'Người dùng'}
                      ${ m.role ? `<span class="ms-2" style="font-weight:500;background:#1f2937;color:#93c5fd;border-radius:999px;padding:2px 8px;font-size:.75rem;">${m.role}</span>` : '' }
                    </div>
                    <div>${ (m.content||'').replace(/\n/g,'<br>') }</div>
                    <div class="small" style="opacity:.85;margin-top:2px;">${time}</div>
                  </div>
                </div>`;
            }
            box.scrollTop = box.scrollHeight;
          }

          // Lắng nghe tin mới
          if (roomKey){
            const ref = firebase.database().ref('chats/'+ roomKey +'/messages');
            ref.limitToLast(100).on('child_added', s => { const m = s.val(); if (m) renderMsg(m); });
          } else {
            console.warn('Không có maLopHocPhan để join phòng chat.');
          }
        });

    </script>
}

