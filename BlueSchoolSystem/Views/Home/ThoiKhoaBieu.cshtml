@model IEnumerable<BlueSchoolSystem.Models.ViewModel.ThoiKhoaBieuViewModel>

<div id="calendar"></div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales-all.global.min.js"></script>

<style>
    .tooltip-inner {
        white-space: normal !important; /* Cho phép xuống dòng */
        text-align: left;
        max-width: 350px; /* Giới hạn rộng để text gọn */
        font-size: 0.9rem;
        line-height: 1.4;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var calendarEl = document.getElementById('calendar');

        var calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'vi',
            height: 700,
            slotMinTime: "07:00:00",
            slotMaxTime: "21:00:00",
            expandRows: true,
            allDaySlot: false,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            buttonText: {
                today: 'Hôm nay',
                month: 'Tháng',
                week: 'Tuần',
                day: 'Ngày'
            },
                events: [
    @foreach (var item in Model)
    {
        <text>
                {
                    title: '@item.TenLopHocPhan - P.@item.MaPhongHoc',
                    daysOfWeek: [@item.Thu], // 1=Thứ 2, 2=Thứ 3...
                    startTime: '@item.GioBatDau',
                    endTime: '@item.GioKetThuc',
                    startRecur: '@item.NgayBatDau.ToString("yyyy-MM-dd")',
                    endRecur: '@item.NgayKetThuc.ToString("yyyy-MM-dd")',
                    extendedProps: {
                        tenLopHocPhan: '@item.TenLopHocPhan',
                        tenMonHoc: '@item.TenMonHoc',
                        tenGiangVien: '@item.TenGiangVien',
                        maPhongHoc: '@item.MaPhongHoc',
                        thu: '@item.Thu',
                        gioBatDau: '@item.GioBatDau',
                        gioKetThuc: '@item.GioKetThuc'
                    }
                },
        </text>
    }
    ],
            eventDidMount: function (info) {
                var p = info.event.extendedProps;
                var tooltipContent = `
                    <b>Lớp HP:</b> ${p.tenLopHocPhan}<br/>
                    <b>Môn:</b> ${p.tenMonHoc}<br/>
                    <b>GV:</b> ${p.tenGiangVien}<br/>
                    <b>Phòng:</b> ${p.maPhongHoc}<br/>
                    <b>Thứ:</b> ${p.thu}<br/>
                    <b>Thời gian:</b> ${p.gioBatDau} - ${p.gioKetThuc}<br/>
                `;

                new bootstrap.Tooltip(info.el, {
                    title: tooltipContent,
                    html: true,
                    placement: 'top',
                    trigger: 'hover',
                    container: 'body'
                });
            }
        });

        calendar.render();
    });
</script>
