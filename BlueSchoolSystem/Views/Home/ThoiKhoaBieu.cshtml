@model IEnumerable<BlueSchoolSystem.Models.ViewModel.ThoiKhoaBieuViewModel>

@{
    var tietStart = new Dictionary<int, string> {
        {1,"06:45"},{2,"07:30"},{3,"08:15"},
        {4,"09:20"},{5,"10:05"},{6,"10:50"},
        {7,"12:30"},{8,"13:10"},{9,"14:00"},
        {10,"15:05"},{11,"15:50"},{12,"16:35"},
        {13,"18:00"},{14,"18:45"},{15,"19:30"}
    };
    var tietEnd = new Dictionary<int, string> {
        {1,"07:30"},{2,"08:15"},{3,"09:00"},
        {4,"10:05"},{5,"10:50"},{6,"11:35"},
        {7,"13:15"},{8,"13:55"},{9,"14:45"},
        {10,"15:50"},{11,"16:35"},{12,"17:20"},
        {13,"18:45"},{14,"19:30"},{15,"20:15"}
    };

    int ToTiet(string? gio)
    {
        if (string.IsNullOrEmpty(gio)) return 0;
        var hm = TimeSpan.Parse(gio);
        if (hm < TimeSpan.Parse("07:30")) return 1;
        if (hm <= TimeSpan.Parse("08:15")) return 2;
        if (hm <= TimeSpan.Parse("09:00")) return 3;
        if (hm <= TimeSpan.Parse("10:05")) return 4;
        if (hm <= TimeSpan.Parse("10:50")) return 5;
        if (hm <= TimeSpan.Parse("11:35")) return 6;
        if (hm <= TimeSpan.Parse("13:15")) return 7;
        if (hm <= TimeSpan.Parse("13:55")) return 8;
        if (hm <= TimeSpan.Parse("14:45")) return 9;
        if (hm <= TimeSpan.Parse("15:50")) return 10;
        if (hm <= TimeSpan.Parse("16:35")) return 11;
        if (hm <= TimeSpan.Parse("17:20")) return 12;
        if (hm <= TimeSpan.Parse("18:45")) return 13;
        if (hm <= TimeSpan.Parse("19:30")) return 14;
        return 15;
    }

    var monHocTheoThu = Model.Select(x => new
    {
        x.MaMonHoc,
        x.TenMonHoc,
        x.TenGiangVien,
        x.MaPhongHoc,
        x.Thu,
        StartTiet = ToTiet(x.GioBatDau),
        EndTiet = ToTiet(x.GioKetThuc),
        x.GioBatDau,
        x.GioKetThuc,
        x.NgayBatDau,
        x.NgayKetThuc
    }).ToList();
}

<style>
    table.tkb {
        border-collapse: collapse;
        width: 100%;
        text-align: center;
    }

        table.tkb th,
        table.tkb td {
            border: 1px solid #999;
            width: 60px;
            height: 30px;
            padding: 0;
            vertical-align: middle;
            text-align: center;
        }

        table.tkb th {
            background: #007bff;
            color: #fff;
        }

            table.tkb th.tiet-col,
            table.tkb td.tiet-col {
                background: #007bff;
                color: #fff;
                font-weight: bold;
            }

    /* Khung tooltip */
    .lop {
        background: #dff0d8;
        height: 100%;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 13px;
        font-weight: bold;
        color: #007bff;
        padding: 6px;
        cursor: pointer;
        position: relative;
    }

        /* Nội dung tooltip */
        .lop .tooltiptext {
            visibility: hidden;
            width: 220px;
            background-color: #6c757d;
            color: #fff;
            text-align: left;
            border-radius: 6px;
            padding: 8px;
            position: absolute;
            z-index: 1;
            bottom: 120%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0;
            transition: opacity 0.3s;
            font-size: 12px;
            line-height: 1.4;
        }

            .lop .tooltiptext::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #6c757d transparent transparent transparent;
            }

        .lop:hover .tooltiptext {
            visibility: visible;
            opacity: 1;
        }

    #weekSelect {
        width: 200px;
        font-size: 14px;
        padding: 4px;
    }

        /* Giới hạn khi bấm xổ xuống */
        #weekSelect option {
            padding: 4px 6px;
        }

    #weekSelect {
        max-height: 6em; /* cao khoảng 4 dòng */
        overflow-y: auto; /* bật thanh cuộn */
    }

        /* Nếu muốn hiển thị như danh sách có cuộn */
        #weekSelect[multiple],
        #weekSelect[size] {
            height: 120px; /* 👈 cố định chiều cao */
            overflow-y: auto; /* 👈 có thanh cuộn dọc */
        }

    .btn-group .btn,
    #weekSelect {
        font-size: 13px;
        padding: 4px 8px;
    }
</style>


@{
    var today = DateTime.Today;

    // Tuần (có offset)
    var monday = today.AddDays(-(int)today.DayOfWeek + 1);
    if (monday.DayOfWeek == DayOfWeek.Sunday) monday = monday.AddDays(-6);
    monday = monday.AddDays(7 * (int)ViewBag.WeekOffset);

    var weekDays = Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
    var startOfWeek = weekDays.First().Date;
    var endOfWeek = weekDays.Last().Date;

    var monHocTrongTuan = monHocTheoThu
        .Where(x => x.NgayKetThuc.Date >= startOfWeek
                 && x.NgayBatDau.Date <= endOfWeek)
        .ToList();

    // Tháng (có offset)
    var monthDate = new DateTime(today.Year, today.Month, 1).AddMonths((int)ViewBag.MonthOffset);
    int month = monthDate.Month;
    int year = monthDate.Year;
    int daysInMonth = DateTime.DaysInMonth(year, month);

    var monHocTrongThang = Model
        .Where(x => x.NgayKetThuc.Date >= new DateTime(year, month, 1)
                 && x.NgayBatDau.Date <= new DateTime(year, month, daysInMonth))
        .ToList();



    var ngayBatDauHocKy = Model.Min(x => x.NgayBatDau.Date);
    var ngayKetThucHocKy = Model.Max(x => x.NgayKetThuc.Date);

    int soTuan = 0;
    int currentSoTuan = 0;   // 👈 thêm biến này
    var weekList = new List<(int SoTuan, DateTime Start, DateTime End)>();

    for (var start = ngayBatDauHocKy; start <= ngayKetThucHocKy; start = start.AddDays(7))
    {
        var end = start.AddDays(6);

        bool coMon = Model.Any(x =>
            x.NgayBatDau.Date <= end &&
            x.NgayKetThuc.Date >= start);

        if (coMon)
        {
            soTuan++;

            // kiểm tra tuần hiện tại (theo ViewBag.WeekOffset)
            var mondayOfOffset = ngayBatDauHocKy.AddDays((int)ViewBag.WeekOffset * 7);
            if (mondayOfOffset >= start && mondayOfOffset <= end)
            {
                currentSoTuan = soTuan;
            }

            weekList.Add((soTuan -1, start, end));
        }
    }

    ViewBag.WeekList = weekList;
    ViewBag.SoTuan = currentSoTuan;


    // chọn tháng
    int selectedMonth = ViewBag.Thang != null ? (int)ViewBag.Thang : month;
}

<h6 class="mb-3">Trang chủ/Học vụ/Thời khóa biểu</h6>

<div class="d-flex align-items-center gap-2 mb-3">

    <!-- Nút chuyển chế độ -->
    <button id="btnToggle" class="btn btn-secondary btn-sm" onclick="toggleView()">Xem lịch tháng</button>

    <!-- Nút lùi tuần/tháng -->
    <button class="btn btn-outline-primary btn-sm" onclick="navigate('prev')">←</button>

    <!-- Combobox chọn tuần -->
    <select id="weekSelect" onchange="goToWeek(this.value)" class="form-select form-select-sm"
            style="width: 220px; display:inline-block;">
        @foreach (var w in (List<(int SoTuan, DateTime Start, DateTime End)>)ViewBag.WeekList)
        {
            <option value="@w.SoTuan" selected="@(w.SoTuan == ViewBag.SoTuan)">
                Tuần @(w.SoTuan + 1) (@w.Start.ToString("dd/MM") - @w.End.ToString("dd/MM"))
            </option>
        }
    </select>

    <!-- Combobox chọn tháng -->
    <select id="monthSelect" onchange="goToMonth(this.value)" class="form-select form-select-sm"
            style="width: 160px; display:none;">
        @for (int m = 1; m <= 12; m++)
        {
            if (m == selectedMonth)
            {
                <option value="@m" selected>Tháng @m</option>
            }
            else
            {
                <option value="@m">Tháng @m</option>
            }
        }
    </select>

    <!-- Nút tiến tuần/tháng -->
    <button class="btn btn-outline-primary btn-sm" onclick="navigate('next')">→</button>

    <!-- Nút Tuần hiện tại -->
    <button id="btnCurrentWeek" class="btn btn-primary btn-sm" onclick="goToCurrentWeek()">
        Tuần hiện tại
    </button>
    <!-- Nút chuyển về tháng hiện tại -->
    <button id="btnCurrentMonth" class="btn btn-primary btn-sm" style="display:none;" onclick="goToCurrentMonth()">
        Tháng hiện tại
    </button>
</div>

<!-- Lịch tuần -->
<div id="lichTuan">
    <table class="tkb">
        <thead>
            <tr>
                <th class="tiet-col" style="width:60px; vertical-align: middle;" rowspan="2">Tiết</th>
                @for (int i = 0; i < weekDays.Count; i++)
                {
                    <th>
                        <div style="display:flex; flex-direction:column; align-items:center;">
                            <span>
                                @((i + 2 > 7) ? "Chủ nhật" : "Thứ " + (i + 2))
                            </span>
                            <span>@weekDays[i].ToString("dd/MM/yyyy")</span>
                        </div>
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int tiet = 1; tiet <= 15; tiet++)
            {
                <tr>
                    <td class="tiet-col" title="Tiết @tiet (từ @tietStart[tiet] đến @tietEnd[tiet])">
                        Tiết @tiet
                    </td>

                    @for (int thu = 2; thu <= 8; thu++)
                    {
                        // Tính ngày của buổi học dựa trên thứ và tuần đang xem
                        // Thứ trong weekDays: index0=Thứ2, index1=Thứ3, ... index6=ChủNhật
                        var ngayHoc = weekDays[thu - 2]; // Vì 'thu' bắt đầu từ 2 (Thứ 2)

                        // Tìm lớp học phù hợp:
                        // 1. Cùng thứ
                        // 2. Tiết học trùng khớp
                        // 3. Ngày học tính được phải nằm trong khoảng từ NgayBatDau đến NgayKetThuc của lớp

                        var lop = monHocTrongTuan.FirstOrDefault(x =>
                        x.Thu == thu &&
                        x.StartTiet == tiet &&
                        ngayHoc >= x.NgayBatDau.Date &&
                        ngayHoc <= x.NgayKetThuc.Date
                        );

                        if (lop != null)
                        {
                            var soTiet = lop.EndTiet - lop.StartTiet + 1;
                            <td rowspan="@soTiet">
                                <div class="lop">
                                    @lop.TenMonHoc<br>
                                    Phòng: @lop.MaPhongHoc
                                    <span class="tooltiptext">
                                        <b>Mã môn:</b> @lop.MaMonHoc <br />
                                        <b>Tên môn:</b> @lop.TenMonHoc <br />
                                        <b>Phòng:</b> @lop.MaPhongHoc <br />
                                        <b>Thứ:</b> @lop.Thu <br />
                                        <b>Thời gian:</b> @(TimeSpan.Parse(lop.GioBatDau).ToString(@"hh\:mm")) - @(TimeSpan.Parse(lop.GioKetThuc).ToString(@"hh\:mm")) <br />
                                        <b>Giảng viên:</b> @lop.TenGiangVien <br />
                                    </span>
                                </div>
                            </td>
                        }
                        else
                        {
                            // Kiểm tra xem có lớp nào đang chiếm tiết này hay không (rowspan)
                            var lopDangChiem = monHocTrongTuan.Any(x => x.Thu == thu && x.StartTiet < tiet && x.EndTiet >= tiet);
                            if (!lopDangChiem)
                            {
                                <td></td>
                            }
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Lịch tháng -->
<div id="lichThang" style="display:none;">
    <table class="tkb">
        <thead>
            <tr>
                <th>Thứ 2</th>
                <th>Thứ 3</th>
                <th>Thứ 4</th>
                <th>Thứ 5</th>
                <th>Thứ 6</th>
                <th>Thứ 7</th>
                <th>CN</th>
            </tr>
        </thead>
        <tbody>
            @{
                var firstDay = new DateTime(year, month, 1);
                // Cột đầu tiên là thứ 2 -> lùi về thứ 2 gần nhất
                int diff = ((int)firstDay.DayOfWeek + 6) % 7;
                var startOfMonthGrid = firstDay.AddDays(-diff);

                int totalDays = diff + daysInMonth;
                int totalWeeks = (int)Math.Ceiling(totalDays / 7.0);

                for (int week = 0; week < totalWeeks; week++)
                {
                    <tr>
                        @for (int day = 0; day < 7; day++)
                        {
                            var currentDay = startOfMonthGrid.AddDays(week * 7 + day);
                            var isOtherMonth = currentDay.Month != month;

                            <td style="height:100px; vertical-align:top; font-size:12px; @(isOtherMonth ? "background:#f8f9fa;" : "")">
                                <div><b>@currentDay.Day</b></div>

                                @foreach (var lop in monHocTrongThang)
                                {
                                    // Map Thu (2..8) sang DayOfWeek: Monday=1, ... Sunday=0
                                    var lopDayOfWeek = lop.Thu == 8 ? DayOfWeek.Sunday : (DayOfWeek)(lop.Thu - 2 + 1);

                                    if (currentDay.Date >= lop.NgayBatDau.Date
                                    && currentDay.Date <= lop.NgayKetThuc.Date
                                    && currentDay.DayOfWeek == lopDayOfWeek)
                                    {
                                        <div style="background:#dff0d8; margin:2px; padding:2px; border-radius:4px; font-size:11px;">
                                            @lop.TenMonHoc <br />
                                            P.@lop.MaPhongHoc
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    // Lấy offset tuần và tháng từ query string
    const urlParams = new URLSearchParams(window.location.search);
    let weekOffset = parseInt(urlParams.get("weekOffset") || 0);
    let monthOffset = parseInt(urlParams.get("monthOffset") || 0);

    function goToWeek(soTuan) {
        let weekIndex = parseInt(soTuan) - 1;
        window.location.href = `?weekOffset=${weekIndex}&monthOffset=${monthOffset}&viewMode=week`;
    }

    function goToCurrentWeek() {
        // redirect tới tuần hiện tại
        window.location.href = `?week=@(ViewBag.SoTuanHienTai ?? 1)&viewMode=week`;
    }
    // Giá trị tháng đang hiển thị (biến server-side nhúng vào JS)
    const currentDisplayedMonth = @month;

    function goToMonth(selectedMonth) {
        // selectedMonth là 1..12 (string) -> chuyển về số
        const m = parseInt(selectedMonth, 10);

        // delta so với tháng đang hiển thị
        const delta = m - currentDisplayedMonth;

        // cập nhật monthOffset và điều hướng
        const newMonthOffset = monthOffset + delta;
        window.location.href = `?weekOffset=${weekOffset}&monthOffset=${newMonthOffset}&viewMode=month`;
    }
        function goToCurrentMonth() {
        // Reset monthOffset = 0 => quay về tháng hiện tại
        window.location.href = `?weekOffset=${weekOffset}&monthOffset=0&viewMode=month`;
    }
    function updateLabel() {
        var tuan = document.getElementById("lichTuan").style.display !== "none";
        var label = document.getElementById("currentLabel");

        if (tuan) {
            const soTuan = @(ViewBag.SoTuan ?? 0);

            // Tính monday và sunday theo weekOffset
            const today = new Date();
            const monday = new Date(today);
            monday.setDate(today.getDate() - today.getDay() + 1 + weekOffset * 7);
            const sunday = new Date(monday);
            sunday.setDate(monday.getDate() + 6);

            if (soTuan > 0) {
                label.innerText = `Tuần ${soTuan} (${monday.toLocaleDateString()} - ${sunday.toLocaleDateString()})`;
            } else {
                label.innerText = `Không có môn trong tuần này (${monday.toLocaleDateString()} - ${sunday.toLocaleDateString()})`;
            }
        } else {
            const month = new Date(new Date().getFullYear(), new Date().getMonth() + monthOffset, 1);
            const year = month.getFullYear();
            const monthName = month.toLocaleString('default', { month: 'long' });

            label.innerText = `Tháng: ${monthName} / ${year}`;
        }
    }

    function toggleView() {
        var tuan = document.getElementById("lichTuan");
    var thang = document.getElementById("lichThang");
    var btn = document.getElementById("btnToggle");
    var weekSelect = document.getElementById("weekSelect");
    var monthSelect = document.getElementById("monthSelect");
    var btnCurrentWeek = document.getElementById("btnCurrentWeek");
    var btnCurrentMonth = document.getElementById("btnCurrentMonth");

    if (tuan.style.display === "none") {
        // Đang xem tháng -> chuyển sang tuần
        tuan.style.display = "block";
        thang.style.display = "none";
        weekSelect.style.display = "inline-block";
        monthSelect.style.display = "none";
        btnCurrentWeek.style.display = "inline-block";
        btnCurrentMonth.style.display = "none";
        btn.innerText = "Xem lịch tháng";
    } else {
        // Đang xem tuần -> chuyển sang tháng
        tuan.style.display = "none";
        thang.style.display = "block";
        weekSelect.style.display = "none";
        monthSelect.style.display = "inline-block";
        btnCurrentWeek.style.display = "none";
        btnCurrentMonth.style.display = "inline-block";
        btn.innerText = "Xem lịch tuần";
    }

        updateLabel();
    }

    function navigate(action) {
        let viewMode = (document.getElementById("lichTuan").style.display !== "none") ? "week" : "month";

        if (viewMode === "week") {
            if (action === "prev") weekOffset--;
            if (action === "next") weekOffset++;
            if (action === "today") weekOffset = 0;
        } else {
            if (action === "prev") monthOffset--;
            if (action === "next") monthOffset++;
            if (action === "today") monthOffset = 0;
        }

        window.location.href = `?weekOffset=${weekOffset}&monthOffset=${monthOffset}&viewMode=${viewMode}`;
    }

        window.onload = function () {
        var tuan = document.getElementById("lichTuan");
        var thang = document.getElementById("lichThang");
        var btn = document.getElementById("btnToggle");
        var weekSelect = document.getElementById("weekSelect");
        var monthSelect = document.getElementById("monthSelect");
        var btnCurrentWeek = document.getElementById("btnCurrentWeek");
        var btnCurrentMonth = document.getElementById("btnCurrentMonth"); // 👈 thêm

        if ("@ViewBag.ViewMode" === "month") {
            tuan.style.display = "none";
            thang.style.display = "block";
            weekSelect.style.display = "none";
            monthSelect.style.display = "inline-block";
            btnCurrentWeek.style.display = "none";
            btnCurrentMonth.style.display = "inline-block"; // 👈 bật lại nút tháng hiện tại
            btn.innerText = "Xem lịch tuần";
        } else {
            tuan.style.display = "block";
            thang.style.display = "none";
            weekSelect.style.display = "inline-block";
            monthSelect.style.display = "none";
            btnCurrentWeek.style.display = "inline-block";
            btnCurrentMonth.style.display = "none"; // 👈 ẩn đi khi ở tuần
            btn.innerText = "Xem lịch tháng";
        }

        updateLabel();
    }
</script>
