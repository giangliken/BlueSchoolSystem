<style>
    /* Card */ .card {
        border-radius: 12px;
        overflow: hidden;
    }
    /* Header */

    .card-header {
        background: linear-gradient(90deg, #0dcaf0, #0d9dfd);
        color: white;
        font-weight: bold;
        border-bottom: none !important;
    }

        .card-header h6 {
            color: white;
            margin: 0;
        }
    /* Custom dropdown */

    .custom-select {
        border: 1px solid #0d6efd;
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 1rem;
        font-weight: 500;
        color: #0d6efd;
        background-color: #fff;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        min-width: 300px; /* ✅ nhỏ lại */
        height: 42px; /* ✅ vừa phải hơn */
    }

        .custom-select:focus {
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, .25);
            border-color: #0b5ed7;
        }

        .custom-select:hover {
            border-color: #0b5ed7;
            box-shadow: 0 0 6px rgba(13, 110, 253, 0.3);
        }
    /* Table */

    .table-responsive {
        max-height: 500px;
        overflow: auto;
    }

    table.table {
        border-radius: 8px;
        overflow: hidden;
        width: 100%; /* bảng full khung cha */
        table-layout: auto; /* tự căn theo nội dung */
    }

    thead.table-primary {
        background: linear-gradient(90deg, #0d6efd, #0d9dfd) !important;
        color: #fff !important;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    /* Sticky columns */

    th.sticky-col, td.sticky-col {
        position: sticky;
        left: 0;
        background: #f8f9fa !important;
        z-index: 3;
        font-weight: 600;
        border-right: 1px solid #dee2e6;
    }

    th.sticky-col-2, td.sticky-col-2 {
        position: sticky;
        left: 70px; /* chiều rộng STT */
        background: #f8f9fa !important;
        z-index: 3;
        border-right: 1px solid #dee2e6;
    }
    /* Row hover & alternate */

    tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }

    tbody tr:hover {
        background-color: #eaf3ff !important;
    }
    /* STT column */

    td.sticky-col {
        text-align: center;
        font-weight: bold;
        color: #0d6efd;
    }
    /* Borders */

    .table-bordered th, .table-bordered td {
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }
</style>
@model IEnumerable<BlueSchoolSystem.Models.ViewModel.DiemMonHocViewModel>
@using BlueSchoolSystem.Models.ViewModel

@{
    var hocKySelected = ViewBag.HocKySelected as int? ?? 0;
    var diemTatCa = ViewBag.DiemTatCaHocKy as IEnumerable<dynamic>; // mỗi item chứa: TenHocKy, Diems, DiemTBHocKy, DiemTBTichLuy, TinChiDat, TongTinChiTichLuy
}

<h6>Trang chủ / Học vụ / Xem điểm</h6>
<div class="card shadow-sm">
    <div class="card-body">

        <!-- Tabs -->
        <ul class="nav nav-tabs mb-3" id="diemTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tatca-tab" data-bs-toggle="tab" data-bs-target="#tatca" type="button" role="tab">Tất cả</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tichluy-tab" data-bs-toggle="tab" data-bs-target="#tichluy" type="button" role="tab">Tích lũy</button>
            </li>
        </ul>

        <div class="tab-content" id="diemTabContent">
            <!-- Tab Tất cả -->
            <div class="tab-pane fade show active" id="tatca" role="tabpanel">

                <!-- Bộ lọc chọn học kỳ -->
                <form method="get" asp-action="XemDiem" class="row g-3 mb-3">
                    <div class="col-md-4">
                        @Html.DropDownList(
                                 "hocKy",
                                 (SelectList)ViewBag.HocKyList,
                                 new { @class = "custom-select", onchange = "this.form.submit();" }
                                 )
                    </div>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                else if ((Model == null || !Model.Any()) && (diemTatCa == null || !diemTatCa.Any()))
                {
                    <div class="alert alert-warning">Chưa có điểm.</div>
                }
                else
                {
                    @* Nếu chọn "Tất cả" *@
                    if (hocKySelected == 0 && diemTatCa != null)
                    {
                        foreach (var hk in diemTatCa)
                        {
                            <h6 class="bg-primary text-white p-2">@hk.TenHocKy</h6>

                            <table class="table table-bordered mb-3">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;">STT</th>
                                        <th style="width:40px;">Mã học phần</th>
                                        <th style="width:140px;">Tên học phần</th>
                                        <th style="width:50px;">STC</th>
                                        <th style="width:80px;">Điểm quá trình</th>
                                        <th style="width:50px;">Điểm thi</th>
                                        <th style="width:60px;">Điểm hệ 10</th>
                                        <th style="width:60px;">Điểm hệ 4</th>
                                        <th style="width:60px;">Điểm chữ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 1;
                                        foreach (var d in hk.Diems)
                                        {
                                            <tr>
                                                <td>@stt</td>
                                                <td>@d.MaMonHoc</td>
                                                <td>@d.TenMonHoc</td>
                                                <td>@d.SoTinChi</td>
                                                <td>@(d.DiemChuyenCan)</td>
                                                <td>@(d.DiemCuoiKy)</td>
                                                <td>@(d.DiemTongKet)</td>
                                                <td>@(d.DiemHe4)</td>
                                                <td>@(d.DiemChu)</td>
                                            </tr>
                                            stt++;
                                        }
                                    }
                                </tbody>
                            </table>

                            <div class="mb-4">
                                <p><strong>Điểm trung bình học kỳ (hệ 4):</strong> @((hk.DiemTBHocKy ?? 0).ToString("0.00"))</p>
                                <p><strong>Điểm trung bình tích lũy (hệ 4):</strong> @((hk.DiemTBTichLuy ?? 0).ToString("0.00"))</p>
                                <p><strong>Số tín chỉ đạt:</strong> @(hk.TinChiDat ?? 0)</p>
                                <p><strong>Tổng tín chỉ tích lũy:</strong> @(hk.TongTinChiTichLuy ?? 0)</p>
                            </div>
                        }
                    }
                    else
                    {
                        @* Nếu chọn 1 học kỳ *@
                        <h6 class="bg-primary text-white p-2">@ViewBag.SelectedHocKyName</h6>

                        <table class="table table-bordered mb-2">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;">STT</th>
                                    <th style="width:40px;">Mã môn học</th>
                                    <th style="width:110px;">Tên môn học</th>
                                    <th style="width:50px;">STC</th>
                                    <th style="width:80px;">Điểm quá trình</th>
                                    <th style="width:50px;">Điểm thi</th>
                                    <th style="width:60px;">Điểm hệ 10</th>
                                    <th style="width:60px;">Điểm hệ 4</th>
                                    <th style="width:60px;">Điểm chữ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int stt = 1;
                                    foreach (var d in Model)
                                    {
                                        <tr>
                                            <td>@stt</td>
                                            <td>@d.MaMonHoc</td>
                                            <td>@d.TenMonHoc</td>
                                            <td>@d.SoTinChi</td>
                                            <td>@(d.DiemChuyenCan)</td>
                                            <td>@(d.DiemCuoiKy)</td>
                                            <td>@(d.DiemTongKet)</td>
                                            <td>@(d.DiemHe4)</td>
                                            <td>@(d.DiemChu)</td>
                                        </tr>
                                        stt++;
                                    }
                                }
                            </tbody>
                        </table>

                        <div class="mb-4">
                            <p><strong>Điểm trung bình học kỳ (hệ 4):</strong> @(ViewBag.DiemTBHocKy ?? "0.00")</p>
                            <p><strong>Điểm trung bình tích lũy (hệ 4):</strong> @(ViewBag.DiemTBTichLuy ?? "0.00")</p>
                            <p><strong>Số tín chỉ đạt :</strong> @(ViewBag.TongTinChiDat ?? 0)</p>
                            <p><strong>Tổng tín chỉ tích lũy:</strong> @(ViewBag.TongTinChiTichLuy ?? 0)</p>
                        </div>
                    }
                }

            </div>

            <!-- Tab Tích lũy -->
            <div class="tab-pane fade" id="tichluy" role="tabpanel">
                <h6 class="bg-primary text-white p-2">Bảng tích lũy</h6>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead class="table-primary">
                            <tr>
                                <th>STT</th>
                                <th>Năm học - Học kỳ</th>
                                <th>Điểm TB học kỳ</th>
                                <th>Điểm TB tích lũy</th>
                                <th>Số tín chỉ đạt</th>
                                <th>Tổng tín chỉ tích lũy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.TichLuyList != null)
                            {
                                var stt2 = 1;
                                foreach (var item in ViewBag.TichLuyList)
                                {
                                    <tr>
                                        <td>@stt2</td>
                                        <td>@item.TenHocKy</td>
                                        <td>@item.DiemTBHocKy</td>
                                        <td>@item.DiemTBTichLuy</td>
                                        <td>@item.TinChiDat</td>
                                        <td>@item.TongTinChiTichLuy</td>
                                    </tr>
                                    stt2++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>
