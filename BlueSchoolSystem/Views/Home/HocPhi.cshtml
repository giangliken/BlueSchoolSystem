@using BlueSchoolSystem.Models
@using System.Globalization
@model BlueSchoolSystem.Models.ViewModel.HocPhiViewModel

@{
    ViewData["Title"] = "Thông tin Học phí";

    // 1. Lấy dữ liệu cơ bản
    decimal duNoHienTai = Model.DuNoHienTai;
    decimal tongDaDong = Model.LichSuDongTien.Sum(x => x.SoTienDong);

    // 2. Lấy học kỳ hiển thị
    var kyHienThi = Model.DanhSachHocKy.OrderByDescending(k => k.HocKyId).FirstOrDefault();

    // 3. Tính toán
    decimal tongPhatSinhTichLuy = tongDaDong + duNoHienTai;
    DateTime? ngayBatDauKy = kyHienThi?.ChiTietMonHoc.Min(x => x.NgayDK);
    decimal tongDaDongKyNay = 0;
    if (ngayBatDauKy.HasValue)
    {
        tongDaDongKyNay = Model.LichSuDongTien
            .Where(x => x.NgayDong >= ngayBatDauKy.Value)
            .Sum(x => x.SoTienDong);
    }
}

<div class="container mt-4">

    @* --- THANH TABS --- *@
    <ul class="nav nav-tabs nav-fill mb-3 fw-bold" id="hpTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="chitiet-tab" data-bs-toggle="tab" data-bs-target="#tabChiTiet" type="button">
                <i class="fa fa-list-ul me-2"></i> Chi tiết Học phí @(kyHienThi != null ? $"({kyHienThi.TenHocKy})" : "")
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="ls-tab" data-bs-toggle="tab" data-bs-target="#tabLichSu" type="button">
                <i class="fa fa-history me-2"></i> Lịch sử Giao dịch
            </button>
        </li>
    </ul>

    <div class="tab-content mb-4">

        @* ================================================================================= *@
        @* TAB 1: CHI TIẾT HỌC PHÍ (DANH SÁCH MÔN HỌC & TỔNG KẾT)                            *@
        @* ================================================================================= *@
        <div class="tab-pane fade show active" id="tabChiTiet">
            @if (kyHienThi != null)
            {
                <div class="card shadow-sm border-0">
                    @* Header riêng cho Tab 1 *@
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-calendar-check me-2"></i> @kyHienThi.TenHocKy
                        </h5>
                        <span class="badge bg-light text-primary fs-6">
                            Tổng phát sinh kỳ này: @kyHienThi.TongHocPhiKy.ToString("N0") đ
                        </span>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary">
                                    <tr>
                                        <th class="text-center" width="50">STT</th>
                                        <th>Mã môn</th>
                                        <th>Tên môn / Nội dung</th>
                                        <th>Lớp</th>
                                        <th class="text-center">TC</th>
                                        <th class="text-end">Học phí</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 1;
                                    }
                                    @foreach (var item in kyHienThi.ChiTietMonHoc)
                                    {
                                        <tr>
                                            <td class="text-center">@(stt++)</td>
                                            <td class="text-muted">@item.MaMonHoc</td>
                                            <td>@item.TenMonHoc</td>
                                            <td>@item.TenLopHP</td>
                                            <td class="text-center">@item.SoTinChi</td>
                                            <td class="text-end  text-dark">@item.SoTien.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>

                                @* TFOOT TỔNG KẾT (Chỉ nằm ở Tab 1) *@
                                <tfoot class="table-light">
                                    @* 1. Tổng kỳ này *@
                                    <tr>
                                        <td colspan="5" class="fw-bold" >Tổng cộng học kỳ này:</td>
                                        <td class="text-end fw-bold fs-6">@kyHienThi.TongHocPhiKy.ToString("N0") đ</td>
                                    </tr>

                                    @* 2. Đã đóng (Ước tính trong kỳ) *@
                                    <tr>
                                        <td colspan="5" class="fw-bold ">
                                            Đã đóng trong @kyHienThi.TenHocKy :
                                        </td>
                                        <td class="text-end fw-bold  fs-6">
                                            @tongDaDongKyNay.ToString("N0") đ
                                        </td>
                                    </tr>

                                    @* 3. Dư nợ cuối cùng (TOÀN BỘ) *@
                                    <tr >
                                        <td colspan="5" class="fw-bold">
                                           Tồn nợ (Từ các học kỳ trước):
                                            @if (duNoHienTai > 0)
                                            {
                                            <td class="text-end fw-bold  fs-6">+@Math.Abs(duNoHienTai).ToString("N0") đ</td>
                                            }
                                            else
                                            {
                                            <td class="text-end fw-bold  fs-6">-@Math.Abs(duNoHienTai).ToString("N0") đ</td>
                                            }
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center m-3">Chưa có dữ liệu.</div>
            }
        </div>

        @* ================================================================================= *@
        @* TAB 2: LỊCH SỬ ĐÓNG TIỀN (CHỈ HIỆN DANH SÁCH PHIẾU THU)                           *@
        @* ================================================================================= *@
        <div class="tab-pane fade" id="tabLichSu">
            <div class="card shadow-sm border-0">
                @* Header riêng cho Tab 2 *@
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="fa fa-history me-2"></i> Lịch sử Giao dịch</h5>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Ngày giao dịch</th>
                                    <th>Người thu</th>
                                    <th>Nội dung / Ghi chú</th>
                                    <th class="text-end">Số tiền đã nộp</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LichSuDongTien.Any())
                                {
                                    foreach (var item in Model.LichSuDongTien)
                                    {
                                        <tr>
                                            <td>@item.NgayDong.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@item.NguoiThu</td>
                                            <td>@item.GhiChu</td>
                                            <td class="text-end fw-bold">+@item.SoTienDong.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có lịch sử đóng tiền.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>