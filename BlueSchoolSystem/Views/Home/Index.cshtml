@using System.Text.Json
@using BlueSchoolSystem.Models.ViewModel
@{
    ViewData["Title"] = "Trang Chủ Sinh Viên";
    // Cấu hình chuyển đổi tên biến sang chữ thường (camelCase) cho JS
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales-all.global.min.js"></script>
    <style>
        .fc-event-title {
            font-weight: 500;
        }

        .fc .fc-button-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        #eventList {
            max-height: 450px;
            overflow-y: auto;
        }
    </style>
</head>
<body>

    <script>
        const suKiens = @Html.Raw(JsonSerializer.Serialize(ViewBag.SuKiens ?? new List<object>(), jsonOptions));
    </script>

    <div class="container-fluid p-3">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0 text-primary fw-bold">Xin chào,@ViewBag.TenSinhVien</h4>
                <p class="text-muted mb-0">Lịch hoạt động của khoa: <span class="fw-bold text-dark">@ViewBag.TenKhoa</span></p>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning py-1 px-3 mb-0">@ViewBag.Error</div>
            }
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white pt-3 border-0">
                        <h5 class="fw-bold"><i class="fa-solid fa-bullhorn text-warning me-2"></i>Sự kiện sắp tới</h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" id="eventList">
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-3">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- 1. CONFIG CALENDAR ---
            const calendarEl = document.getElementById('calendar');
            const events = (suKiens || []).map(e => ({
                title: e.tenSuKien,
                start: e.ngayBatDau,
                end: e.ngayKetThuc,
                color: '#3788d8'
            }));

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'vi',
                height: 550,
                displayEventTime: false, // <--- Ẩn "00 giờ" theo yêu cầu của bạn
                headerToolbar: {
                    left: 'title',
                    right: 'today prev,next'
                },
                buttonText: { today: 'Hôm nay' },
                events: events,
                eventClick: function(info) {
                    // Hiển thị chi tiết khi click (có thể thay bằng Modal đẹp hơn)
                    alert('Sự kiện: ' + info.event.title);
                }
            });
            calendar.render();

            // --- 2. RENDER LIST SỰ KIỆN BÊN TRÁI ---
            const ul = document.getElementById('eventList');
            const now = new Date();
            now.setHours(0,0,0,0);

            const upcoming = (suKiens || [])
                .filter(e => new Date(e.ngayBatDau) >= now)
                .sort((a, b) => new Date(a.ngayBatDau) - new Date(b.ngayBatDau))
                .slice(0, 5);

            if (upcoming.length === 0) {
                ul.innerHTML = `<li class="list-group-item text-center text-muted py-4">Không có sự kiện mới</li>`;
            } else {
                upcoming.forEach(e => {
                    const d = new Date(e.ngayBatDau);
                    const dayStr = d.getDate();
                    const monthStr = d.getMonth() + 1;

                    ul.innerHTML += `
                        <li class="list-group-item d-flex align-items-start py-3">
                            <div class="me-3 text-center rounded p-2 bg-light" style="min-width: 60px;">
                                <span class="d-block fw-bold fs-5 text-primary">${dayStr}</span>
                                <span class="d-block small text-muted">Thg ${monthStr}</span>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">${e.tenSuKien}</div>
                                <div class="small text-muted mt-1">
                                    <i class="fa-solid fa-location-dot me-1"></i> ${e.diaDiem || 'Chưa cập nhật'}
                                </div>
                            </div>
                        </li>
                    `;
                });
            }
        });
    </script>
</body>
</html>