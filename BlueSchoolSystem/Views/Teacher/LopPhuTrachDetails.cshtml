@model BlueSchoolSystem.Models.ViewModel.ChiTietLopHocViewModel

@{
    ViewData["Title"] = "Chi tiết lớp học";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-md-10">

            @if (Model == null)
            {
                <div class="alert alert-warning mt-4">
                    Không có dữ liệu lớp học.
                </div>
                return;
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Thông tin lớp học</h4>
                </div>

                <div class="card-body">

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span><strong>Mã lớp:</strong> @Model.MaLop</span>
                            <span><strong>Tên lớp:</strong> @Model.TenLop</span>
                        </li>

                        <hr />

                        <table class="table table-bordered table-striped">
                            <thead class="table-primary">
                                <tr class="text-center">
                                    <th>Chức vụ</th>
                                    <th>Mã số</th>
                                    <th>Họ tên</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>

                                @{

                                    var lt = Model.LopTruong as Newtonsoft.Json.Linq.JObject;
                                    var lp = Model.LopPho as Newtonsoft.Json.Linq.JObject;
                                    var bt = Model.BiThu as Newtonsoft.Json.Linq.JObject;
                                }

                                <tr>
                                    <td><strong>Lớp trưởng</strong></td>
                                    <td>@lt?["mssv"]</td>
                                    <td>@lt?["hoTen"]</td>
                                    <td>@lt?["phoneNumber"]</td>
                                    <td>@lt?["email"]</td>
                                </tr>

                                <tr>
                                    <td><strong>Lớp phó</strong></td>
                                    <td>@lp?["mssv"]</td>
                                    <td>@lp?["hoTen"]</td>
                                    <td>@lp?["phoneNumber"]</td>
                                    <td>@lp?["email"]</td>
                                </tr>

                                <tr>
                                    <td><strong>Bí thư</strong></td>
                                    <td>@bt?["mssv"]</td>
                                    <td>@bt?["hoTen"]</td>
                                    <td>@bt?["phoneNumber"]</td>
                                    <td>@bt?["email"]</td>
                                </tr>

                            </tbody>
                        </table>

                        <hr />

                        <h5 class="mt-3">Danh sách sinh viên</h5>

                        <table class="table table-striped table-bordered mt-2">
                            <thead class="table-secondary">
                                <tr class="text-center">
                                    <th>#</th>
                                    <th>MSSV</th>
                                    <th>Họ tên</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.SinhVien == null || !Model.SinhVien.Any())
                                {
                                    <tr class="text-center">
                                        <td colspan="5" class="text-muted">Chưa có sinh viên.</td>
                                    </tr>
                                }
                                else
                                {
                                    int stt = 1;

                                    foreach (Newtonsoft.Json.Linq.JObject sv in Model.SinhVien)
                                    {
                                        <tr>
                                            <td class="text-center">@stt</td>
                                            <td>@sv["mssv"]</td>
                                            <td>@sv["hoTen"]</td>
                                            <td>@sv["phoneNumber"]</td>
                                            <td>@sv["email"]</td>
                                        </tr>
                                        stt++;
                                    }
                                }
                            </tbody>
                        </table>

                    </ul>

                </div>

                <div class="card-footer bg-light text-center">
                    <a asp-action="LopPhuTrach" class="btn btn-secondary">
                        Quay lại
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
