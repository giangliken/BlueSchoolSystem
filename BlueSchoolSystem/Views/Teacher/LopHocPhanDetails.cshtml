@using BlueSchoolSystem.Models.ViewModel
@{
    var token = Context.Session.GetString("access_token");

    var lhp = ViewBag.LopHocPhan as LopHocPhanViewModel;
    var sinhVienList = ViewBag.SinhVienList as List<SinhVienViewModel> ?? new List<SinhVienViewModel>();
    var attendanceList = ViewBag.AttendanceList as List<AttendanceSessionViewModel> ?? new List<AttendanceSessionViewModel>();

    // Group buổi điểm danh theo ngày
    var grouped = attendanceList
        .OrderByDescending(x => x.Ngay)
        .GroupBy(x => x.Ngay.Date)
        .ToList();
    int rowIndex = 1;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success my-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger my-2">@TempData["Error"]</div>
}

<!-- Nút bấm mở modal tạo thông báo -->
<button type="button" class="btn btn-warning fw-semibold ms-2" data-bs-toggle="modal" data-bs-target="#modalTaoThongBao">
    <i class="fa-solid fa-bell me-1"></i> Tạo thông báo cho lớp này
</button>

@if (lhp == null)
{
    <div class="alert alert-danger my-4 shadow-sm">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        Không có dữ liệu lớp học phần!
    </div>
}
else
{
    <div class="card shadow-sm my-3">
        <div class="card-body">
            <h3 class="card-title fw-bold text-primary mb-3">
                <i class="fa-solid fa-chalkboard-user me-2"></i>
                @lhp.TenLopHocPhan <span class="fw-normal text-secondary">(@lhp.MaLopHocPhan)</span>
            </h3>
            <ul class="list-group list-group-flush mb-2">
                <li class="list-group-item ps-0">
                    <i class="fa-solid fa-users me-1 text-success"></i>
                    <span class="fw-semibold">Sĩ số:</span>
                    <span class="ms-2">@lhp.SiSoThucTe</span>
                </li>
                <li class="list-group-item ps-0">
                    <i class="fa-solid fa-circle-info me-1 text-info"></i>
                    <span class="fw-semibold">Trạng thái:</span>
                    <span class="badge bg-@((lhp.TrangThai?.TenTrangThai == "Đang mở") ? "primary" : (lhp.TrangThai?.TenTrangThai == "Đã kết thúc") ? "secondary" : "warning") ms-2">
                        @lhp.TrangThai?.TenTrangThai
                    </span>
                </li>
            </ul>
        </div>
    </div>
}

<div class="row mt-4 g-4">
    <div class="col-md-6">
        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:48px;">#</th>
                        <th>MSSV</th>
                        <th>Họ và tên</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < sinhVienList.Count; i++)
                    {
                        var sv = sinhVienList[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@sv.MSSV</td>
                            <td>@(sv.HoVaTenDem + " " + sv.Ten)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light border-0 d-flex align-items-center justify-content-between">
                <h4 class="mb-0">
                    <i class="fa-solid fa-calendar-check me-2 text-success"></i>
                    Danh sách buổi điểm danh
                </h4>
                @using (Html.BeginForm(
                                "CreateAttendanceSession",
                                "Teacher",
                                new { LopHocPhanId = lhp.Id },
                                FormMethod.Post,
                                true,
                                new { @class = "d-inline" }
                                ))
                {
                    <button type="submit" class="btn btn-primary fw-semibold d-flex align-items-center">
                        <i class="fa-solid fa-plus me-2"></i>Điểm danh mới
                    </button>
                }

            </div>
            <div class="card-body p-0">
                @if (!attendanceList.Any())
                {
                    <div class="text-muted fst-italic p-3">Không có buổi điểm danh nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:48px;">#</th>
                                    <th>Ngày</th>
                                    <th>Lần</th>
                                    <th>Ghi chú</th>
                                    <th style="width:100px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in grouped)
                                {
                                    int lan = 1;
                                    foreach (var att in group.OrderBy(x => x.Ngay))
                                    {
                                        <tr>
                                            <td>@rowIndex</td>
                                            <td>@group.Key.ToString("dd/MM/yyyy")</td>
                                            <td>Lần @lan</td>
                                            <td>@att.GhiChu</td>
                                            <td>
                                                <a href="@Url.Action("AttendanceDetails", "Teacher", new { id = att.Id })"
                                                   class="btn btn-outline-primary btn-sm" title="Xem chi tiết">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        lan++;
                                        rowIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal tạo thông báo -->
<div class="modal fade" id="modalTaoThongBao" tabindex="-1" aria-labelledby="modalTaoThongBaoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formTaoThongBao" autocomplete="off">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTaoThongBaoLabel">Gửi thông báo cho lớp học phần</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="thongBaoTitle" class="form-label">Tiêu đề</label>
                        <input type="text" class="form-control" id="thongBaoTitle" name="Title" required maxlength="200" placeholder="Nhập tiêu đề thông báo">
                    </div>
                    <div class="mb-3">
                        <label for="thongBaoContent" class="form-label">Nội dung</label>
                        <textarea class="form-control" id="thongBaoContent" name="Content" rows="4" required maxlength="2000" placeholder="Nhập nội dung thông báo"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" id="btnGuiThongBao" class="btn btn-primary fw-semibold">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi thông báo
                    </button>

                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
        window.__accessToken = @Html.Raw(Json.Serialize(token ?? ""));
    </script>

    <script>
        document.getElementById('formTaoThongBao').addEventListener('submit', function(e) {
            e.preventDefault();

            const title = document.getElementById('thongBaoTitle').value;
            const content = document.getElementById('thongBaoContent').value;
            var token = window.__accessToken;

            // Gán đúng mã lớp học phần 
            const maLopHocPhan = '@lhp.MaLopHocPhan';
            const baseurl = window.location.origin; 

            fetch(`${baseurl}/api/lophocphan/${maLopHocPhan}/guithongbao`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify({
                    Title: title,
                    Content: content
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.result) {
                    $('#modalTaoThongBao').modal('hide');
                    alert(data.message ?? 'Gửi thông báo thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + (data.message ?? 'Không xác định!'));
                }
            })
            .catch(err => {
                alert('Gửi thông báo thất bại!');
                console.error(err);
            });
        });

                document.getElementById('formTaoThongBao').addEventListener('submit', function(e) {
            e.preventDefault();

            const title = document.getElementById('thongBaoTitle').value;
            const content = document.getElementById('thongBaoContent').value;
            var token = window.__accessToken;
            const maLopHocPhan = '@lhp.MaLopHocPhan';
            const baseurl = window.location.origin;

            // Disable form và show loading
            const btn = document.getElementById('btnGuiThongBao');
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>Đang gửi...`;

            fetch(`${baseurl}/api/lophocphan/${maLopHocPhan}/guithongbao`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify({
                    Title: title,
                    Content: content
                })
            })
            .then(res => res.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane me-1"></i> Gửi thông báo`;
                if (data.result) {
                    $('#modalTaoThongBao').modal('hide');
                    alert(data.message ?? 'Gửi thông báo thành công!');
                    location.reload();
                } else {
                    alert('Lỗi: ' + (data.message ?? 'Không xác định!'));
                }
            })
            .catch(err => {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane me-1"></i> Gửi thông báo`;
                alert('Gửi thông báo thất bại!');
                console.error(err);
            });
        });

    </script>

}

