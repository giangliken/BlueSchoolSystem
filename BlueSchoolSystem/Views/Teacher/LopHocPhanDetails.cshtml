@using BlueSchoolSystem.Models.ViewModel
@using System.Text.Json
@{
    var token = Context.Session.GetString("access_token");

    var lhp = ViewBag.LopHocPhan as LopHocPhanViewModel;
    var sinhVienList = ViewBag.SinhVienList as List<SinhVienViewModel> ?? new List<SinhVienViewModel>();
    var attendanceList = ViewBag.AttendanceList as List<AttendanceSessionViewModel> ?? new List<AttendanceSessionViewModel>();

    // Group buổi điểm danh theo ngày
    var grouped = attendanceList
        .OrderByDescending(x => x.Ngay)
        .GroupBy(x => x.Ngay.Date)
        .ToList();
    int rowIndex = 1;
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success my-2">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger my-2">@TempData["Error"]</div>
}

<!-- Nút bấm mở modal tạo thông báo -->
<div class="d-flex justify-content-start gap-2 my-3 flex-wrap">
    <button type="button" class="btn btn-warning fw-semibold" data-bs-toggle="modal" data-bs-target="#modalTaoThongBao">
        <i class="fa-solid fa-bell me-1"></i> Thông báo
    </button>
    <button class="btn btn-dark fw-semibold" data-bs-toggle="modal" data-bs-target="#modalGroupChat">
        <i class="fa-solid fa-comments me-2"></i> Chat nhóm
    </button>
</div>


<div class="modal fade" id="modalGroupChat" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nhóm chat - @lhp?.TenMonHoc (@lhp?.MaLopHocPhan)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-0">
                <div id="chat-messages" style="height:400px;overflow-y:auto;padding:1rem;background:#f9f9f9"></div>
            </div>
            <div class="modal-footer">
                <input type="text" id="chatInput" class="form-control" autocomplete="off" placeholder="Nhập tin nhắn..." style="flex:1;max-width:80%">
                <button type="button" id="btnSendChat" class="btn btn-primary ms-2">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@if (lhp == null)
{
    <div class="alert alert-danger my-4 shadow-sm">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        Không có dữ liệu lớp học phần!
    </div>
}
else
{
    <div class="card shadow-sm my-3">
        <div class="card-body">
            <h3 class="card-title fw-bold text-primary mb-3">
                <i class="fa-solid fa-chalkboard-user me-2"></i>
                @lhp.TenMonHoc <span class="fw-normal text-secondary">(@lhp.MaLopHocPhan)</span>
            </h3>
            <ul class="list-group list-group-flush mb-2">
                <li class="list-group-item ps-0">
                    <i class="fa-solid fa-users me-1 text-success"></i>
                    <span class="fw-semibold">Sĩ số:</span>
                    <span class="ms-2">@lhp.SiSoThucTe</span>
                </li>
                <li class="list-group-item ps-0">
                    <i class="fa-solid fa-circle-info me-1 text-info"></i>
                    <span class="fw-semibold">Trạng thái:</span>
                    <span class="badge bg-@((lhp.TrangThai?.TenTrangThai == "Đang mở") ? "primary" : (lhp.TrangThai?.TenTrangThai == "Đã kết thúc") ? "secondary" : "warning") ms-2">
                        @lhp.TrangThai?.TenTrangThai
                    </span>
                </li>
            </ul>
        </div>
    </div>
}

<div class="row mt-4 g-4">
    <div class="col-md-6">
        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:48px;">#</th>
                        <th>MSSV</th>
                        <th>Họ và tên</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < sinhVienList.Count; i++)
                    {
                        var sv = sinhVienList[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@sv.MSSV</td>
                            <td>@(sv.HoVaTenDem + " " + sv.Ten)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light border-0 d-flex align-items-center justify-content-between">
                <h4 class="mb-0">
                    <i class="fa-solid fa-calendar-check me-2 text-success"></i>
                    Danh sách buổi điểm danh
                </h4>
                @if (lhp != null)
                {
                    <form asp-action="CreateAttendanceSession"
                          asp-controller="Teacher"
                          method="post"
                          class="d-inline"
                          asp-antiforgery="true">
                        <input type="hidden" name="LopHocPhanId" value="@lhp.Id" />
                        <button type="submit" class="btn btn-primary fw-semibold d-flex align-items-center">
                            <i class="fa-solid fa-plus me-2"></i>Điểm danh mới
                        </button>
                    </form>
                }

            </div>
            <div class="card-body p-0">
                @if (!attendanceList.Any())
                {
                    <div class="text-muted fst-italic p-3">Không có buổi điểm danh nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:48px;">#</th>
                                    <th>Ngày</th>
                                    <th>Lần</th>
                                    <th>Ghi chú</th>
                                    <th style="width:100px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in grouped)
                                {
                                    int lan = 1;
                                    foreach (var att in group.OrderBy(x => x.Ngay))
                                    {
                                        <tr>
                                            <td>@rowIndex</td>
                                            <td>@group.Key.ToString("dd/MM/yyyy")</td>
                                            <td>Lần @lan</td>
                                            <td>@att.GhiChu</td>
                                            <td>
                                                <a href="@Url.Action("AttendanceDetails", "Teacher", new { id = att.Id })"
                                                   class="btn btn-outline-primary btn-sm" title="Xem chi tiết">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <form asp-action="DeleteAttendanceSession" asp-controller="Teacher" method="post"
                                                      onsubmit="return confirm('Bạn chắc chắn muốn xoá buổi điểm danh này?')"
                                                      class="d-inline">
                                                    <input type="hidden" name="id" value="@att.Id" />
                                                    <input type="hidden" name="maLopHocPhan" value="@lhp?.MaLopHocPhan" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Xoá">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>

                                        </tr>
                                        lan++;
                                        rowIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal tạo thông báo -->
<div class="modal fade" id="modalTaoThongBao" tabindex="-1" aria-labelledby="modalTaoThongBaoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formTaoThongBao"
                  asp-action="GuiThongBaoLopHocPhan"
                  asp-controller="Teacher"
                  asp-route-maLopHocPhan="@(lhp?.MaLopHocPhan)"
                  method="post"
                  asp-antiforgery="true"
                  autocomplete="off">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTaoThongBaoLabel">Gửi thông báo cho lớp học phần</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="thongBaoTitle" class="form-label">Tiêu đề</label>
                        <input type="text" class="form-control" id="thongBaoTitle" name="Title"
                               required maxlength="200" placeholder="Nhập tiêu đề thông báo">
                    </div>
                    <div class="mb-3">
                        <label for="thongBaoContent" class="form-label">Nội dung</label>
                        <textarea class="form-control" id="thongBaoContent" name="Content"
                                  rows="4" required maxlength="2000" placeholder="Nhập nội dung thông báo"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" id="btnGuiThongBao" class="btn btn-primary fw-semibold">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi thông báo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
         window.__accessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(token ?? ""));
    </script>

    <script>
        function b64uToBytes(s){
            s = s.replace(/-/g, '+').replace(/_/g, '/');
            while (s.length % 4) s += '=';
            const bin = atob(s);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            return bytes;
        }

        function parseJwt(t){
            if(!t) return null;
            if(t.startsWith('Bearer ')) t = t.slice(7);
            const p = t.split('.');
            if (p.length < 2) return null;
            try{
                const json = new TextDecoder('utf-8').decode(b64uToBytes(p[1]));
                return JSON.parse(json);
            }catch(e){
                console.error('parseJwt error', e);
                return null;
            }
        }
        const payload  = parseJwt(window.__accessToken) || {};
        const userId   = payload.userId || "";
        const username = payload.username || "";
        const fullname = payload.fullname || "";
        const email    = payload.email || "";
        const roleRaw  = payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || "";
    </script>

    <script>

        // 1) Firebase config & init
        const firebaseConfig = {
            apiKey: "AIzaSyD2Uh_6wINLjM99TZ64cIdR330cWPrJ3ws",
            authDomain: "bluenet-e6525.firebaseapp.com",
            databaseURL: "https://bluenet-e6525-default-rtdb.firebaseio.com",
            projectId: "bluenet-e6525",
            storageBucket: "bluenet-e6525.firebasestorage.app",
            messagingSenderId: "682840647075",
            appId: "1:682840647075:web:ed799955c38a40f2526616",
            measurementId: "G-RXWF28P678"
        };
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);


        function ready(fn){ if (document.readyState !== 'loading') fn(); else document.addEventListener('DOMContentLoaded', fn); }

        function formatTime(ts){ return new Date(ts||Date.now()).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}); }

        const roleMap = { "Student":"Sinh viên", "Teacher":"Giảng viên", "Admin":"Quản trị" };
        const userRole = roleMap[roleRaw] || roleRaw || "Sinh viên";

              ready(function () {
          // 1) Khóa phòng chat: ViewBag trước, querystring sau
          const maLopHocPhan = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MaLopHocPhan ?? ""));
          const qsKey = new URLSearchParams(location.search).get('maLopHocPhan') || "";
          const roomKey = maLopHocPhan || qsKey;

          // 2) Thông tin người dùng lấy HOÀN TOÀN từ token đã decode
          const displayName = (fullname || username || email || "Người dùng").trim();
          const uid = (userId || "").trim();

          // 3) DOM
          const btn   = document.getElementById('btnSendChat');
          const input = document.getElementById('chatInput');
          const box   = document.getElementById('chat-messages');
          if (!btn || !box) { console.warn('[chat] thiếu nút/khung chat'); return; }

          // 4) Hàm gửi
          function send(content){
            if (!roomKey){ alert('Thiếu mã lớp (maLopHocPhan).'); return; }
            if (!uid){ alert('Token không có userId.'); return; }
            const msg = (content||"").trim();
            if (!msg){ input?.focus(); return; }

            const ref = firebase.database().ref('chats/'+ roomKey +'/messages');
            ref.push({
              senderId:   uid,
              senderName: displayName,   // <-- sẽ là fullName nếu có
              role:       userRole,      // "Sinh viên"/"Giảng viên"/"Quản trị"
              content:    msg,
              createdAt:  Date.now()
            }).then(()=>{ if (input) input.value=''; })
              .catch(err=>{ alert('Lỗi khi gửi: ' + (err?.message || 'Unknown')); console.error(err); });
          }

          // 5) Gửi bằng nút & phím Enter
          btn.addEventListener('click', ()=> send(input?.value || ""));
          input?.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); send(input.value); }
          });

          // 6) Render tin nhắn
          function renderMsg(m){
            const mine = m.senderId === uid;
            const time = formatTime(m.createdAt);
            if (mine){
              box.innerHTML += `
                <div class="text-end mb-2">
                  <div class="d-inline-block px-3 py-2 rounded-3 shadow-sm" style="background:#2f80ff;color:#fff;max-width:70%;">
                    ${ (m.content||'').replace(/\n/g,'<br>') }
                    <div class="small text-end" style="opacity:.85;margin-top:2px;">${time}</div>
                  </div>
                </div>`;
            } else {
              box.innerHTML += `
                <div class="text-start mb-2">
                  <div class="d-inline-block px-3 py-2 rounded-3 shadow-sm" style="background:#2f80ff;color:#fff;max-width:70%;">
                    <div style="font-weight:700;color:#fff;">
                      ${m.senderName||'Người dùng'}
                      ${ m.role ? `<span class="ms-2" style="font-weight:500;background:#1f2937;color:#93c5fd;border-radius:999px;padding:2px 8px;font-size:.75rem;">${m.role}</span>` : '' }
                    </div>
                    <div>${ (m.content||'').replace(/\n/g,'<br>') }</div>
                    <div class="small" style="opacity:.85;margin-top:2px;">${time}</div>
                  </div>
                </div>`;
            }
            box.scrollTop = box.scrollHeight;
          }

          // 7) Lắng nghe tin mới
          if (roomKey){
            const ref = firebase.database().ref('chats/'+ roomKey +'/messages');
            ref.limitToLast(100).on('child_added', s => { const m = s.val(); if (m) renderMsg(m); });
          } else {
            console.warn('Không có maLopHocPhan để join phòng chat.');
          }
        });
    </script>
}

