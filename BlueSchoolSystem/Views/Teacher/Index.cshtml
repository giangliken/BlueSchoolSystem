@using System.Text.Json
@using BlueSchoolSystem.Models.ViewModel
@{
    ViewData["Title"] = "Cổng Giảng Viên";
    // Đổi thành _LayoutTeacher.cshtml nếu bạn đã tạo layout riêng
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Cấu hình để chuyển đổi tên biến C# (PascalCase) sang JS (camelCase)
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/locales-all.global.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Tùy chỉnh thanh cuộn danh sách */
        #eventList {
            max-height: 500px;
            overflow-y: auto;
        }
        /* Custom nút bấm lịch */
        .fc .fc-button-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        /* Style cho ngày tháng bên cột trái */
        .date-box {
            min-width: 65px;
            background-color: #eef2f7;
            border-radius: 8px;
            padding: 5px;
            text-align: center;
        }
    </style>
</head>
<body>

    <script>
        const suKiens = @Html.Raw(JsonSerializer.Serialize(ViewBag.SuKiens ?? new List<object>(), jsonOptions));
    </script>

    <div class="container-fluid py-3">

        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border">
            <div>
                <h4 class="mb-1 text-primary fw-bold">
                    <i class="fa-solid fa-chalkboard-user me-2"></i>
                    Xin chào, @ViewBag.TenGiangVien
                </h4>
                <div class="text-muted">
                    Thông tin sự kiện dành cho Khoa: <span class="badge bg-info text-dark">@ViewBag.TenKhoa</span>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-0 py-2 px-3">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.Error
                </div>
            }
        </div>

        <div class="row g-4">

            <div class="col-lg-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-white pt-3 border-0">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-bullhorn text-warning me-2"></i>Sự kiện sắp tới
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" id="eventList">
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body p-3">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- A. CẤU HÌNH FULLCALENDAR ---
            const calendarEl = document.getElementById('calendar');

            // Map dữ liệu từ C# sang format của FullCalendar
            const events = (suKiens || []).map(e => ({
                title: e.tenSuKien,
                start: e.ngayBatDau,
                end: e.ngayKetThuc,
                color: '#3788d8', // Màu xanh mặc định
                extendedProps: {
                    diaDiem: e.diaDiem,
                    moTa: e.moTa
                }
            }));

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'vi',
                height: 600,
                displayEventTime: false, // QUAN TRỌNG: Ẩn chữ "00 giờ" hoặc "12a"
                headerToolbar: {
                    left: 'title',
                    right: 'today prev,next'
                },
                buttonText: { today: 'Hôm nay' },
                events: events,

                // Sự kiện khi click vào một ngày trên lịch
                eventClick: function(info) {
                    const props = info.event.extendedProps;
                    // Bạn có thể thay alert này bằng Modal Bootstrap đẹp hơn
                    alert(`Sự kiện: ${info.event.title}\nĐịa điểm: ${props.diaDiem || 'Không có'}\nMô tả: ${props.moTa || 'Không có'}`);
                }
            });

            calendar.render();

            // --- B. RENDER DANH SÁCH BÊN TRÁI ---
            const ul = document.getElementById('eventList');
            const now = new Date();
            now.setHours(0,0,0,0); // Reset giờ để so sánh ngày chính xác

            // Lọc sự kiện tương lai & sắp xếp gần nhất trước
            const upcoming = (suKiens || [])
                .filter(e => new Date(e.ngayBatDau) >= now)
                .sort((a, b) => new Date(a.ngayBatDau) - new Date(b.ngayBatDau));
                // .slice(0, 10); // Nếu muốn giới hạn số lượng thì bỏ comment dòng này

            if (upcoming.length === 0) {
                ul.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        <i class="fa-regular fa-calendar-xmark fa-2x mb-2"></i>
                        <p>Không có sự kiện sắp tới</p>
                    </div>`;
            } else {
                upcoming.forEach(e => {
                    const d = new Date(e.ngayBatDau);
                    const day = d.getDate().toString().padStart(2, '0');
                    const month = (d.getMonth() + 1).toString().padStart(2, '0');
                    const year = d.getFullYear();

                    ul.innerHTML += `
                        <li class="list-group-item d-flex align-items-start py-3 border-bottom">
                            <div class="me-3 date-box">
                                <div class="fw-bold fs-4 text-primary" style="line-height: 1;">${day}</div>
                                <div class="small fw-bold text-secondary">Thg ${month}</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold text-dark fs-6">${e.tenSuKien}</div>
                                <div class="small text-muted mt-1">
                                    <i class="fa-solid fa-location-dot me-1 text-danger"></i> ${e.diaDiem || 'Chưa cập nhật'}
                                </div>
                                ${e.moTa ? `<div class="small text-muted mt-1 fst-italic text-truncate" style="max-width: 250px;">${e.moTa}</div>` : ''}
                            </div>
                        </li>
                    `;
                });
            }
        });
    </script>

</body>
</html>