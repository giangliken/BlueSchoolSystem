@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #ffffff;
        min-height: 100vh;
        overflow-x: hidden;
    }

    .background-pattern {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0.05;
        background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='1'%3E%3Ccircle cx='7' cy='7' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
        z-index: -1;
    }

    .dashboard-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 40px 20px;
        position: relative;
        z-index: 1;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid rgba(0, 0, 0, 0.05);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08), 0 2px 16px rgba(0, 0, 0, 0.04);
        padding: 60px 50px;
        max-width: 800px;
        width: 100%;
        text-align: center;
        animation: slideInUp 0.8s ease-out;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12), 0 10px 30px rgba(0, 0, 0, 0.08);
        }

    .icon-container {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        animation: bounceIn 1s ease-out 0.3s both;
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
    }

        .icon-container svg {
            width: 40px;
            height: 40px;
            color: white;
        }

    .dashboard-title {
        font-size: 2.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 20px;
        animation: fadeInDown 0.8s ease-out 0.5s both;
        line-height: 1.2;
    }

    .dashboard-subtitle {
        font-size: 1.2rem;
        color: #64748b;
        margin-bottom: 40px;
        line-height: 1.8;
        font-weight: 400;
        animation: fadeIn 1s ease-out 0.7s both;
    }

    .status-container {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        margin-bottom: 40px;
        animation: fadeInUp 0.8s ease-out 0.9s both;
    }

    .status-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 0.95rem;
        font-weight: 500;
        padding: 12px 24px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 4px 20px rgba(102, 126, 234, 0.3);
        transition: all 0.3s ease;
    }

        .status-badge:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(102, 126, 234, 0.4);
        }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #fff;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 40px;
        animation: fadeInUp 1s ease-out 1.1s both;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.7);
        border-radius: 16px;
        padding: 25px 20px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

        .feature-card:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .feature-icon {
        width: 40px;
        height: 40px;
        margin: 0 auto 15px;
        background: linear-gradient(135deg, #3498db, #2980b9);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
    }

    .feature-title {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 8px;
    }

    .feature-desc {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.5;
    }

    .progress-container {
        margin-top: 30px;
        animation: fadeInUp 1s ease-out 1.3s both;
    }

    .progress-label {
        font-size: 0.9rem;
        color: #64748b;
        margin-bottom: 10px;
        font-weight: 500;
    }

    .progress-bar {
        width: 100%;
        height: 8px;
        background: rgba(100, 116, 139, 0.1);
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 10px;
        width: 0%;
        animation: progressFill 2s ease-out 1.5s forwards;
    }

    /* Animations */
    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(60px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes bounceIn {
        0% {
            opacity: 0;
            transform: scale(0.3);
        }

        50% {
            opacity: 1;
            transform: scale(1.05);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    @@keyframes progressFill {
        to {
            width: 75%;
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .glass-card {
            padding: 40px 30px;
            border-radius: 20px;
        }

        .dashboard-title {
            font-size: 2.2rem;
        }

        .dashboard-subtitle {
            font-size: 1.1rem;
        }

        .feature-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .dashboard-container {
            padding: 20px 15px;
        }

        .glass-card {
            padding: 30px 20px;
        }

        .dashboard-title {
            font-size: 1.8rem;
        }
    }
</style>

<div class="background-pattern"></div>

<div class="dashboard-container">
    <div class="glass-card">
        <div class="icon-container">
            <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
        </div>
        <h1 class="dashboard-title">BLUESCHOOL SYSTEM <br />Hệ thống đang được phát triển</h1>

        <p class="dashboard-subtitle">
            Trang web hiện đang trong giai đoạn phát triển và sẽ sớm được hoàn thiện với đầy đủ tính năng dành cho quản trị viên, giảng viên và học viên.
        </p>

        <div class="status-container">
            <div class="status-badge">
                <span>Phiên bản dành cho ứng dụng <br /> https://github.com/giangliken/BlueNet </span>

            </div>
        </div>

        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">👨‍💼</div>
                <div class="feature-title">Quản trị viên</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">👩‍🏫</div>
                <div class="feature-title">Giảng viên / Cán bộ</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🎓</div>
                <div class="feature-title">Học viên</div>
            </div>
        </div>

        <div class="progress-container">
            <div class="progress-label">Tiến độ phát triển</div>
            <div class="progress-bar">
                <div class="progress-fill"></div>
            </div>
        </div>
    </div>
</div>