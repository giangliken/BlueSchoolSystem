@model List<BlueSchoolSystem.Models.ViewModel.LopPhuTrachViewModel>

@{
    ViewData["Title"] = "Lớp Phụ Trách";
}

<div class="container-fluid px-4">
    <h6 class="mb-3">Giảng viên/Lớp phụ trách - cố vấn học tập</h6>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row mt-4">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        @item.MaLop
                                    </div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">@item.TenLop</div>
                                    <div class="text-muted small mt-2">@item.VaiTro</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-chalkboard-teacher fa-2x text-gray-300"></i>
                                </div>
                            </div>
                            <hr />
                            <a asp-action="LopPhuTrachDetails"
                               asp-route-maLop="@item.MaLop"
                               class="btn btn-sm btn-primary w-100">
                                Xem Danh Sách SV
                            </a>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Hiện tại thầy/cô chưa được phân công phụ trách lớp nào.</p>
            </div>
        }
    </div>
</div>