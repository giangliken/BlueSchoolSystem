@model BlueSchoolSystem.Models.ViewModel.AttendanceSessionDetailViewModel

@{
    var isExpired = Model.ExpireAt <= DateTime.Now;
    var trangThaiDict = ViewBag.TrangThaiDict as Dictionary<int, string>;
}
<form id="formBackToClass" asp-action="BackToClassAndUpdateStatus" asp-controller="Teacher" method="post" class="d-inline">
    @Html.AntiForgeryToken()
    <input type="hidden" name="buoiDiemDanhId" value="@Model.Id" />
    <input type="hidden" name="maLopHocPhan" value="@Model.MaLopHocPhan" />
    <button type="submit" class="btn btn-secondary mb-3 d-inline-flex align-items-center">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Quay lại lớp học phần
    </button>
</form>
<h4>
    Buổi điểm danh ngày @Model.Ngay.ToString("dd/MM/yyyy")
    <span id="timer" class="badge bg-danger fs-5"></span>
</h4>
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center p-3">
            <img id="qr-img" src="data:image/png;base64,@Model.QrCodeBase64" style="width:200px;@(isExpired ? "opacity:0.3;" : "")" />
            <div class="mt-2 fw-semibold text-primary">
                Mã điểm danh: <span id="ma-code">@(!isExpired ? Model.Code : "")</span>
            </div>
            <form asp-action="RegenerateAttendanceCode" asp-controller="Teacher" asp-route-id="@Model.Id" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning btn-sm" @(isExpired ? "" : "disabled")>
                    <i class="fa-solid fa-rotate-right"></i> Tạo lại mã điểm danh
                </button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <h5>Danh sách sinh viên đã điểm danh</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>MSSV</th>
                        <th>Họ tên</th>
                        <th>Thời gian điểm danh</th>
                        <th>Trạng thái</th>

                        @* <th>Sửa</th> *@
                    </tr>
                </thead>
                <tbody id="attendance-table-body">
                    @* Lần đầu load trang vẫn render dữ liệu Model.SinhViens *@
                    @if (Model.SinhViens != null && Model.SinhViens.Any())
                    {
                        int stt = 1;
                        @foreach (var sv in Model.SinhViens)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@sv.MSSV</td>
                                <td>@sv.HoVaTenDem @sv.Ten</td>
                                <td>@sv.ThoiGian?.ToString("HH:mm:ss dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        string trangThai = (trangThaiDict != null && trangThaiDict.ContainsKey(sv.TrangThai))
                                        ? trangThaiDict[sv.TrangThai]
                                        : "Không rõ";
                                        string badge = "bg-secondary";
                                        if (trangThai == "Có mặt") badge = "bg-success";
                                        else if (trangThai == "Vắng mặt" || trangThai == "Không phép") badge = "bg-danger";
                                        else if (trangThai == "Đi trễ" || trangThai == "Về sớm") badge = "bg-warning text-dark";
                                        else if (trangThai == "Có phép") badge = "bg-info";
                                    }
                                    <span class="badge @badge">@trangThai</span>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="6">Chưa có sinh viên điểm danh.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Firebase SDK v8 -->
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

    <script>
        // ===== 0) Helpers =====
        // Map text -> badge (UI)
        function badgeByText(label) {
            let badge = "bg-secondary";
            if (label === "Có mặt") badge = "bg-success";
            else if (label === "Vắng mặt" || label === "Không phép" || label === "Vắng") badge = "bg-danger";
            else if (label === "Đi trễ" || label === "Về sớm") badge = "bg-warning text-dark";
            else if (label === "Có phép" || label === "Vắng có phép") badge = "bg-info";
            return `<span class="badge ${badge}">${label}</span>`;
        }

        // Convert mọi kiểu time về string hiển thị
        function fmtTime(v) {
            if (!v) return "";
            // nếu server đã format HH:mm thì giữ nguyên
            if (/^\d{2}:\d{2}$/.test(v)) return v;
            const d = new Date(v);
            if (isNaN(d.getTime())) return v;
            return d.toLocaleString('vi-VN');
        }

        // ===== 1) Data từ server (để map id -> text khi cần) =====
        var trangThaiDict = @Html.Raw(Json.Serialize(ViewBag.TrangThaiDict ?? new Dictionary<int, string>()));

        // ===== 2) Firebase init =====
        var firebaseConfig = {
          apiKey: "AIzaSyD2Uh_6wINLjM99TZ64cIdR330cWPrJ3ws",
          authDomain: "bluenet-e6525.firebaseapp.com",
          databaseURL: "https://bluenet-e6525-default-rtdb.firebaseio.com",
          projectId: "bluenet-e6525",
          storageBucket: "bluenet-e6525.firebasestorage.app",
          messagingSenderId: "682840647075",
          appId: "1:682840647075:web:ed799955c38a40f2526616",
          measurementId: "G-RXWF28P678"
        };
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);

        // ===== 3) Lắng nghe theo schema CHUẨN =====
        var diemDanhId = "@Model.Id";
        var db = firebase.database();

        // Canonical path: attendancesessions/{id}/students/{MSSV}
        var canonicalRef = db.ref("attendancesessions/" + diemDanhId + "/students");

        // Legacy fallback: attendance_sessions/{id}/{SvId}
        //var legacyRef = db.ref("attendance_sessions/" + diemDanhId);

        var usingLegacy = false;

        function attachCanonicalListener() {
            canonicalRef.on("value", function (snapshot) {
                const data = snapshot.val();
                if (data && Object.keys(data).length > 0) {
                    usingLegacy = false;
                    renderStudentsDict(data); // data: { MSSV: {studentId, studentName, status/statusId, timecheckedin...} }
                } else {
                    // Nếu canonical trống, thử legacy (để không gãy khi rollout)
                    attachLegacyOnce();
                }
            });
        }

        function attachLegacyOnce() {
            if (usingLegacy) return;
            legacyRef.once("value").then(function (snap) {
                const val = snap.val();
                if (val && Object.keys(val).length > 0) {
                    usingLegacy = true;
                    // Chuyển legacy -> shape students để UI xài chung
                    // legacy item có: { id, mssv, hoVaTenDem, ten, trangThai (id), thoiGian ... }
                    legacyRef.on("value", function (s) {
                        const raw = s.val() || {};
                        const students = {};
                        Object.keys(raw).forEach(k => {
                            const it = raw[k] || {};
                            const name = `${(it.hoVaTenDem || "").trim()} ${(it.ten || "").trim()}`.trim();
                            students[it.mssv || k] = {
                                studentId: it.mssv || k,
                                studentName: name,
                                statusId: it.trangThai,
                                timecheckedin: fmtTime(it.thoiGian),
                                // bluetoothID/lat/lng có thể không có ở legacy
                            };
                        });
                        renderStudentsDict(students);
                    });
                } else {
                    // cả 2 đều trống -> show empty
                    renderStudentsDict({});
                }
            });
        }

        attachCanonicalListener();

        // ===== 4) Render bảng =====
        function renderStudentsDict(dict) {
            const tbody = document.getElementById("attendance-table-body");
            let rows = [];

            // Transform dict -> array + sort: Có mặt/Đi trễ trước, xong alpha theo tên
            Object.keys(dict || {}).forEach(mssv => {
                const sv = dict[mssv] || {};
                const name = sv.studentName || `${(sv.hoVaTenDem || "").trim()} ${(sv.ten || "").trim()}`.trim();
                const statusText = sv.status || (sv.statusId != null ? (trangThaiDict[sv.statusId] || "Không rõ") : "Không rõ");
                const timeStr = fmtTime(sv.timecheckedin || sv.thoiGian);

                rows.push({
                    mssv,
                    name,
                    statusText,
                    timeStr
                });
            });

            // Ưu tiên "Có mặt" & "Đi trễ" lên trước, rồi sort theo tên cuối
            const presentSet = new Set(["Có mặt", "Đi trễ"]);
            rows.sort((a, b) => {
                const ap = presentSet.has(a.statusText) ? 0 : 1;
                const bp = presentSet.has(b.statusText) ? 0 : 1;
                if (ap !== bp) return ap - bp;
                const al = (a.name || "").toLowerCase().split(" ").pop();
                const bl = (b.name || "").toLowerCase().split(" ").pop();
                return (al || "").localeCompare(bl || "");
            });

            if (rows.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6">Chưa có sinh viên điểm danh.</td></tr>`;
                return;
            }

            let stt = 1, html = "";
            rows.forEach(sv => {
                html += `
                    <tr>
                        <td>${stt++}</td>
                        <td>${sv.mssv}</td>
                        <td>${sv.name}</td>
                        <td>${sv.timeStr || ""}</td>
                        <td>${badgeByText(sv.statusText)}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        // ===== 5) Countdown giữ nguyên =====
        var expireAt = "@Model.ExpireAt.ToString("yyyy-MM-ddTHH:mm:ss")";
        var expireDate = new Date(expireAt);
        var timerSpan = document.getElementById("timer");
        function updateTimer() {
            var now = new Date();
            var diff = Math.max(0, Math.floor((expireDate - now) / 1000));
            var mm = String(Math.floor(diff / 60)).padStart(2, '0');
            var ss = String(diff % 60).padStart(2, '0');
            timerSpan.textContent = mm + ":" + ss;
            if (diff <= 0) {
                timerSpan.classList.remove("bg-danger");
                timerSpan.classList.add("bg-secondary");
                document.getElementById("qr-img").style.opacity = 0.3;
                document.getElementById("ma-code").textContent = "";
            } else {
                setTimeout(updateTimer, 500);
            }
        }
        updateTimer();
    </script>
}

