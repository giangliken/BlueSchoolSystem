@model LopHocPhanFilterViewModel

@{
    ViewBag.Title = "Lớp học phần phụ trách";
}



<div class="mb-3 d-flex align-items-center justify-content-between">
    <form method="get" asp-action="LopHocPhan" class="mb-0">
        <select name="selectedHocKyId"
                class="form-select fw-semibold text-primary border-primary"
                asp-items="ViewBag.HocKyList"
                onchange="this.form.submit()">
        </select>
    </form>
</div>





<table class="table table-bordered table-hover align-middle mb-0">
    <thead class="table-dark text-center">
        <tr>
            <th scope="col" style="width:50px;">#</th>
            <th scope="col">Mã lớp</th>
            <th scope="col">Tên lớp học phần</th>
            <th scope="col">Sĩ số</th>
            <th scope="col">Thời gian giảng dạy</th>
            <th scope="col">Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.LopHocPhans.Count; i++)
        {
            var lhp = Model.LopHocPhans[i];
            var trangThai = lhp.TrangThai?.TenTrangThai?.Trim() ?? "";
            string rowClass = trangThai switch
            {
                "Đang diễn ra" => "row-open",
                "Đã kết thúc" => "row-closed",
                _ => "row-default"
            };

            <tr class="@rowClass"
                style="cursor:pointer"
                onclick="window.location='@Url.Action("LopHocPhanDetails", "Teacher", new { maLopHocPhan = lhp.MaLopHocPhan })'">
                <td class="text-center fw-semibold">@((i + 1).ToString())</td>
                <td>@lhp.MaLopHocPhan</td>
                <td>@lhp.MaMonHoc - @lhp.TenMonHoc</td>
                <td class="text-center">@lhp.SiSoThucTe</td>
                <td class="text-center">
                    @lhp.NgayBatDauLop.ToString("dd/MM/yyyy") -> @lhp.NgayKetThucLop.ToString("dd/MM/yyyy")
                </td>
                <td class="text-center">
                    <span class="badge bg-@((trangThai == "Đang mở") ? "success" : (trangThai == "Đã kết thúc" ? "secondary" : "info"))">
                        @lhp.TrangThai?.TenTrangThai
                    </span>
                </td>
            </tr>
        }

    </tbody>

</table>
